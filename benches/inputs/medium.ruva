// Medium benchmark input (~200 LOC)
// Classes, traits, generics, control flow, error handling

trait Drawable {
    fn draw(&self)
    fn area(&self) -> f64
}

trait Measurable {
    fn perimeter(&self) -> f64
    fn describe(&self) -> string
}

class Circle {
    pub let radius: f64,

    pub fn new(radius: f64) -> Self {
        return Self { radius }
    }

    pub fn circumference(&self) -> f64 {
        return 2.0 * 3.14159 * self.radius
    }
}

impl Circle {
    pub fn scale(&self, factor: f64) -> Self {
        return Circle::new(self.radius * factor)
    }
}

impl Drawable for Circle {
    fn draw(&self) {
        println!("Drawing circle r={}", self.radius)
    }
    fn area(&self) -> f64 {
        return 3.14159 * self.radius * self.radius
    }
}

impl Measurable for Circle {
    fn perimeter(&self) -> f64 {
        return self.circumference()
    }
    fn describe(&self) -> string {
        return format!("Circle with radius {}", self.radius)
    }
}

class Rectangle {
    pub let width: f64,
    pub let height: f64,

    pub fn new(width: f64, height: f64) -> Self {
        return Self { width, height }
    }

    pub fn is_square(&self) -> bool {
        return self.width == self.height
    }
}

impl Drawable for Rectangle {
    fn draw(&self) {
        println!("Drawing rectangle {}x{}", self.width, self.height)
    }
    fn area(&self) -> f64 {
        return self.width * self.height
    }
}

impl Measurable for Rectangle {
    fn perimeter(&self) -> f64 {
        return 2.0 * (self.width + self.height)
    }
    fn describe(&self) -> string {
        return format!("Rectangle {}x{}", self.width, self.height)
    }
}

struct Stack<T> {
    items: Vec<T>,
    capacity: usize,
}

impl<T> Stack<T> {
    pub fn new(capacity: usize) -> Self {
        return Self { items: Vec::new(), capacity }
    }

    pub fn push(&mut self, item: T) -> bool {
        if self.items.len() >= self.capacity {
            return false
        }
        self.items.push(item)
        return true
    }

    pub fn pop(&mut self) -> Option<T> {
        return self.items.pop()
    }

    pub fn is_empty(&self) -> bool {
        return self.items.len() == 0
    }

    pub fn len(&self) -> usize {
        return self.items.len()
    }
}

fn max_value<T: Ord>(a: T, b: T) -> T {
    if a >= b { a } else { b }
}

fn filter_positive(numbers: &[i32]) -> Vec<i32> {
    let mut result = Vec::new()
    for n in numbers {
        if *n > 0 {
            result.push(*n)
        }
    }
    return result
}

fn sum_slice(numbers: &[f64]) -> f64 {
    let mut total = 0.0
    for n in numbers {
        total += *n
    }
    return total
}

fn classify(score: i32) -> string {
    if score >= 90 {
        return "A".into()
    } else if score >= 80 {
        return "B".into()
    } else if score >= 70 {
        return "C".into()
    } else if score >= 60 {
        return "D".into()
    } else {
        return "F".into()
    }
}

fn fibonacci(n: u32) -> u64 {
    if n == 0 { return 0 }
    if n == 1 { return 1 }
    let mut a: u64 = 0
    let mut b: u64 = 1
    let mut i = 2
    while i <= n {
        let temp = a + b
        a = b
        b = temp
        i += 1
    }
    return b
}

fn is_prime(n: u64) -> bool {
    if n < 2 { return false }
    if n == 2 { return true }
    if n % 2 == 0 { return false }
    let mut i: u64 = 3
    while i * i <= n {
        if n % i == 0 { return false }
        i += 2
    }
    return true
}

fn sort_array(arr: &mut Vec<i32>) {
    let n = arr.len()
    let mut i = 0
    while i < n {
        let mut j = i + 1
        while j < n {
            if arr[i] > arr[j] {
                let temp = arr[i]
                arr[i] = arr[j]
                arr[j] = temp
            }
            j += 1
        }
        i += 1
    }
}

fn main() {
    let c = Circle::new(5.0)
    c.draw()
    println!("area = {}", c.area())
    println!("perimeter = {}", c.perimeter())

    let r = Rectangle::new(10.0, 5.0)
    r.draw()
    println!("area = {}", r.area())
    println!("is_square = {}", r.is_square())

    let mut stack = Stack::new(10)
    stack.push(1)
    stack.push(2)
    stack.push(3)
    println!("stack len = {}", stack.len())

    let nums = [3, -1, 4, -5, 9, 2, -7, 8]
    let positives = filter_positive(&nums)
    println!("positives count = {}", positives.len())

    let scores = [95, 82, 67, 73, 55, 88, 91, 44]
    for s in scores {
        println!("score {} -> {}", s, classify(s))
    }

    for i in 0..20 {
        print!("{} ", fibonacci(i))
    }
    println!("")

    let mut primes = Vec::new()
    let mut n = 2
    while primes.len() < 20 {
        if is_prime(n) {
            primes.push(n)
        }
        n += 1
    }
    println!("first 20 primes: {:?}", primes)
}
