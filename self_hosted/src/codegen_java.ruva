// Java code generator — transpiles Ruva AST to Java source code
// Self-hosted: written in Ruva, transpiled to Rust
// Original: src/codegen_java.rs (307 LOC)

struct JavaCodeGen {
    output: string,
    indent: usize,
}

impl JavaCodeGen {
    pub fn new() -> Self {
        return JavaCodeGen { output: String::new(), indent: 0 }
    }

    fn write_indent(&mut self) {
        let mut i = 0
        while i < self.indent {
            self.output.push_str("    ")
            i += 1
        }
    }

    fn writeln(&mut self, s: string) {
        self.write_indent()
        self.output.push_str(&s)
        self.output.push('\n')
    }

    fn write_str(&mut self, s: string) {
        self.output.push_str(&s)
    }

    pub fn generate_java(&mut self, program: &Program) -> string {
        self.writeln("// Generated by Ruva transpiler (Java backend)")
        self.writeln("")
        for item in &program.items {
            self.gen_item(item)
        }
        let result = self.output.clone()
        self.output.clear()
        return result
    }

    fn gen_item(&mut self, item: &Item) {
        if let Item::Function(f) = item { self.gen_function(f) }
        if let Item::Struct(s) = item { self.gen_struct(s) }
        if let Item::Class(c) = item { self.gen_class(c) }
        if let Item::Enum(e) = item { self.gen_enum(e) }
        if let Item::Impl(imp) = item { self.gen_impl(imp) }
        if let Item::Trait(t) = item { self.gen_trait(t) }
        if let Item::Import(imp) = item { self.gen_import(imp) }
    }

    fn gen_function(&mut self, f: &FunctionDef) {
        let vis = if f.is_pub { "public " } else { "private " }
        let ret = match &f.return_type {
            Some(ty) => format!(" {}", self.type_str(ty)),
            None => " void".to_string(),
        }
        self.writeln(&format!("{}static {}({}){}", vis, f.name, "Object".to_string(), ret))
        self.indent += 1
        self.gen_block(&f.body)
        self.indent -= 1
        self.writeln("}")
        self.writeln("")
    }

    fn gen_struct(&mut self, s: &StructDef) {
        self.writeln(&format!("public record {}({}) {{}}", s.name, "Object".to_string()))
        self.writeln("")
    }

    fn gen_enum(&mut self, e: &EnumDef) {
        self.writeln(&format!("public enum {} {{", e.name))
        self.indent += 1
        let mut i = 0
        while i < e.variants.len() {
            let v = &e.variants[i]
            let sep = if i < e.variants.len() - 1 { "," } else { ";" }
            self.writeln(&format!("{}{}", v.name, sep))
            i += 1
        }
        self.indent -= 1
        self.writeln("}")
        self.writeln("")
    }

    fn gen_class(&mut self, c: &ClassDef) {
        self.writeln(&format!("public class {} {{", c.name))
        self.indent += 1
        for f in &c.fields {
            self.writeln(&format!("public {} {};", self.type_str(&f.ty), f.name))
        }
        for m in &c.methods {
            self.gen_function(m)
        }
        self.indent -= 1
        self.writeln("}")
        self.writeln("")
    }

    fn gen_impl(&mut self, imp: &ImplBlock) {
        self.writeln(&format!("// impl {}", self.type_str(&imp.self_type)))
        for m in &imp.methods {
            self.gen_function(m)
        }
    }

    fn gen_trait(&mut self, t: &TraitDef) {
        self.writeln(&format!("public interface {} {{", t.name))
        self.indent += 1
        for m in &t.methods {
            self.writeln(&format!("{}();", m.name))
        }
        self.indent -= 1
        self.writeln("}")
        self.writeln("")
    }

    fn gen_import(&mut self, imp: &ImportDef) {
        self.writeln(&format!("import {};", imp.path))
    }

    fn gen_block(&mut self, block: &Block) {
        for stmt in &block.stmts {
            self.gen_stmt(stmt)
        }
    }

    fn gen_stmt(&mut self, stmt: &Stmt) {
        if let Stmt::Expr(expr) = stmt {
            self.write_indent()
            self.gen_expr(expr)
            self.output.push_str(";\n")
        }
        if let Stmt::Return(expr) = stmt {
            self.write_indent()
            if let Some(e) = expr {
                self.write_str("return ".to_string())
                self.gen_expr(e)
                self.output.push_str(";\n")
            } else {
                self.output.push_str("return;\n")
            }
        }
        if let Stmt::Break(_) = stmt {
            self.writeln("break;")
        }
        if let Stmt::Continue = stmt {
            self.writeln("continue;")
        }
    }

    fn gen_expr(&mut self, expr: &Expr) {
        if let Expr::Int(n) = expr {
            self.output.push_str(&format!("{}L", n))
        }
        if let Expr::Float(f) = expr {
            self.output.push_str(&format!("{}", f))
        }
        if let Expr::Str(s) = expr {
            self.output.push_str(&format!("\"{}\"", s))
        }
        if let Expr::Bool(b) = expr {
            if *b { self.output.push_str("true") } else { self.output.push_str("false") }
        }
        if let Expr::Null = expr {
            self.output.push_str("null")
        }
        if let Expr::Self_ = expr {
            self.output.push_str("this")
        }
        if let Expr::Ident(n) = expr {
            self.output.push_str(n)
        }
        if let Expr::Call(function, args) = expr {
            self.gen_expr(function)
            self.output.push('(')
            let mut i = 0
            while i < args.len() {
                if i > 0 { self.output.push_str(", ") }
                self.gen_expr(&args[i])
                i += 1
            }
            self.output.push(')')
        }
        if let Expr::MethodCall(object, method, args) = expr {
            self.gen_expr(object)
            self.output.push('.')
            self.output.push_str(method)
            self.output.push('(')
            let mut i = 0
            while i < args.len() {
                if i > 0 { self.output.push_str(", ") }
                self.gen_expr(&args[i])
                i += 1
            }
            self.output.push(')')
        }
        if let Expr::Field(object, field) = expr {
            self.gen_expr(object)
            self.output.push('.')
            self.output.push_str(field)
        }
    }

    fn type_str(&self, ty: &Type) -> string {
        if let Type::Name(n) = ty {
            if n == "i32" || n == "u32" { return "int".to_string() }
            if n == "i64" || n == "u64" || n == "usize" || n == "isize" { return "long".to_string() }
            if n == "f32" { return "float".to_string() }
            if n == "f64" { return "double".to_string() }
            if n == "bool" { return "boolean".to_string() }
            if n == "string" { return "String".to_string() }
            if n == "char" { return "char".to_string() }
            return n.clone()
        }
        return "Object".to_string()
    }
}
