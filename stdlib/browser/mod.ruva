// ─── Fetch API ──────────────────────────────────────────────────────────────

mod fetch {
    pub struct Response {
        pub status: u16,
        pub status_text: string,
    }

    pub struct Request {
        pub method: string,
        pub url: string,
        pub body: Vec<u8>,
    }

    enum JsonValue {
        String(string),
        Number(f64),
        Bool(bool),
        Null,
    }

    impl Response {
        pub fn ok(&self) -> bool {
            return self.status >= 200 && self.status < 300
        }

        pub fn json(&self) -> Result<JsonValue, string> {
            return Result::Err("Not implemented".into())
        }

        pub fn text(&self) -> Result<string, string> {
            return Result::Err("Not implemented".into())
        }

        pub fn array_buffer(&self) -> Result<Vec<u8>, string> {
            return Result::Err("Not implemented".into())
        }
    }

    impl Request {
        pub fn new(url: string) -> Request {
            return Request {
                method: "GET".into(),
                url,
                body: Option::None,
            }
        }

        pub fn set_method(&mut self, method: string) {
            self.method = method
        }

        pub fn set_body(&mut self, body: Vec<u8>) {
            self.body = Option::Some(body)
        }
    }

    pub fn fetch_url(request: Request) -> Result<Response, string> {
        return Result::Err("Not implemented".into())
    }

    pub fn get(url: string) -> Result<Response, string> {
        let request = Request::new(url)
        return fetch_url(request)
    }

    pub fn post(url: string, body: Vec<u8>) -> Result<Response, string> {
        let mut request = Request::new(url)
        request.set_method("POST".into())
        request.set_body(body)
        return fetch_url(request)
    }
}

