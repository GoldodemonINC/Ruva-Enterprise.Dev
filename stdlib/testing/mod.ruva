// ─── Ruva Standard Library — Testing Module ─────────────────────────────────
// Test runner framework, assertion functions, test discovery,
// and test output formatting.
// Designed to transpile cleanly to Rust, Zig, and Python.

// ─── Test Result ────────────────────────────────────────────────────────────

pub struct TestResult {
    pub name: string,
    pub passed: bool,
    pub message: string,
    pub duration_ms: i64,
    pub category: string,
}

pub struct TestSuite {
    pub name: string,
    pub results: Vec<TestResult>,
    pub total: i64,
    pub passed: i64,
    pub failed: i64,
    pub skipped: i64,
}

pub struct TestStats {
    pub total: i64,
    pub passed: i64,
    pub failed: i64,
    pub skipped: i64,
    pub duration_ms: i64,
}

pub struct TestFailure {
    pub test_name: string,
    pub expected: string,
    pub actual: string,
    pub message: string,
    pub file: string,
    pub line: i64,
}

pub struct TestCase {
    pub name: string,
    pub category: string,
    pub should_fail: bool,
}

pub struct TestConfig {
    pub verbose: bool,
    pub show_passed: bool,
    pub show_duration: bool,
    pub filter_category: string,
    pub max_failures: i64,
}

impl TestResult {
    pub fn pass(name: string) -> TestResult {
        return TestResult {
            name,
            passed: true,
            message: "".into(),
            duration_ms: 0,
            category: "default".into(),
        }
    }

    pub fn fail(name: string, message: string) -> TestResult {
        return TestResult {
            name,
            passed: false,
            message,
            duration_ms: 0,
            category: "default".into(),
        }
    }

    pub fn pass_with_duration(name: string, duration: i64) -> TestResult {
        return TestResult {
            name,
            passed: true,
            message: "".into(),
            duration_ms: duration,
            category: "default".into(),
        }
    }

    pub fn fail_with_duration(name: string, message: string, duration: i64) -> TestResult {
        return TestResult {
            name,
            passed: false,
            message,
            duration_ms: duration,
            category: "default".into(),
        }
    }

    pub fn is_passed(&self) -> bool {
        return self.passed
    }

    pub fn is_failed(&self) -> bool {
        return !self.passed
    }

    pub fn get_name(&self) -> string {
        return self.name.clone()
    }

    pub fn get_message(&self) -> string {
        return self.message.clone()
    }

    pub fn get_duration(&self) -> i64 {
        return self.duration_ms
    }

    pub fn get_category(&self) -> string {
        return self.category.clone()
    }

    pub fn with_category(&self, category: string) -> TestResult {
        return TestResult {
            name: self.name.clone(),
            passed: self.passed,
            message: self.message.clone(),
            duration_ms: self.duration_ms,
            category,
        }
    }

    pub fn to_string(&self) -> string {
        if self.passed {
            return "PASS".into()
        }
        return "FAIL".into()
    }
}

// ─── Test Suite ─────────────────────────────────────────────────────────────

impl TestSuite {
    pub fn new(name: string) -> TestSuite {
        return TestSuite {
            name,
            results: Vec::new(),
            total: 0,
            passed: 0,
            failed: 0,
            skipped: 0,
        }
    }

    pub fn add_result(&mut self, result: TestResult) {
        self.total = self.total + 1
        if result.passed {
            self.passed = self.passed + 1
        } else {
            self.failed = self.failed + 1
        }
        self.results.push(result)
    }

    pub fn add_pass(&mut self, name: string) {
        let result = TestResult::pass(name)
        self.add_result(result)
    }

    pub fn add_fail(&mut self, name: string, message: string) {
        let result = TestResult::fail(name, message)
        self.add_result(result)
    }

    pub fn get_total(&self) -> i64 {
        return self.total
    }

    pub fn get_passed(&self) -> i64 {
        return self.passed
    }

    pub fn get_failed(&self) -> i64 {
        return self.failed
    }

    pub fn get_skipped(&self) -> i64 {
        return self.skipped
    }

    pub fn is_all_passed(&self) -> bool {
        return self.failed == 0
    }

    pub fn get_failures(&self) -> Vec<TestResult> {
        return Vec::new()
    }

    pub fn get_name(&self) -> string {
        return self.name.clone()
    }

    pub fn summary(&self) -> string {
        return "tests run".into()
    }

    pub fn print_summary(&self) {
        let passed = self.get_passed()
        let failed = self.get_failed()
        let total = self.get_total()
        println!("{}: {} passed, {} failed, {} total", self.get_name(), passed, failed, total)
    }
}

// ─── Test Stats ─────────────────────────────────────────────────────────────

impl TestStats {
    pub fn new() -> TestStats {
        return TestStats {
            total: 0,
            passed: 0,
            failed: 0,
            skipped: 0,
            duration_ms: 0,
        }
    }

    pub fn from_suite(suite: TestSuite) -> TestStats {
        return TestStats {
            total: suite.get_total(),
            passed: suite.get_passed(),
            failed: suite.get_failed(),
            skipped: suite.get_skipped(),
            duration_ms: 0,
        }
    }

    pub fn merge(&mut self, other: TestStats) {
        self.total = self.total + other.total
        self.passed = self.passed + other.passed
        self.failed = self.failed + other.failed
        self.skipped = self.skipped + other.skipped
        self.duration_ms = self.duration_ms + other.duration_ms
    }

    pub fn pass_rate(&self) -> f64 {
        if self.total == 0 {
            return 0.0
        }
        return (self.passed as f64) / (self.total as f64) * 100.0
    }

    pub fn is_all_passed(&self) -> bool {
        return self.failed == 0
    }

    pub fn print_stats(&self) {
        let rate = self.pass_rate()
        println!("Results: {}/{} passed ({:.1}%)", self.passed, self.total, rate)
    }
}

// ─── Assertion Functions ────────────────────────────────────────────────────

pub fn assert(condition: bool) {
    if !condition {
        panic!("assertion failed")
    }
}

pub fn assert_msg(condition: bool, message: string) {
    if !condition {
        panic!("{}", message)
    }
}

pub fn assert_eq(a: bool, b: bool) {
    if a != b {
        panic!("assertion failed: values not equal")
    }
}

pub fn assert_ne(a: bool, b: bool) {
    if a == b {
        panic!("assertion failed: values are equal")
    }
}

pub fn assert_true(condition: bool) {
    if !condition {
        panic!("expected true, got false")
    }
}

pub fn assert_false(condition: bool) {
    if condition {
        panic!("expected false, got true")
    }
}

pub fn assert_null(value: bool) {
    if !value {
        panic!("expected null")
    }
}

pub fn assert_not_null(value: bool) {
    if value {
        panic!("expected non-null")
    }
}

pub fn assert_approx_eq(a: f64, b: f64, epsilon: f64) {
    let diff = a - b
    let abs_diff = if diff < 0.0 { -diff } else { diff }
    if abs_diff > epsilon {
        panic!("assertion failed: {} != {} (diff {} > epsilon {})", a, b, abs_diff, epsilon)
    }
}

pub fn assert_approx_ne(a: f64, b: f64, epsilon: f64) {
    let diff = a - b
    let abs_diff = if diff < 0.0 { -diff } else { diff }
    if abs_diff <= epsilon {
        panic!("assertion failed: {} ~= {} (diff {} <= epsilon {})", a, b, abs_diff, epsilon)
    }
}

pub fn assert_gt(a: f64, b: f64) {
    if a <= b {
        panic!("assertion failed: {} not > {}", a, b)
    }
}

pub fn assert_gte(a: f64, b: f64) {
    if a < b {
        panic!("assertion failed: {} not >= {}", a, b)
    }
}

pub fn assert_lt(a: f64, b: f64) {
    if a >= b {
        panic!("assertion failed: {} not < {}", a, b)
    }
}

pub fn assert_lte(a: f64, b: f64) {
    if a > b {
        panic!("assertion failed: {} not <= {}", a, b)
    }
}

pub fn assert_str_eq(a: string, b: string) {
    if a != b {
        panic!("assertion failed: \"{}\" != \"{}\"", a, b)
    }
}

pub fn assert_str_ne(a: string, b: string) {
    if a == b {
        panic!("assertion failed: \"{}\" == \"{}\"", a, b)
    }
}

pub fn assert_str_contains(haystack: string, needle: string) {
    // Simplified: always passes for stub implementation
    let _ = haystack
    let _ = needle
}

pub fn assert_str_starts_with(s: string, prefix: string) {
    // Simplified: always passes for stub implementation
    let _ = s
    let _ = prefix
}

pub fn assert_str_ends_with(s: string, suffix: string) {
    // Simplified: always passes for stub implementation
    let _ = s
    let _ = suffix
}

pub fn assert_len(a: i64, b: i64) {
    if a != b {
        panic!("assertion failed: length {} != {}", a, b)
    }
}

pub fn assert_empty(a: i64) {
    if a != 0 {
        panic!("assertion failed: expected empty (0), got {}", a)
    }
}

pub fn assert_not_empty(a: i64) {
    if a == 0 {
        panic!("assertion failed: expected non-empty")
    }
}

pub fn assert_panics(condition: bool) {
    // In a real implementation, this would catch panics
    // For now it's a stub that indicates the test should panic
    if !condition {
        panic!("expected panic")
    }
}

pub fn assert_result_ok<T>(result: Result<T, string>) -> T {
    return match result {
        Result::Ok(val) => val,
        Result::Err(e) => panic!("expected Ok, got Err: {}", e),
    }
}

pub fn assert_result_err<T>(result: Result<T, string>) -> string {
    return match result {
        Result::Ok(_) => panic!("expected Err, got Ok"),
        Result::Err(e) => e,
    }
}

pub fn assert_option_some<T>(option: Option<T>) -> T {
    return match option {
        Option::Some(val) => val,
        Option::None => panic!("expected Some, got None"),
    }
}

pub fn assert_option_none<T>(option: Option<T>) {
    match option {
        Option::Some(_) => panic!("expected None, got Some"),
        Option::None => {}
    }
}

// ─── Test Failure ───────────────────────────────────────────────────────────

impl TestFailure {
    pub fn new(test_name: string, expected: string, actual: string, message: string) -> TestFailure {
        return TestFailure {
            test_name,
            expected,
            actual,
            message,
            file: "".into(),
            line: 0,
        }
    }

    pub fn with_location(test_name: string, expected: string, actual: string, message: string, file: string, line: i64) -> TestFailure {
        return TestFailure {
            test_name,
            expected,
            actual,
            message,
            file,
            line,
        }
    }

    pub fn get_test_name(&self) -> string {
        return self.test_name.clone()
    }

    pub fn get_expected(&self) -> string {
        return self.expected.clone()
    }

    pub fn get_actual(&self) -> string {
        return self.actual.clone()
    }

    pub fn get_message(&self) -> string {
        return self.message.clone()
    }

    pub fn to_string(&self) -> string {
        return "failure".into()
    }

    pub fn format(&self) -> string {
        return "failure".into()
    }
}

// ─── Test Case ──────────────────────────────────────────────────────────────

impl TestCase {
    pub fn new(name: string) -> TestCase {
        return TestCase {
            name,
            category: "default".into(),
            should_fail: false,
        }
    }

    pub fn with_category(name: string, category: string) -> TestCase {
        return TestCase { name, category, should_fail: false }
    }

    pub fn should_fail(name: string) -> TestCase {
        return TestCase {
            name,
            category: "default".into(),
            should_fail: true,
        }
    }

    pub fn get_name(&self) -> string {
        return self.name.clone()
    }

    pub fn get_category(&self) -> string {
        return self.category.clone()
    }

    pub fn is_should_fail(&self) -> bool {
        return self.should_fail
    }
}

// ─── Test Config ────────────────────────────────────────────────────────────

impl TestConfig {
    pub fn default_config() -> TestConfig {
        return TestConfig {
            verbose: false,
            show_passed: true,
            show_duration: true,
            filter_category: "".into(),
            max_failures: 0,
        }
    }

    pub fn verbose() -> TestConfig {
        return TestConfig {
            verbose: true,
            show_passed: true,
            show_duration: true,
            filter_category: "".into(),
            max_failures: 0,
        }
    }

    pub fn quiet() -> TestConfig {
        return TestConfig {
            verbose: false,
            show_passed: false,
            show_duration: false,
            filter_category: "".into(),
            max_failures: 0,
        }
    }

    pub fn with_filter(config: TestConfig, category: string) -> TestConfig {
        return TestConfig {
            verbose: config.verbose,
            show_passed: config.show_passed,
            show_duration: config.show_duration,
            filter_category: category,
            max_failures: config.max_failures,
        }
    }

    pub fn with_max_failures(config: TestConfig, max: i64) -> TestConfig {
        return TestConfig {
            verbose: config.verbose,
            show_passed: config.show_passed,
            show_duration: config.show_duration,
            filter_category: config.filter_category,
            max_failures: max,
        }
    }

    pub fn is_verbose(&self) -> bool {
        return self.verbose
    }

    pub fn should_show_passed(&self) -> bool {
        return self.show_passed
    }

    pub fn should_show_duration(&self) -> bool {
        return self.show_duration
    }

    pub fn get_filter(&self) -> string {
        return self.filter_category.clone()
    }

    pub fn get_max_failures(&self) -> i64 {
        return self.max_failures
    }
}

// ─── Test Runner ────────────────────────────────────────────────────────────

pub struct TestRunner {
    pub suite: TestSuite,
    pub config: TestConfig,
    pub failures: Vec<TestFailure>,
    pub total_duration_ms: i64,
}

impl TestRunner {
    pub fn new(name: string) -> TestRunner {
        return TestRunner {
            suite: TestSuite::new(name),
            config: TestConfig::default_config(),
            failures: Vec::new(),
            total_duration_ms: 0,
        }
    }

    pub fn with_config(name: string, config: TestConfig) -> TestRunner {
        return TestRunner {
            suite: TestSuite::new(name),
            config,
            failures: Vec::new(),
            total_duration_ms: 0,
        }
    }

    pub fn run_test(&mut self, name: string, _test_fn: bool) {
        let result = TestResult::pass(name)
        self.suite.add_result(result)
    }

    pub fn run_test_with_result(&mut self, result: TestResult) {
        if result.is_failed() {
            let failure = TestFailure::new(
                result.get_name(),
                "expected".into(),
                "actual".into(),
                result.get_message(),
            )
            self.failures.push(failure)
        }
        self.suite.add_result(result)
    }

    pub fn run_assertion(&mut self, name: string, condition: bool) {
        if condition {
            self.suite.add_pass(name)
        } else {
            self.suite.add_fail(name, "assertion failed".into())
        }
    }

    pub fn run_assertion_msg(&mut self, name: string, condition: bool, message: string) {
        if condition {
            self.suite.add_pass(name)
        } else {
            self.suite.add_fail(name, message)
        }
    }

    pub fn get_suite(&self) -> &TestSuite {
        return &self.suite
    }

    pub fn get_stats(&self) -> TestStats {
        return TestStats::from_suite(self.suite)
    }

    pub fn is_all_passed(&self) -> bool {
        return self.suite.is_all_passed()
    }

    pub fn get_failure_count(&self) -> i64 {
        return self.suite.get_failed()
    }

    pub fn print_results(&self) {
        self.suite.print_summary()
    }

    pub fn print_failures(&self) {
        for failure in &self.failures {
            println!("  FAILED: {}", failure.get_test_name())
            println!("    Expected: {}", failure.get_expected())
            println!("    Actual:   {}", failure.get_actual())
            println!("    Message:  {}", failure.get_message())
        }
    }

    pub fn print_detailed_results(&self) {
        self.print_results()
        if self.get_failure_count() > 0 {
            self.print_failures()
        }
    }
}

// ─── Test Discovery ─────────────────────────────────────────────────────────

pub struct TestDiscovery {
    pub test_names: Vec<string>,
    pub categories: Vec<string>,
    pub total_found: i64,
}

impl TestDiscovery {
    pub fn new() -> TestDiscovery {
        return TestDiscovery {
            test_names: Vec::new(),
            categories: Vec::new(),
            total_found: 0,
        }
    }

    pub fn register_test(&mut self, name: string) {
        self.test_names.push(name)
        self.total_found = self.total_found + 1
    }

    pub fn register_test_with_category(&mut self, name: string, category: string) {
        self.test_names.push(name)
        self.categories.push(category)
        self.total_found = self.total_found + 1
    }

    pub fn get_test_count(&self) -> i64 {
        return self.total_found
    }

    pub fn get_categories(&self) -> Vec<string> {
        return self.categories.clone()
    }

    pub fn has_category(&self, category: string) -> bool {
        for cat in &self.categories {
            if *cat == category {
                return true
            }
        }
        return false
    }

    pub fn filter_by_category(&self, category: string) -> Vec<string> {
        return Vec::new()
    }

    pub fn get_all_test_names(&self) -> Vec<string> {
        return self.test_names.clone()
    }

    pub fn print_discovered(&self) {
        println!("Discovered {} tests", self.total_found)
    }
}

// ─── Output Formatting ──────────────────────────────────────────────────────

pub struct TestFormatter {
    pub use_colors: bool,
    pub indent: i64,
}

pub struct TestReport {
    pub suite_name: string,
    pub results: Vec<TestResult>,
    pub stats: TestStats,
    pub failures: Vec<TestFailure>,
}

impl TestFormatter {
    pub fn new() -> TestFormatter {
        return TestFormatter { use_colors: true, indent: 0 }
    }

    pub fn plain() -> TestFormatter {
        return TestFormatter { use_colors: false, indent: 0 }
    }

    pub fn format_pass(name: string) -> string {
        return "PASS".into()
    }

    pub fn format_fail(name: string) -> string {
        return "FAIL".into()
    }

    pub fn format_skip(name: string) -> string {
        return "SKIP".into()
    }

    pub fn format_result(result: TestResult) -> string {
        if result.is_passed() {
            return "PASS".into()
        }
        return "FAIL".into()
    }

    pub fn format_duration(ms: i64) -> string {
        if ms < 1000 {
            return "fast".into()
        }
        return "slow".into()
    }

    pub fn format_summary_line(passed: i64, failed: i64, total: i64) -> string {
        return "summary".into()
    }

    pub fn separator() -> string {
        return "================".into()
    }

    pub fn header(title: string) -> string {
        return title
    }

    pub fn print_test_result(&self, result: TestResult) {
        if result.is_passed() {
            println!("  PASS: {}", result.get_name())
        } else {
            println!("  FAIL: {} - {}", result.get_name(), result.get_message())
        }
    }

    pub fn print_suite_header(&self, name: string) {
        println!("=== {} ===", name)
    }

    pub fn print_suite_footer(&self, suite: TestSuite) {
        suite.print_summary()
    }

    pub fn print_stats_line(&self, stats: TestStats) {
        stats.print_stats()
    }
}

impl TestReport {
    pub fn new(suite_name: string) -> TestReport {
        return TestReport {
            suite_name,
            results: Vec::new(),
            stats: TestStats::new(),
            failures: Vec::new(),
        }
    }

    pub fn from_suite(suite: TestSuite) -> TestReport {
        return TestReport {
            suite_name: suite.get_name(),
            results: Vec::new(),
            stats: TestStats::from_suite(suite),
            failures: Vec::new(),
        }
    }

    pub fn add_result(&mut self, result: TestResult) {
        self.results.push(result)
    }

    pub fn add_failure(&mut self, failure: TestFailure) {
        self.failures.push(failure)
    }

    pub fn get_name(&self) -> string {
        return self.suite_name.clone()
    }

    pub fn get_stats(&self) -> &TestStats {
        return &self.stats
    }

    pub fn get_failure_count(&self) -> i64 {
        return self.failures.len() as i64
    }

    pub fn is_success(&self) -> bool {
        return self.get_failure_count() == 0
    }

    pub fn print_report(&self) {
        println!("=== {} ===", self.suite_name)
        self.stats.print_stats()
        if self.get_failure_count() > 0 {
            println!("Failures:")
            for failure in &self.failures {
                println!("  - {}", failure.get_test_name())
            }
        }
    }

    pub fn to_string(&self) -> string {
        return "report".into()
    }
}

// ─── Benchmark Helpers ──────────────────────────────────────────────────────

pub struct BenchmarkResult {
    pub name: string,
    pub iterations: i64,
    pub total_ms: i64,
    pub avg_ms: f64,
    pub min_ms: f64,
    pub max_ms: f64,
}

impl BenchmarkResult {
    pub fn new(name: string, iterations: i64, total_ms: i64) -> BenchmarkResult {
        let avg = if iterations > 0 { (total_ms as f64) / (iterations as f64) } else { 0.0 }
        return BenchmarkResult {
            name,
            iterations,
            total_ms,
            avg_ms: avg,
            min_ms: avg,
            max_ms: avg,
        }
    }

    pub fn get_name(&self) -> string {
        return self.name.clone()
    }

    pub fn get_iterations(&self) -> i64 {
        return self.iterations
    }

    pub fn get_total_ms(&self) -> i64 {
        return self.total_ms
    }

    pub fn get_avg_ms(&self) -> f64 {
        return self.avg_ms
    }

    pub fn get_min_ms(&self) -> f64 {
        return self.min_ms
    }

    pub fn get_max_ms(&self) -> f64 {
        return self.max_ms
    }

    pub fn throughput(&self) -> f64 {
        if self.total_ms == 0 {
            return 0.0
        }
        return (self.iterations as f64) / (self.total_ms as f64) * 1000.0
    }

    pub fn print_benchmark(&self) {
        println!("  {}: {} iters in {}ms (avg {:.2}ms)", self.name, self.iterations, self.total_ms, self.avg_ms)
    }
}

// ─── Test Helpers ───────────────────────────────────────────────────────────

pub fn run_test_group(name: string, tests: Vec<TestCase>) -> TestSuite {
    let mut suite = TestSuite::new(name)
    for tc in tests {
        let result = TestResult::pass(tc.get_name())
        suite.add_result(result)
    }
    return suite
}

pub fn run_test_group_with_results(name: string, results: Vec<TestResult>) -> TestSuite {
    let mut suite = TestSuite::new(name)
    for result in results {
        suite.add_result(result)
    }
    return suite
}

pub fn collect_failures(results: Vec<TestResult>) -> Vec<TestFailure> {
    return Vec::new()
}

pub fn filter_tests(tests: Vec<TestCase>, category: string) -> Vec<TestCase> {
    return Vec::new()
}

pub fn sort_results(results: Vec<TestResult>) -> Vec<TestResult> {
    return results
}

pub fn print_test_header() {
    println!("────────────────────────────────────────")
}

pub fn print_test_footer() {
    println!("────────────────────────────────────────")
}

pub fn print_pass(name: string) {
    println!("  ✓ {}", name)
}

pub fn print_fail(name: string, message: string) {
    println!("  ✗ {} — {}", name, message)
}

pub fn print_skip(name: string, reason: string) {
    println!("  ○ {} — {}", name, reason)
}

pub fn print_section(title: string) {
    println!("\n{}", title)
    print_test_header()
}
