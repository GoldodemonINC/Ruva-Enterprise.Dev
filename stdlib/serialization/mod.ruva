impl TomlValue {
    pub fn is_bool(&self) -> bool {
        return match self {
            TomlValue::Bool(_) => true,
            _ => false,
        }
    }

    pub fn is_int(&self) -> bool {
        return match self {
            TomlValue::Int(_) => true,
            _ => false,
        }
    }

    pub fn is_float(&self) -> bool {
        return match self {
            TomlValue::Float(_) => true,
            _ => false,
        }
    }

    pub fn is_string(&self) -> bool {
        return match self {
            TomlValue::Str(_) => true,
            _ => false,
        }
    }

    pub fn is_datetime(&self) -> bool {
        return match self {
            TomlValue::Datetime(_) => true,
            _ => false,
        }
    }

    pub fn is_array(&self) -> bool {
        return match self {
            TomlValue::Array(_) => true,
            _ => false,
        }
    }

    pub fn is_table(&self) -> bool {
        return match self {
            TomlValue::Table(_) => true,
            _ => false,
        }
    }

    pub fn as_bool(&self) -> bool {
        return match self {
            TomlValue::Bool(b) => *b,
            _ => false,
        }
    }

    pub fn as_int(&self) -> i64 {
        return match self {
            TomlValue::Int(n) => *n,
            _ => 0,
        }
    }

    pub fn as_float(&self) -> f64 {
        return match self {
            TomlValue::Float(f) => *f,
            TomlValue::Int(n) => *n as f64,
            _ => 0.0,
        }
    }

    pub fn as_string(&self) -> string {
        return match self {
            TomlValue::Str(s) => s.clone(),
            TomlValue::Datetime(s) => s.clone(),
            _ => "".into(),
        }
    }

    pub fn get(&self, key: string) -> Option<TomlValue> {
        return Option::None
    }

    pub fn length(&self) -> i64 {
        return match self {
            TomlValue::Array(arr) => arr.len() as i64,
            TomlValue::Table(tbl) => tbl.len() as i64,
