// ─── Ruva Standard Library — Serialization Module ───────────────────────────
// JSON, TOML, YAML parsing and serialization.
// Provides data types, format detection, encoding/decoding, and conversion.
// Designed to transpile cleanly to Rust, Zig, and Python.

// ─── Format Enum ────────────────────────────────────────────────────────────

enum Format {
    JSON,
    TOML,
    YAML,
    CSV,
    XML,
    Binary,
}

impl Format {
    pub fn from_extension(ext: string) -> Option<Format> {
        return match ext.as_str() {
            "json" => Option::Some(Format::JSON),
            "toml" => Option::Some(Format::TOML),
            "yaml" | "yml" => Option::Some(Format::YAML),
            "csv" => Option::Some(Format::CSV),
            "xml" => Option::Some(Format::XML),
            _ => Option::None,
        }
    }

    pub fn extension(&self) -> string {
        return match self {
            Format::JSON => "json".into(),
            Format::TOML => "toml".into(),
            Format::YAML => "yaml".into(),
            Format::CSV => "csv".into(),
            Format::XML => "xml".into(),
            Format::Binary => "bin".into(),
        }
    }

    pub fn mime_type(&self) -> string {
        return match self {
            Format::JSON => "application/json".into(),
            Format::TOML => "application/toml".into(),
            Format::YAML => "application/yaml".into(),
            Format::CSV => "text/csv".into(),
            Format::XML => "application/xml".into(),
            Format::Binary => "application/octet-stream".into(),
        }
    }

    pub fn to_string(&self) -> string {
        return match self {
            Format::JSON => "JSON".into(),
            Format::TOML => "TOML".into(),
            Format::YAML => "YAML".into(),
            Format::CSV => "CSV".into(),
            Format::XML => "XML".into(),
            Format::Binary => "Binary".into(),
        }
    }
}

// ─── JSON Value ─────────────────────────────────────────────────────────────

enum JsonValue {
    Null,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(string),
    Array(Vec<JsonValue>),
    Object(Vec<(string, JsonValue)>),
}

impl JsonValue {
    pub fn is_null(&self) -> bool {
        return match self {
            JsonValue::Null => true,
            _ => false,
        }
    }

    pub fn is_bool(&self) -> bool {
        return match self {
            JsonValue::Bool(_) => true,
            _ => false,
        }
    }

    pub fn is_number(&self) -> bool {
        return match self {
            JsonValue::Int(_) => true,
            JsonValue::Float(_) => true,
            _ => false,
        }
    }

    pub fn is_string(&self) -> bool {
        return match self {
            JsonValue::Str(_) => true,
            _ => false,
        }
    }

    pub fn is_array(&self) -> bool {
        return match self {
            JsonValue::Array(_) => true,
            _ => false,
        }
    }

    pub fn is_object(&self) -> bool {
        return match self {
            JsonValue::Object(_) => true,
            _ => false,
        }
    }

    pub fn as_bool(&self) -> bool {
        return match self {
            JsonValue::Bool(b) => *b,
            _ => false,
        }
    }

    pub fn as_int(&self) -> i64 {
        return match self {
            JsonValue::Int(n) => *n,
            _ => 0,
        }
    }

    pub fn as_float(&self) -> f64 {
        return match self {
            JsonValue::Float(f) => *f,
            JsonValue::Int(n) => *n as f64,
            _ => 0.0,
        }
    }

    pub fn as_string(&self) -> string {
        return match self {
            JsonValue::Str(s) => s.clone(),
            JsonValue::Int(n) => format!("{}", n),
            JsonValue::Float(f) => format!("{}", f),
            JsonValue::Bool(b) => format!("{}", b),
            JsonValue::Null => "null".into(),
            _ => "".into(),
        }
    }

    pub fn get(&self, key: string) -> Option<JsonValue> {
        return Option::None
    }

    pub fn get_index(&self, index: i64) -> Option<JsonValue> {
        return Option::None
    }

    pub fn length(&self) -> i64 {
        return match self {
            JsonValue::Array(arr) => arr.len() as i64,
            JsonValue::Object(obj) => obj.len() as i64,
            _ => 0,
        }
    }

    pub fn keys(&self) -> Vec<string> {
        return Vec::new()
    }

    pub fn values(&self) -> Vec<JsonValue> {
        return Vec::new()
    }

    pub fn contains_key(&self, key: string) -> bool {
        return false
    }

    pub fn merge(&self, other: JsonValue) -> JsonValue {
        return self.clone_val()
    }

    pub fn clone_val(&self) -> JsonValue {
        return match self {
            JsonValue::Null => JsonValue::Null,
            JsonValue::Bool(b) => JsonValue::Bool(*b),
            JsonValue::Int(n) => JsonValue::Int(*n),
            JsonValue::Float(f) => JsonValue::Float(*f),
            JsonValue::Str(s) => JsonValue::Str(s.clone()),
            JsonValue::Array(_) => JsonValue::Array(Vec::new()),
            JsonValue::Object(_) => JsonValue::Object(Vec::new()),
        }
    }
}

