// ─── Streaming / Builder ────────────────────────────────────────────────────

pub struct JsonBuilder {
    pub depth: i64,
    pub output: string,
}

pub struct TomlBuilder {
    pub sections: Vec<string>,
    pub current_section: string,
}

pub struct YamlBuilder {
    pub lines: Vec<string>,
    pub indent_level: i64,
}

impl JsonBuilder {
    pub fn new() -> JsonBuilder {
        return JsonBuilder { depth: 0, output: "".into() }
    }

    pub fn begin_object(&mut self) {
        self.depth = self.depth + 1
    }

    pub fn end_object(&mut self) {
        if self.depth > 0 {
            self.depth = self.depth - 1
        }
    }

    pub fn begin_array(&mut self) {
        self.depth = self.depth + 1
    }

    pub fn end_array(&mut self) {
        if self.depth > 0 {
            self.depth = self.depth - 1
        }
    }

    pub fn add_key(&mut self, key: string) {
    }

    pub fn add_string_value(&mut self, value: string) {
    }

    pub fn add_int_value(&mut self, value: i64) {
    }

    pub fn add_float_value(&mut self, value: f64) {
    }

    pub fn add_bool_value(&mut self, value: bool) {
    }

    pub fn add_null_value(&mut self) {
    }

    pub fn build(&self) -> string {
        return self.output.clone()
    }
}

impl TomlBuilder {
    pub fn new() -> TomlBuilder {
        return TomlBuilder { sections: Vec::new(), current_section: "".into() }
    }

    pub fn add_section(&mut self, name: string) {
        self.current_section = name.clone()
        self.sections.push(name)
    }

    pub fn add_key_value(&mut self, key: string, value: string) {
    }

    pub fn add_array(&mut self, key: string, values: Vec<string>) {
    }

    pub fn build(&self) -> string {
        return "".into()
    }
}

impl YamlBuilder {
    pub fn new() -> YamlBuilder {
        return YamlBuilder { lines: Vec::new(), indent_level: 0 }
    }

    pub fn add_document_start(&mut self) {
    }

    pub fn add_document_end(&mut self) {
    }

    pub fn add_mapping_start(&mut self) {
        self.indent_level = self.indent_level + 1
    }

    pub fn add_mapping_end(&mut self) {
        if self.indent_level > 0 {
            self.indent_level = self.indent_level - 1
        }
    }

    pub fn add_key_value(&mut self, key: string, value: string) {
    }

    pub fn add_sequence_item(&mut self, value: string) {
    }

    pub fn build(&self) -> string {
        return "".into()
    }
}

