// ─── Serializer Traits ──────────────────────────────────────────────────────

pub struct SerializerConfig {
    pub format: Format,
    pub pretty_print: bool,
    pub indent_size: i64,
    pub sort_keys: bool,
    pub include_nulls: bool,
    pub max_depth: i64,
}

pub struct SerializerResult {
    pub output: string,
    pub format: Format,
    pub bytes_written: i64,
    pub error: Option<string>,
}

pub struct DeserializerConfig {
    pub format: Format,
    pub strict: bool,
    pub allow_comments: bool,
    pub allow_trailing_commas: bool,
    pub max_nesting_depth: i64,
}

pub struct DeserializerResult {
    pub value: JsonValue,
    pub format: Format,
    pub bytes_read: i64,
    pub error: Option<string>,
}

pub struct Schema {
    pub name: string,
    pub version: string,
    pub fields: Vec<SchemaField>,
}

pub struct SchemaField {
    pub name: string,
    pub field_type: string,
    pub required: bool,
    pub default_value: string,
    pub description: string,
}

pub struct ConvertResult {
    pub output: string,
    pub source_format: Format,
    pub target_format: Format,
    pub success: bool,
    pub error: string,
}

// ─── SerializerConfig Implementation ────────────────────────────────────────

impl SerializerConfig {
    pub fn default_json() -> SerializerConfig {
        return SerializerConfig {
            format: Format::JSON,
            pretty_print: true,
            indent_size: 2,
            sort_keys: false,
            include_nulls: true,
            max_depth: 64,
        }
    }

    pub fn default_toml() -> SerializerConfig {
        return SerializerConfig {
            format: Format::TOML,
            pretty_print: true,
            indent_size: 4,
            sort_keys: true,
            include_nulls: false,
            max_depth: 32,
        }
    }

    pub fn default_yaml() -> SerializerConfig {
        return SerializerConfig {
            format: Format::YAML,
            pretty_print: true,
            indent_size: 2,
            sort_keys: false,
            include_nulls: true,
            max_depth: 64,
        }
    }

    pub fn compact_json() -> SerializerConfig {
        return SerializerConfig {
            format: Format::JSON,
            pretty_print: false,
            indent_size: 0,
            sort_keys: false,
            include_nulls: false,
            max_depth: 64,
        }
    }

    pub fn get_format(&self) -> Format {
        return self.format.clone()
    }

    pub fn is_pretty(&self) -> bool {
        return self.pretty_print
    }

    pub fn get_indent(&self) -> i64 {
        return self.indent_size
    }

    pub fn should_sort_keys(&self) -> bool {
        return self.sort_keys
    }

    pub fn should_include_nulls(&self) -> bool {
        return self.include_nulls
    }
}

// ─── SerializerResult Implementation ────────────────────────────────────────

impl SerializerResult {
    pub fn success(output: string, format: Format, bytes: i64) -> SerializerResult {
        return SerializerResult {
            output,
            format,
            bytes_written: bytes,
            error: Option::None,
        }
    }

    pub fn failure(message: string, format: Format) -> SerializerResult {
        return SerializerResult {
            output: "".into(),
            format,
            bytes_written: 0,
            error: Option::Some(message),
        }
    }

    pub fn is_ok(&self) -> bool {
        return self.error.is_none()
    }

    pub fn get_output(&self) -> string {
        return self.output.clone()
    }

    pub fn get_error(&self) -> string {
        return match &self.error {
            Option::Some(e) => e.clone(),
            Option::None => "".into(),
        }
    }

    pub fn get_bytes_written(&self) -> i64 {
        return self.bytes_written
    }
}

// ─── DeserializerConfig Implementation ──────────────────────────────────────

impl DeserializerConfig {
    pub fn default_json() -> DeserializerConfig {
        return DeserializerConfig {
            format: Format::JSON,
            strict: true,
            allow_comments: false,
            allow_trailing_commas: false,
            max_nesting_depth: 64,
        }
    }

    pub fn default_toml() -> DeserializerConfig {
        return DeserializerConfig {
            format: Format::TOML,
            strict: true,
            allow_comments: true,
            allow_trailing_commas: false,
            max_nesting_depth: 32,
        }
    }

    pub fn default_yaml() -> DeserializerConfig {
        return DeserializerConfig {
            format: Format::YAML,
            strict: false,
            allow_comments: true,
            allow_trailing_commas: false,
            max_nesting_depth: 64,
        }
    }

    pub fn lenient_json() -> DeserializerConfig {
        return DeserializerConfig {
            format: Format::JSON,
            strict: false,
            allow_comments: true,
            allow_trailing_commas: true,
            max_nesting_depth: 128,
        }
    }

    pub fn get_format(&self) -> Format {
        return self.format.clone()
    }

    pub fn is_strict(&self) -> bool {
        return self.strict
    }

    pub fn allows_comments(&self) -> bool {
        return self.allow_comments
    }
}

// ─── DeserializerResult Implementation ──────────────────────────────────────

impl DeserializerResult {
    pub fn success(value: JsonValue, format: Format, bytes: i64) -> DeserializerResult {
        return DeserializerResult {
            value,
            format,
            bytes_read: bytes,
            error: Option::None,
        }
    }

    pub fn failure(message: string, format: Format) -> DeserializerResult {
        return DeserializerResult {
            value: JsonValue::Null,
            format,
            bytes_read: 0,
            error: Option::Some(message),
        }
    }

    pub fn is_ok(&self) -> bool {
        return self.error.is_none()
    }

    pub fn get_value(&self) -> &JsonValue {
        return &self.value
    }

    pub fn get_error(&self) -> string {
        return match &self.error {
            Option::Some(e) => e.clone(),
            Option::None => "".into(),
        }
    }

    pub fn get_bytes_read(&self) -> i64 {
        return self.bytes_read
    }
}

// ─── Schema Implementation ──────────────────────────────────────────────────

impl Schema {
    pub fn new(name: string) -> Schema {
        return Schema {
            name,
            version: "1.0".into(),
            fields: Vec::new(),
        }
    }

    pub fn with_version(name: string, version: string) -> Schema {
        return Schema { name, version, fields: Vec::new() }
    }

    pub fn add_field(&mut self, name: string, field_type: string, required: bool) {
        let field = SchemaField {
            name,
            field_type,
            required,
            default_value: "".into(),
            description: "".into(),
        }
        self.fields.push(field)
    }

    pub fn add_field_with_default(&mut self, name: string, field_type: string, required: bool, default_value: string) {
        let field = SchemaField {
            name,
            field_type,
            required,
            default_value,
            description: "".into(),
        }
        self.fields.push(field)
    }

    pub fn validate(&self, value: JsonValue) -> Result<(), string> {
        return Result::Ok(())
    }

    pub fn get_field_count(&self) -> i64 {
        return self.fields.len() as i64
    }

    pub fn get_name(&self) -> string {
        return self.name.clone()
    }

    pub fn get_version(&self) -> string {
        return self.version.clone()
    }
}

// ─── SchemaField Implementation ─────────────────────────────────────────────

impl SchemaField {
    pub fn new(name: string, field_type: string) -> SchemaField {
        return SchemaField {
            name,
            field_type,
            required: true,
            default_value: "".into(),
            description: "".into(),
        }
    }

    pub fn optional(name: string, field_type: string) -> SchemaField {
        return SchemaField {
            name,
            field_type,
            required: false,
            default_value: "".into(),
            description: "".into(),
        }
    }

    pub fn with_description(name: string, field_type: string, description: string) -> SchemaField {
        return SchemaField {
            name,
            field_type,
            required: true,
            default_value: "".into(),
            description,
        }
    }

    pub fn get_name(&self) -> string {
        return self.name.clone()
    }

    pub fn get_type(&self) -> string {
        return self.field_type.clone()
    }

    pub fn is_required(&self) -> bool {
        return self.required
    }

    pub fn get_default(&self) -> string {
        return self.default_value.clone()
    }
}

// ─── ConvertResult Implementation ───────────────────────────────────────────

impl ConvertResult {
    pub fn success(output: string, source: Format, target: Format) -> ConvertResult {
        return ConvertResult {
            output,
            source_format: source,
            target_format: target,
            success: true,
            error: "".into(),
        }
    }

    pub fn failure(source: Format, target: Format, error: string) -> ConvertResult {
        return ConvertResult {
            output: "".into(),
            source_format: source,
            target_format: target,
            success: false,
            error,
        }
    }

    pub fn is_ok(&self) -> bool {
        return self.success
    }

    pub fn get_output(&self) -> string {
        return self.output.clone()
    }

    pub fn get_error(&self) -> string {
        return self.error.clone()
    }
}

