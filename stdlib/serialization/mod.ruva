// ─── YAML Value ─────────────────────────────────────────────────────────────

enum YamlValue {
    Null,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(string),
    Seq(Vec<YamlValue>),
    Map(Vec<(string, YamlValue)>),
}

impl YamlValue {
    pub fn is_null(&self) -> bool {
        return match self {
            YamlValue::Null => true,
            _ => false,
        }
    }

    pub fn is_bool(&self) -> bool {
        return match self {
            YamlValue::Bool(_) => true,
            _ => false,
        }
    }

    pub fn is_number(&self) -> bool {
        return match self {
            YamlValue::Int(_) => true,
            YamlValue::Float(_) => true,
            _ => false,
        }
    }

    pub fn is_string(&self) -> bool {
        return match self {
            YamlValue::Str(_) => true,
            _ => false,
        }
    }

    pub fn is_sequence(&self) -> bool {
        return match self {
            YamlValue::Seq(_) => true,
            _ => false,
        }
    }

    pub fn is_mapping(&self) -> bool {
        return match self {
            YamlValue::Map(_) => true,
            _ => false,
        }
    }

    pub fn as_bool(&self) -> bool {
        return match self {
            YamlValue::Bool(b) => *b,
            _ => false,
        }
    }

    pub fn as_int(&self) -> i64 {
        return match self {
            YamlValue::Int(n) => *n,
            _ => 0,
        }
    }

    pub fn as_float(&self) -> f64 {
        return match self {
            YamlValue::Float(f) => *f,
            YamlValue::Int(n) => *n as f64,
            _ => 0.0,
        }
    }

    pub fn as_string(&self) -> string {
        return match self {
            YamlValue::Str(s) => s.clone(),
            YamlValue::Bool(b) => format!("{}", b),
            YamlValue::Int(n) => format!("{}", n),
            YamlValue::Float(f) => format!("{}", f),
            YamlValue::Null => "~".into(),
            _ => "".into(),
        }
    }

    pub fn get(&self, key: string) -> Option<YamlValue> {
        return Option::None
    }

    pub fn get_index(&self, index: i64) -> Option<YamlValue> {
        return Option::None
    }

    pub fn length(&self) -> i64 {
        return match self {
            YamlValue::Seq(arr) => arr.len() as i64,
            YamlValue::Map(map) => map.len() as i64,
            _ => 0,
        }
    }
}

