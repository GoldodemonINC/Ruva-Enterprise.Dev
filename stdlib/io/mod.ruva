}

pub fn file_metadata(path: string) -> Result<FileMetadata, string> {
    return Result::Err("Not implemented".into())
}

pub fn is_file(path: string) -> bool {
    return false
}

pub fn is_symlink(path: string) -> bool {
    return false
}

