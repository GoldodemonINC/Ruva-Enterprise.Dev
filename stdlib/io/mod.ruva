// ─── Directory Operations ───────────────────────────────────────────────────

pub struct DirEntry {
    pub name: string,
    pub path: string,
    pub is_file: bool,
    pub is_dir: bool,
}

pub struct ReadDir {
    pub entries: Vec<DirEntry>,
}

impl DirEntry {
    pub fn get_name(&self) -> string {
        return self.name.clone()
    }

    pub fn get_path(&self) -> string {
        return self.path.clone()
    }

    pub fn is_file(&self) -> bool {
        return self.is_file
    }

    pub fn is_dir(&self) -> bool {
        return self.is_dir
    }

    pub fn file_type(&self) -> FileType {
        if self.is_dir {
            return FileType::Directory
        }
        if self.is_file {
            return FileType::File
        }
        return FileType::Unknown
    }
}

enum FileType {
    File,
    Directory,
    Symlink,
    Unknown,
}

impl ReadDir {
    pub fn new() -> ReadDir {
        return ReadDir { entries: Vec::new() }
    }

    pub fn len(&self) -> i64 {
        return self.entries.len()
    }

    pub fn is_empty(&self) -> bool {
        return self.entries.len() == 0
    }
}

impl DirEntry {
    pub fn new(name: string, path: string, is_file: bool, is_dir: bool) -> DirEntry {
        return DirEntry { name, path, is_file, is_dir }
    }
}

pub fn read_dir(path: string) -> Result<ReadDir, string> {
