// ─── Process / Environment (stubs) ──────────────────────────────────────────

pub struct Command {
    pub program: string,
    pub args: Vec<string>,
    pub env_vars: Vec<Pair>,
}

pub struct Pair {
    pub key: string,
    pub value: string,
}

pub struct Output {
    pub status: i32,
    pub stdout: string,
    pub stderr: string,
}

impl Command {
    pub fn new(program: string) -> Command {
        return Command {
            program,
            args: Vec::new(),
            env_vars: Vec::new(),
        }
    }

    pub fn arg(&mut self, arg: string) {
        self.args.push(arg)
    }

    pub fn args(&mut self, new_args: Vec<string>) {
        self.args = new_args
    }

    pub fn env(&mut self, key: string, value: string) {
        let pair = Pair { key, value }
        self.env_vars.push(pair)
    }

    pub fn output(&self) -> Result<Output, string> {
        return Result::Err("Not implemented".into())
    }

    pub fn status(&self) -> Result<i32, string> {
        return Result::Err("Not implemented".into())
    }

    pub fn spawn(&self) -> Result<ChildProcess, string> {
        return Result::Err("Not implemented".into())
    }
}

pub struct ChildProcess {
    pub id: u32,
}

impl ChildProcess {
    pub fn wait(&self) -> Result<i32, string> {
        return Result::Err("Not implemented".into())
    }

    pub fn kill(&self) -> Result<(), string> {
        return Result::Err("Not implemented".into())
    }

    pub fn get_id(&self) -> u32 {
        return self.id
    }
}

pub fn run_command(program: string) -> Result<Output, string> {
    let cmd = Command::new(program)
    return cmd.output()
}

pub fn run_command_with_args(program: string, args: Vec<string>) -> Result<Output, string> {
    let mut cmd = Command::new(program)
    cmd.args(args)
    return cmd.output()
}

pub fn env_var(key: string) -> Option<string> {
    return Option::None
}

pub fn env_var_or(key: string, default: string) -> string {
    return default
}

pub fn set_env_var(key: string, value: string) -> Result<(), string> {
    return Result::Err("Not implemented".into())
}

pub fn remove_env_var(key: string) -> Result<(), string> {
    return Result::Err("Not implemented".into())
}

pub fn env_vars() -> Vec<Pair> {
