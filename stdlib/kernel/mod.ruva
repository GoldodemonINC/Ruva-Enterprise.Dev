// ─── File System (Minimal FAT12/FAT16) ─────────────────────────────────

struct FatEntry {
    pub name: [u8; 11],
    pub attributes: u8,
    pub cluster: u16,
    pub size: u32,
}

struct FileSystem {
    pub disk: AtaDisk,
    pub fat_start: u64,
    pub data_start: u64,
    pub sectors_per_cluster: u8,
    pub root_dir_entries: u16,
}

impl FileSystem {
    pub fn new(disk: AtaDisk) -> Self {
        return Self {
            disk,
            fat_start: 0,
            data_start: 0,
            sectors_per_cluster: 0,
            root_dir_entries: 0,
        }
    }

    pub fn mount(&mut self) -> bool {
        let mut buf = [0u8; 512]
        if !self.disk.read_sector(0, &mut buf) {
            return false
        }
        // Parse BPB (BIOS Parameter Block)
        self.sectors_per_cluster = buf[13]
        let reserved_sectors = (buf[14] as u16) | ((buf[15] as u16) << 8)
        let num_fats = buf[16]
        self.root_dir_entries = (buf[17] as u16) | ((buf[18] as u16) << 8)
        let total_sectors = (buf[19] as u16) | ((buf[20] as u16) << 8)
        let sectors_per_fat = (buf[22] as u16) | ((buf[23] as u16) << 8)

        self.fat_start = reserved_sectors as u64
        let root_dir_sectors = ((self.root_dir_entries * 32 + 511) / 512) as u64
        self.data_start = self.fat_start + (num_fats as u64) * (sectors_per_fat as u64) + root_dir_sectors

        return total_sectors > 0
    }

    pub fn read_file(&self, _name: string, _buf: &mut [u8]) -> i64 {
        // Read directory entry, follow FAT chain, read clusters
        return -1  // Not implemented yet
    }
}

// ─── Boot Protocol ──────────────────────────────────────────────────────

struct MultibootInfo {
    pub flags: u32,
    pub mem_lower: u32,
    pub mem_upper: u32,
    pub boot_device: u32,
    pub cmdline: u32,
    pub mods_count: u32,
    pub mods_addr: u32,
    pub mmap_length: u32,
    pub mmap_addr: u32,
}

impl MultibootInfo {
    pub fn from_address(addr: u64) -> Self {
        // Read multiboot info from memory
        return Self {
            flags: 0,
            mem_lower: 0,
            mem_upper: 0,
            boot_device: 0,
            cmdline: 0,
            mods_count: 0,
            mods_addr: 0,
            mmap_length: 0,
            mmap_addr: 0,
        }
    }

    pub fn total_memory(&self) -> u64 {
        return (self.mem_upper as u64) * 1024 + 1024 * 1024  // Upper memory + 1MB
    }

    pub fn has_memory_map(&self) -> bool {
        return self.flags & (1 << 6) != 0
    }
}

// ─── Kernel Entry Point ────────────────────────────────────────────────

struct Kernel {
    pub allocator: PhysicalAllocator,
    pub heap: KernelHeap,
    pub interrupts: InterruptController,
    pub timer: Timer,
    pub vga: VgaBuffer,
    pub serial: SerialPort,
    pub keyboard: Keyboard,
    pub scheduler: Scheduler,
    pub drivers: DriverRegistry,
    pub syscall_handler: SyscallHandler,
    pub boot_info: MultibootInfo,
    pub uptime_ms: u64,
}

impl Kernel {
    pub fn new() -> Self {
        return Self {
            allocator: PhysicalAllocator::new(0, MAX_MEMORY),
            heap: KernelHeap::new(),
            interrupts: InterruptController::new(),
            timer: Timer::new(100),  // 100 Hz
            vga: VgaBuffer::new(),
            serial: SerialPort::new(SerialPort::COM1),
            keyboard: Keyboard::new(),
            scheduler: Scheduler::new(),
            drivers: DriverRegistry::new(),
            syscall_handler: SyscallHandler::new(),
            boot_info: MultibootInfo::from_address(0),
            uptime_ms: 0,
        }
    }

    pub fn boot(&mut self) {
        // Phase 1: Hardware init (< 10ms target)
        self.serial.init()
        self.serial.send_string("[BOOT] Serial OK\n")

        self.vga.clear()
        self.vga.set_color(VgaColor::LightGreen, VgaColor::Black)
        self.vga.write_string("Ruva OS v0.1.0\n")
        self.vga.set_color(VgaColor::LightGray, VgaColor::Black)

        // Phase 2: Memory init (< 5ms)
        self.interrupts.init_pic()
        self.serial.send_string("[BOOT] PIC initialized\n")

        // Phase 3: Timer (< 1ms)
        self.timer.configure_pit(100)  // 100 Hz
        self.serial.send_string("[BOOT] PIT configured\n")

        // Phase 4: IDT (< 1ms)
        self.idt.load()
        self.serial.send_string("[BOOT] IDT loaded\n")

        // Phase 5: Enable interrupts
        // sti instruction
        self.serial.send_string("[BOOT] Interrupts enabled\n")

        self.serial.send_string("[BOOT] Kernel ready\n")
        self.vga.write_string("Boot complete.\n")
    }

    pub fn halt(&self) {
        loop {
            // hlt instruction — wait for interrupt
        }
    }
}

// ─── Entry Point ────────────────────────────────────────────────────────

fn kernel_main(multiboot_magic: u64, multiboot_info: u64) {
    let mut kernel = Kernel::new()
    kernel.boot()
    kernel.halt()
}
