// ─── Ruva Standard Library — Kernel Module ──────────────────────────────
// Bare-metal OS development primitives.
// Designed for: low RAM usage, fast boot, minimal overhead.
//
// Features:
//   - Physical/virtual memory management
//   - Interrupt Descriptor Table (IDT)
//   - System call interface
//   - Driver abstractions (VGA, serial, keyboard, timer, disk)
//   - Boot protocols (Multiboot2, UEFI)
//   - Process/thread primitives
//   - Synchronization (spinlocks, mutexes, semaphores)

import std::io

// ─── Constants ──────────────────────────────────────────────────────────

const PAGE_SIZE: u64 = 4096
const KERNEL_BASE: u64 = 0xFFFFFFFF80000000
const MAX_MEMORY: u64 = 128 * 1024 * 1024  // 128 MB — low RAM target
const STACK_SIZE: u64 = 16384  // 16 KB per thread — minimal
const MAX_INTERRUPTS: u64 = 256
const MAX_DRIVERS: u64 = 64
const MAX_PROCESSES: u64 = 128
const MAX_THREADS: u64 = 512

// ─── Memory ─────────────────────────────────────────────────────────────

pub struct PhysicalAddress {
    pub addr: u64,
}

impl PhysicalAddress {
    pub fn new(addr: u64) -> Self {
        return Self { addr }
    }

    pub fn offset(&self, off: u64) -> PhysicalAddress {
        return PhysicalAddress::new(self.addr + off)
    }

    pub fn page_align_down(&self) -> PhysicalAddress {
        return PhysicalAddress::new(self.addr & !(PAGE_SIZE - 1))
    }

    pub fn page_align_up(&self) -> PhysicalAddress {
        return PhysicalAddress::new((self.addr + PAGE_SIZE - 1) & !(PAGE_SIZE - 1))
    }

    pub fn page_number(&self) -> u64 {
        return self.addr / PAGE_SIZE
    }

    pub fn is_null(&self) -> bool {
        return self.addr == 0
    }
}

pub struct VirtualAddress {
    pub addr: u64,
}

impl VirtualAddress {
    pub fn new(addr: u64) -> Self {
        return Self { addr }
    }

    pub fn to_physical(&self) -> PhysicalAddress {
        // Identity mapping for lower half
        if self.addr < KERNEL_BASE {
            return PhysicalAddress::new(self.addr)
        }
        return PhysicalAddress::new(self.addr - KERNEL_BASE)
    }

    pub fn is_kernel(&self) -> bool {
        return self.addr >= KERNEL_BASE
    }

    pub fn page_offset(&self) -> u64 {
        return self.addr & (PAGE_SIZE - 1)
    }
}

// ─── Page Table ─────────────────────────────────────────────────────────

enum PageEntryFlags {
    Present
    Writable
    UserAccessible
    WriteThrough
    CacheDisabled
    Accessed
    Dirty
    PageSize
    Global
}

struct PageTableEntry {
    pub value: u64,
}

impl PageTableEntry {
    pub fn new() -> Self {
        return Self { value: 0 }
    }

    pub fn is_present(&self) -> bool {
        return self.value & 1 == 1
    }

    pub fn is_writable(&self) -> bool {
        return self.value & 2 == 2
    }

    pub fn physical_address(&self) -> PhysicalAddress {
        return PhysicalAddress::new(self.value & 0x000FFFFFFFFFF000)
    }

    pub fn set_physical_address(&mut self, addr: PhysicalAddress) {
        self.value = (self.value & !0x000FFFFFFFFFF000) | addr.addr
    }

    pub fn set_flags(&mut self, flags: u64) {
        self.value = self.value | flags
    }

    pub fn clear_flags(&mut self, flags: u64) {
        self.value = self.value & !flags
    }
}

struct PageTable {
    entries: [PageTableEntry; 512],
}

impl PageTable {
    pub fn new() -> Self {
        return Self {
            entries: [PageTableEntry::new(); 512],
        }
    }

    pub fn map_page(&mut self, virtual_addr: VirtualAddress, physical_addr: PhysicalAddress, flags: u64) {
        let idx = (virtual_addr.addr >> 12) & 0x1FF
        self.entries[idx as usize].set_physical_address(physical_addr)
        self.entries[idx as usize].set_flags(flags | 1)  // Present
    }

    pub fn unmap_page(&mut self, virtual_addr: VirtualAddress) {
        let idx = (virtual_addr.addr >> 12) & 0x1FF
        self.entries[idx as usize].value = 0
    }

    pub fn translate(&self, virtual_addr: VirtualAddress) -> Option<PhysicalAddress> {
        let idx = (virtual_addr.addr >> 12) & 0x1FF
        let entry = &self.entries[idx as usize]
        if entry.is_present() {
            return Option::Some(entry.physical_address())
        }
        return Option::None
    }
}

// ─── Physical Memory Manager (Bitmap Allocator) ────────────────────────

struct PhysicalAllocator {
    bitmap: *mut u8,
    total_pages: u64,
    used_pages: u64,
    bitmap_size: u64,
}

impl PhysicalAllocator {
    pub fn new(bitmap_addr: u64, total_memory: u64) -> Self {
        let total_pages = total_memory / PAGE_SIZE
        let bitmap_size = (total_pages + 7) / 8  // bits to bytes

        return Self {
            bitmap: bitmap_addr as *mut u8,
            total_pages,
            used_pages: 0,
            bitmap_size,
        }
    }

    pub fn allocate_page(&mut self) -> Option<PhysicalAddress> {
        // Find first free page in bitmap
        let mut byte_idx: u64 = 0
        while byte_idx < self.bitmap_size {
            let byte = unsafe { *self.bitmap.offset(byte_idx as isize) }
            if byte != 0xFF {  // Has at least one free bit
                let mut bit: u8 = 0
                while bit < 8 {
                    if byte & (1 << bit) == 0 {
                        // Found free page
                        let page_num = byte_idx * 8 + bit as u64
                        if page_num < self.total_pages {
                            // Mark as used
                            unsafe {
                                *self.bitmap.offset(byte_idx as isize) |= 1 << bit
                            }
                            self.used_pages += 1
                            return Option::Some(PhysicalAddress::new(page_num * PAGE_SIZE))
                        }
                    }
                    bit += 1
                }
            }
            byte_idx += 1
        }
        return Option::None  // Out of memory
    }

    pub fn free_page(&mut self, addr: PhysicalAddress) {
        let page_num = addr.page_number()
        let byte_idx = page_num / 8
        let bit = page_num % 8

        if byte_idx < self.bitmap_size {
            unsafe {
                *self.bitmap.offset(byte_idx as isize) &= !(1 << bit)
            }
            self.used_pages -= 1
        }
    }

    pub fn allocate_pages(&mut self, count: u64) -> Option<PhysicalAddress> {
        // Simple contiguous allocation
        let mut consecutive: u64 = 0
        let mut start_page: u64 = 0
        let mut byte_idx: u64 = 0

        while byte_idx < self.bitmap_size && consecutive < count {
            let byte = unsafe { *self.bitmap.offset(byte_idx as isize) }
            let mut bit: u8 = 0
            while bit < 8 && consecutive < count {
                if byte & (1 << bit) == 0 {
                    if consecutive == 0 {
                        start_page = byte_idx * 8 + bit as u64
                    }
                    consecutive += 1
                } else {
                    consecutive = 0
                }
                bit += 1
            }
            byte_idx += 1
        }

        if consecutive >= count {
            // Mark all pages as used
            let mut i: u64 = 0
            while i < count {
                let page_num = start_page + i
                let b_idx = page_num / 8
                let b_bit = page_num % 8
                unsafe {
                    *self.bitmap.offset(b_idx as isize) |= 1 << b_bit
                }
                i += 1
            }
            self.used_pages += count
            return Option::Some(PhysicalAddress::new(start_page * PAGE_SIZE))
        }

        return Option::None
    }

    pub fn free_pages(&mut self, addr: PhysicalAddress, count: u64) {
        let mut i: u64 = 0
        while i < count {
            self.free_page(addr.offset(i * PAGE_SIZE))
            i += 1
        }
    }

    pub fn usage(&self) -> f64 {
        return (self.used_pages as f64) / (self.total_pages as f64)
    }

    pub fn free_bytes(&self) -> u64 {
        return (self.total_pages - self.used_pages) * PAGE_SIZE
    }
}

// ─── Kernel Heap (Slab Allocator) ──────────────────────────────────────

struct Slab {
    block_size: u64,
    blocks_per_slab: u64,
    free_list: *mut u8,
    next: *mut Slab,
}

struct KernelHeap {
    slab_16: *mut Slab,
    slab_32: *mut Slab,
    slab_64: *mut Slab,
    slab_128: *mut Slab,
    slab_256: *mut Slab,
    slab_512: *mut Slab,
    slab_1024: *mut Slab,
    large_allocs: *mut LargeAlloc,
    total_allocated: u64,
    peak_allocated: u64,
}

struct LargeAlloc {
    size: u64,
    next: *mut LargeAlloc,
}

impl KernelHeap {
    pub fn new() -> Self {
        return Self {
            slab_16: core::ptr::null_mut(),
            slab_32: core::ptr::null_mut(),
            slab_64: core::ptr::null_mut(),
            slab_128: core::ptr::null_mut(),
            slab_256: core::ptr::null_mut(),
            slab_512: core::ptr::null_mut(),
            slab_1024: core::ptr::null_mut(),
            large_allocs: core::ptr::null_mut(),
            total_allocated: 0,
            peak_allocated: 0,
        }
    }

    pub fn alloc(&mut self, size: u64, align: u64) -> *mut u8 {
        // Round up to slab size
        let actual_size = if size <= 16 { 16 }
            else if size <= 32 { 32 }
            else if size <= 64 { 64 }
            else if size <= 128 { 128 }
            else if size <= 256 { 256 }
            else if size <= 512 { 512 }
            else if size <= 1024 { 1024 }
            else { size }

        self.total_allocated += actual_size
        if self.total_allocated > self.peak_allocated {
            self.peak_allocated = self.total_allocated
        }

        // For now, return a placeholder — real implementation needs page allocator integration
        return core::ptr::null_mut()
    }

    pub fn free(&mut self, ptr: *mut u8, size: u64) {
        if !ptr.is_null() {
            self.total_allocated -= size
        }
    }

    pub fn stats(&self) -> HeapStats {
        return HeapStats {
            total_allocated: self.total_allocated,
            peak_allocated: self.peak_allocated,
            slab_count: 7,  // 7 slab sizes
        }
    }
}

struct HeapStats {
    pub total_allocated: u64,
    pub peak_allocated: u64,
    pub slab_count: u64,
}

// ─── Interrupts ─────────────────────────────────────────────────────────

struct InterruptFrame {
    pub rip: u64,
    pub cs: u64,
    pub rflags: u64,
    pub rsp: u64,
    pub ss: u64,
}

struct InterruptDescriptor {
    pub base_low: u16,
    pub selector: u16,
    pub ist: u8,
    pub type_attr: u8,
    pub base_mid: u16,
    pub base_high: u32,
    pub reserved: u32,
}

impl InterruptDescriptor {
    pub fn new() -> Self {
        return Self {
            base_low: 0,
            selector: 0,
            ist: 0,
            type_attr: 0,
            base_mid: 0,
            base_high: 0,
            reserved: 0,
        }
    }

    pub fn set_handler(&mut self, handler: u64) {
        self.base_low = (handler & 0xFFFF) as u16
        self.base_mid = ((handler >> 16) & 0xFFFF) as u16
        self.base_high = ((handler >> 32) & 0xFFFFFFFF) as u32
    }

    pub fn set_present(&mut self, present: bool) {
        if present {
            self.type_attr |= 0x80
        } else {
            self.type_attr &= !0x80
        }
    }

    pub fn set_dpl(&mut self, dpl: u8) {
        self.type_attr = (self.type_attr & !0x60) | ((dpl & 3) << 5)
    }

    pub fn set_type(&mut self, type_val: u8) {
        self.type_attr = (self.type_attr & !0x0F) | (type_val & 0x0F)
    }
}

struct Idt {
    descriptors: [InterruptDescriptor; 256],
    limit: u16,
    base: u64,
}

impl Idt {
    pub fn new() -> Self {
        return Self {
            descriptors: [InterruptDescriptor::new(); 256],
            limit: (256 * 16 - 1) as u16,
            base: 0,
        }
    }

    pub fn set_gate(&mut self, index: u64, handler: u64, selector: u16, dpl: u8) {
        if index < 256 {
            self.descriptors[index as usize].set_handler(handler)
            self.descriptors[index as usize].selector = selector
            self.descriptors[index as usize].set_dpl(dpl)
            self.descriptors[index as usize].set_type(0xE)  // Interrupt gate
            self.descriptors[index as usize].set_present(true)
        }
    }

    pub fn load(&self) {
        // lidt instruction — transpiled to asm
        // unsafe { asm!("lidt [{}]", in(reg) &self as *const Self as u64) }
    }
}

// ─── Interrupt Handler Table ────────────────────────────────────────────

type InterruptHandler = fn(&InterruptFrame)

struct InterruptController {
    handlers: [InterruptHandler; 256],
    idt: Idt,
   pic_mask: u16,
}

impl InterruptController {
    pub fn new() -> Self {
        return Self {
            handlers: [default_handler; 256],
            idt: Idt::new(),
            pic_mask: 0xFFFF,  // All masked initially
        }
    }

    pub fn register(&mut self, vector: u64, handler: InterruptHandler) {
        if vector < 256 {
            self.handlers[vector as usize] = handler
        }
    }

    pub fn unregister(&mut self, vector: u64) {
        if vector < 256 {
            self.handlers[vector as usize] = default_handler
        }
    }

    pub fn enable_irq(&mut self, irq: u8) {
        self.pic_mask &= !(1 << irq)
        self.send_pic_mask()
    }

    pub fn disable_irq(&mut self, irq: u8) {
        self.pic_mask |= 1 << irq
        self.send_pic_mask()
    }

    fn send_pic_mask(&self) {
        // outb(0x21, pic_mask as u8)
        // outb(0xA1, (pic_mask >> 8) as u8)
    }

    pub fn init_pic(&mut self) {
        // ICW1: begin initialization
        // outb(0x20, 0x11)
        // outb(0xA0, 0x11)
        // ICW2: vector offset
        // outb(0x21, 0x20)  // Master PIC IRQ 0-7 → INT 0x20-0x27
        // outb(0xA1, 0x28)  // Slave PIC IRQ 8-15 → INT 0x28-0x2F
        // ICW3: cascade
        // outb(0x21, 0x04)
        // outb(0xA1, 0x02)
        // ICW4: 8086 mode
        // outb(0x21, 0x01)
        // outb(0xA1, 0x01)
        // Mask all IRQs
        self.pic_mask = 0xFFFF
        self.send_pic_mask()
    }

    pub fn acknowledge(&self, irq: u8) {
        if irq >= 8 {
            // outb(0xA0, 0x20)  // EOI to slave
        }
        // outb(0x20, 0x20)  // EOI to master
    }
}

fn default_handler(_frame: &InterruptFrame) {
    // Default interrupt handler — do nothing
}

// ─── Timer ──────────────────────────────────────────────────────────────

struct Timer {
    pub frequency: u64,
    pub ticks: u64,
    pub elapsed_ms: u64,
}

impl Timer {
    pub fn new(frequency: u64) -> Self {
        return Self {
            frequency,
            ticks: 0,
            elapsed_ms: 0,
        }
    }

    pub fn tick(&mut self) {
        self.ticks += 1
        self.elapsed_ms = self.ticks * 1000 / self.frequency
    }

    pub fn reset(&mut self) {
        self.ticks = 0
        self.elapsed_ms = 0
    }

    pub fn sleep_ms(&self, ms: u64) {
        let target = self.elapsed_ms + ms
        // Spin-wait (for early boot before scheduler)
        while self.elapsed_ms < target {
            // pause instruction
        }
    }

    pub fn configure_pit(&self, frequency: u64) {
        // PIT Channel 0 — Mode 3 (square wave)
        let divisor = 1193182 / frequency
        // outb(0x43, 0x36)
        // outb(0x40, (divisor & 0xFF) as u8)
        // outb(0x40, ((divisor >> 8) & 0xFF) as u8)
    }
}

// ─── Serial Port (Debug Output) ────────────────────────────────────────

struct SerialPort {
    pub base: u16,
}

impl SerialPort {
    pub const COM1: u16 = 0x3F8
    pub const COM2: u16 = 0x2F8

    pub fn new(base: u16) -> Self {
        return Self { base }
    }

    pub fn init(&self) {
        // Disable interrupts
        // outb(self.base + 1, 0x00)
        // Enable DLAB
        // outb(self.base + 3, 0x80)
        // Set baud rate divisor (115200 / 9600 = 12)
        // outb(self.base + 0, 0x0C)
        // outb(self.base + 1, 0x00)
        // 8 bits, no parity, one stop bit
        // outb(self.base + 3, 0x03)
        // Enable FIFO
        // outb(self.base + 2, 0xC7)
        // Enable IRQs, RTS/DSR set
        // outb(self.base + 4, 0x0B)
    }

    pub fn is_transmit_empty(&self) -> bool {
        // inb(self.base + 5) & 0x20 != 0
        return true
    }

    pub fn send_byte(&self, byte: u8) {
        while !self.is_transmit_empty() {}
        // outb(self.base, byte)
    }

    pub fn send_string(&self, s: string) {
        for byte in s.bytes() {
            if byte == b'\n' {
                self.send_byte(b'\r')
            }
            self.send_byte(byte)
        }
    }

    pub fn receive_byte(&self) -> Option<u8> {
        // if inb(self.base + 5) & 1 != 0 {
        //     return Option::Some(inb(self.base))
        // }
        return Option::None
    }
}

// ─── VGA Text Mode ─────────────────────────────────────────────────────

enum VgaColor {
    Black = 0
    Blue = 1
    Green = 2
    Cyan = 3
    Red = 4
    Magenta = 5
    Brown = 6
    LightGray = 7
    DarkGray = 8
    LightBlue = 9
    LightGreen = 10
    LightCyan = 11
    LightRed = 12
    Pink = 13
    Yellow = 14
    White = 15
}

struct VgaBuffer {
    chars: [VgaChar; 80 * 25],
    cursor_x: u8,
    cursor_y: u8,
    attribute: u8,
}

struct VgaChar {
    char: u8,
    attribute: u8,
}

impl VgaBuffer {
    pub fn new() -> Self {
        return Self {
            chars: [VgaChar { char: b' ', attribute: 0x07 }; 80 * 25],
            cursor_x: 0,
            cursor_y: 0,
            attribute: 0x07,  // Light gray on black
        }
    }

    pub fn set_color(&mut self, fg: VgaColor, bg: VgaColor) {
        self.attribute = (bg as u8) << 4 | (fg as u8)
    }

    pub fn write_char(&mut self, ch: u8) {
        if ch == b'\n' {
            self.cursor_x = 0
            self.cursor_y += 1
        } else if ch == b'\r' {
            self.cursor_x = 0
        } else if ch == b'\x08' {  // Backspace
            if self.cursor_x > 0 {
                self.cursor_x -= 1
                let idx = (self.cursor_y as usize) * 80 + (self.cursor_x as usize)
                self.chars[idx] = VgaChar { char: b' ', attribute: self.attribute }
            }
        } else {
            let idx = (self.cursor_y as usize) * 80 + (self.cursor_x as usize)
            if idx < 80 * 25 {
                self.chars[idx] = VgaChar { char: ch, attribute: self.attribute }
            }
            self.cursor_x += 1
        }

        if self.cursor_x >= 80 {
            self.cursor_x = 0
            self.cursor_y += 1
        }

        if self.cursor_y >= 25 {
            self.scroll()
            self.cursor_y = 24
        }
    }

    pub fn write_string(&mut self, s: string) {
        for byte in s.bytes() {
            self.write_char(byte)
        }
    }

    pub fn clear(&mut self) {
        self.chars = [VgaChar { char: b' ', attribute: self.attribute }; 80 * 25]
        self.cursor_x = 0
        self.cursor_y = 0
    }

    fn scroll(&mut self) {
        // Move all lines up by one
        let mut y: usize = 0
        while y < 24 {
            let mut x: usize = 0
            while x < 80 {
                let src = (y + 1) * 80 + x
                let dst = y * 80 + x
                self.chars[dst] = self.chars[src]
                x += 1
            }
            y += 1
        }
        // Clear last line
        let mut x: usize = 0
        while x < 80 {
            self.chars[24 * 80 + x] = VgaChar { char: b' ', attribute: self.attribute }
            x += 1
        }
    }

    pub fn update_cursor(&self) {
        let pos = (self.cursor_y as u16) * 80 + (self.cursor_x as u16)
        // outb(0x3D4, 0x0F)
        // outb(0x3D5, (pos & 0xFF) as u8)
        // outb(0x3D4, 0x0E)
        // outb(0x3D5, ((pos >> 8) & 0xFF) as u8)
    }
}

// ─── Keyboard (PS/2) ───────────────────────────────────────────────────

struct Keyboard {
    pub buffer: [u8; 256],
    pub head: u8,
    pub tail: u8,
    pub shift: bool,
    pub ctrl: bool,
    pub alt: bool,
}

impl Keyboard {
    pub fn new() -> Self {
        return Self {
            buffer: [0; 256],
            head: 0,
            tail: 0,
            shift: false,
            ctrl: false,
            alt: false,
        }
    }

    pub fn process_scancode(&mut self, scancode: u8) {
        match scancode {
            0x2A | 0x36 => self.shift = true,    // Left/Right Shift press
            0xAA | 0xB6 => self.shift = false,   // Shift release
            0x1D => self.ctrl = true,              // Ctrl press
            0x9D => self.ctrl = false,             // Ctrl release
            0x38 => self.alt = true,               // Alt press
            0xB8 => self.alt = false,              // Alt release
            0x0E => self.push(b'\x08'),            // Backspace
            0x1C => self.push(b'\n'),              // Enter
            _ => {
                if scancode < 0x80 {
                    let ch = self.scancode_to_ascii(scancode)
                    if ch != 0 {
                        self.push(ch)
                    }
                }
            }
        }
    }

    fn scancode_to_ascii(&self, scancode: u8) -> u8 {
        let normal = match scancode {
            0x02 => b'1', 0x03 => b'2', 0x04 => b'3', 0x05 => b'4',
            0x06 => b'5', 0x07 => b'6', 0x08 => b'7', 0x09 => b'8',
            0x0A => b'9', 0x0B => b'0',
            0x10 => b'q', 0x11 => b'w', 0x12 => b'e', 0x13 => b'r',
            0x14 => b't', 0x15 => b'y', 0x16 => b'u', 0x17 => b'i',
            0x18 => b'o', 0x19 => b'p',
            0x1E => b'a', 0x1F => b's', 0x20 => b'd', 0x21 => b'f',
            0x22 => b'g', 0x23 => b'h', 0x24 => b'j', 0x25 => b'k',
            0x26 => b'l',
            0x2C => b'z', 0x2D => b'x', 0x2E => b'c', 0x2F => b'v',
            0x30 => b'b', 0x31 => b'n', 0x32 => b'm',
            0x39 => b' ',
            _ => 0,
        }

        if self.shift {
            match normal {
                b'a'..=b'z' => normal - 32,  // Uppercase
                b'1' => b'!', b'2' => b'@', b'3' => b'#', b'4' => b'$',
                b'5' => b'%', b'6' => b'^', b'7' => b'&', b'8' => b'*',
                b'9' => b'(', b'0' => b')',
                _ => normal,
            }
        } else {
            normal
        }
    }

    fn push(&mut self, byte: u8) {
        self.buffer[self.tail as usize] = byte
        self.tail = (self.tail + 1) & 0xFF
    }

    pub fn pop(&mut self) -> Option<u8> {
        if self.head != self.tail {
            let byte = self.buffer[self.head as usize]
            self.head = (self.head + 1) & 0xFF
            return Option::Some(byte)
        }
        return Option::None
    }

    pub fn has_data(&self) -> bool {
        return self.head != self.tail
    }
}

// ─── Process / Thread Primitives ────────────────────────────────────────

enum ProcessState {
    Ready
    Running
    Blocked
    Zombie
}

struct Process {
    pub pid: u64,
    pub state: ProcessState,
    pub kernel_stack: u64,
    pub user_stack: u64,
    pub page_table: *mut PageTable,
    pub parent: Option<u64>,
    pub children: Vec<u64>,
    pub name: string,
}

impl Process {
    pub fn new(pid: u64, name: string, kernel_stack: u64) -> Self {
        return Self {
            pid,
            state: ProcessState::Ready,
            kernel_stack,
            user_stack: 0,
            page_table: core::ptr::null_mut(),
            parent: Option::None,
            children: Vec::new(),
            name,
        }
    }

    pub fn block(&mut self) {
        self.state = ProcessState::Blocked
    }

    pub fn ready(&mut self) {
        self.state = ProcessState::Ready
    }

    pub fn is_zombie(&self) -> bool {
        return match self.state {
            ProcessState::Zombie => true,
            _ => false,
        }
    }
}

struct Thread {
    pub tid: u64,
    pub process: u64,
    pub state: ProcessState,
    pub kernel_stack: u64,
    pub stack_pointer: u64,
    pub priority: u8,
}

impl Thread {
    pub fn new(tid: u64, process: u64, kernel_stack: u64) -> Self {
        return Self {
            tid,
            process,
            state: ProcessState::Ready,
            kernel_stack,
            stack_pointer: kernel_stack + STACK_SIZE,
            priority: 0,
        }
    }
}

// ─── Scheduler (Round-Robin) ───────────────────────────────────────────

struct Scheduler {
    threads: Vec<Thread>,
    current: Option<u64>,
    quantum: u64,
    tick_count: u64,
}

impl Scheduler {
    pub fn new() -> Self {
        return Self {
            threads: Vec::new(),
            current: Option::None,
            quantum: 10,  // 10 ticks per time slice
            tick_count: 0,
        }
    }

    pub fn add_thread(&mut self, thread: Thread) {
        self.threads.push(thread)
    }

    pub fn schedule(&mut self) -> Option<u64> {
        // Simple round-robin
        if self.threads.is_empty() {
            return Option::None
        }

        self.tick_count += 1
        if self.tick_count >= self.quantum {
            self.tick_count = 0
            // Move to next ready thread
            if let Option::Some(current) = self.current {
                let mut next = (current + 1) % self.threads.len() as u64
                while next != current {
                    if let Option::Some(t) = self.threads.get(next) {
                        if matches!(t.state, ProcessState::Ready) {
                            self.current = Option::Some(next)
                            return Option::Some(next)
                        }
                    }
                    next = (next + 1) % self.threads.len() as u64
                }
            }
        }
        return self.current
    }

    pub fn exit_current(&mut self) {
        if let Option::Some(current) = self.current {
            if let Option::Some(thread) = self.threads.get_mut(current) {
                thread.state = ProcessState::Zombie
            }
        }
        self.current = Option::None
    }
}

// ─── Synchronization Primitives ─────────────────────────────────────────

struct SpinLock {
    pub locked: bool,
}

impl SpinLock {
    pub fn new() -> Self {
        return Self { locked: false }
    }

    pub fn acquire(&mut self) {
        while self.locked {
            // pause instruction — yield CPU hint
        }
        self.locked = true
    }

    pub fn try_acquire(&mut self) -> bool {
        if !self.locked {
            self.locked = true
            return true
        }
        return false
    }

    pub fn release(&mut self) {
        self.locked = false
    }
}

struct Mutex {
    pub lock: SpinLock,
    pub waiters: Vec<u64>,
}

impl Mutex {
    pub fn new() -> Self {
        return Self {
            lock: SpinLock::new(),
            waiters: Vec::new(),
        }
    }

    pub fn lock(&mut self) {
        self.lock.acquire()
    }

    pub fn unlock(&mut self) {
        self.lock.release()
    }
}

struct Semaphore {
    pub count: i64,
    pub max: i64,
    pub lock: SpinLock,
}

impl Semaphore {
    pub fn new(initial: i64, max: i64) -> Self {
        return Self {
            count: initial,
            max,
            lock: SpinLock::new(),
        }
    }

    pub fn wait(&mut self) {
        self.lock.acquire()
        while self.count <= 0 {
            self.lock.release()
            // Yield / block
            self.lock.acquire()
        }
        self.count -= 1
        self.lock.release()
    }

    pub fn signal(&mut self) {
        self.lock.acquire()
        if self.count < self.max {
            self.count += 1
        }
        self.lock.release()
    }

    pub fn try_wait(&mut self) -> bool {
        self.lock.acquire()
        if self.count > 0 {
            self.count -= 1
            self.lock.release()
            return true
        }
        self.lock.release()
        return false
    }
}

// ─── Syscall Interface ──────────────────────────────────────────────────

enum SyscallNumber {
    Exit = 0
    Fork = 1
    Read = 2
    Write = 3
    Open = 4
    Close = 5
    Sleep = 6
    GetPid = 7
    Mmap = 8
    Munmap = 9
    Ioctl = 10
    Spawn = 11
    Wait = 12
    Kill = 13
    GetTime = 14
    Yield = 15
}

struct SyscallHandler {
    handlers: [fn(u64, u64, u64) -> i64; 16],
}

impl SyscallHandler {
    pub fn new() -> Self {
        return Self {
            handlers: [
                sys_exit, sys_fork, sys_read, sys_write,
                sys_open, sys_close, sys_sleep, sys_getpid,
                sys_mmap, sys_munmap, sys_ioctl, sys_spawn,
                sys_wait, sys_kill, sys_gettime, sys_yield,
            ],
        }
    }

    pub fn dispatch(&self, number: u64, arg1: u64, arg2: u64, arg3: u64) -> i64 {
        if number < 16 {
            return (self.handlers[number as usize])(arg1, arg2, arg3)
        }
        return -1  // Unknown syscall
    }
}

fn sys_exit(_a1: u64, _a2: u64, _a3: u64) -> i64 { 0 }
fn sys_fork(_a1: u64, _a2: u64, _a3: u64) -> i64 { 0 }
fn sys_read(_a1: u64, _a2: u64, _a3: u64) -> i64 { 0 }
fn sys_write(_a1: u64, _a2: u64, _a3: u64) -> i64 { 0 }
fn sys_open(_a1: u64, _a2: u64, _a3: u64) -> i64 { 0 }
fn sys_close(_a1: u64, _a2: u64, _a3: u64) -> i64 { 0 }
fn sys_sleep(_a1: u64, _a2: u64, _a3: u64) -> i64 { 0 }
fn sys_getpid(_a1: u64, _a2: u64, _a3: u64) -> i64 { 0 }
fn sys_mmap(_a1: u64, _a2: u64, _a3: u64) -> i64 { 0 }
fn sys_munmap(_a1: u64, _a2: u64, _a3: u64) -> i64 { 0 }
fn sys_ioctl(_a1: u64, _a2: u64, _a3: u64) -> i64 { 0 }
fn sys_spawn(_a1: u64, _a2: u64, _a3: u64) -> i64 { 0 }
fn sys_wait(_a1: u64, _a2: u64, _a3: u64) -> i64 { 0 }
fn sys_kill(_a1: u64, _a2: u64, _a3: u64) -> i64 { 0 }
fn sys_gettime(_a1: u64, _a2: u64, _a3: u64) -> i64 { 0 }
fn sys_yield(_a1: u64, _a2: u64, _a3: u64) -> i64 { 0 }

// ─── Driver Framework ──────────────────────────────────────────────────

trait Driver {
    fn init(&self) -> bool
    fn read(&self, buf: &mut [u8], offset: u64, size: u64) -> i64
    fn write(&self, buf: &[u8], offset: u64, size: u64) -> i64
    fn ioctl(&self, cmd: u64, arg: u64) -> i64
    fn shutdown(&self)
    fn name(&self) -> string
}

struct DriverRegistry {
    drivers: Vec<Box<dyn Driver>>,
    count: u64,
}

impl DriverRegistry {
    pub fn new() -> Self {
        return Self {
            drivers: Vec::new(),
            count: 0,
        }
    }

    pub fn register(&mut self, driver: Box<dyn Driver>) -> u64 {
        let id = self.count
        self.drivers.push(driver)
        self.count += 1
        return id
    }

    pub fn get(&self, id: u64) -> Option<&Box<dyn Driver>> {
        return self.drivers.get(id)
    }

    pub fn init_all(&self) -> bool {
        let mut success = true
        for driver in &self.drivers {
            if !driver.init() {
                success = false
            }
        }
        return success
    }
}

// ─── Disk (ATA PIO) ────────────────────────────────────────────────────

struct AtaDisk {
    pub base: u16,
    pub slave: bool,
}

impl AtaDisk {
