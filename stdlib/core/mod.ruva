// ─── Ruva Standard Library — Core Module ─────────────────────────────────
// Essential types, traits, and utility functions.
// Designed to transpile cleanly to Rust, Zig, and Python.

// ─── Option Type ─────────────────────────────────────────────────────────

enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    pub fn is_some(&self) -> bool {
        return match self {
            Option::Some(_) => true,
            Option::None => false,
        }
    }

    pub fn is_none(&self) -> bool {
        return !self.is_some()
    }

    pub fn unwrap(self) -> T {
        return match self {
            Option::Some(val) => val,
            Option::None => panic!("called unwrap on None"),
        }
    }

    pub fn unwrap_or(self, default: T) -> T {
        return match self {
            Option::Some(val) => val,
            Option::None => default,
        }
    }

    pub fn map<U>(self, f: fn(T) -> U) -> Option<U> {
        return match self {
            Option::Some(val) => Option::Some(f(val)),
            Option::None => Option::None,
        }
    }

    pub fn and_then<U>(self, f: fn(T) -> Option<U>) -> Option<U> {
        return match self {
            Option::Some(val) => f(val),
            Option::None => Option::None,
        }
    }

    pub fn expect(self, msg: string) -> T {
        return match self {
            Option::Some(val) => val,
            Option::None => panic!("{}", msg),
        }
    }

    pub fn unwrap_or_else(self, f: fn() -> T) -> T {
        return match self {
            Option::Some(val) => val,
            Option::None => f(),
        }
    }

    pub fn filter(self, predicate: fn(&T) -> bool) -> Option<T> {
        return match self {
            Option::Some(val) => {
                if predicate(&val) {
                    Option::Some(val)
                } else {
                    Option::None
                }
            },
            Option::None => Option::None,
        }
    }

    pub fn or(self, alt: Option<T>) -> Option<T> {
        return match self {
            Option::Some(val) => Option::Some(val),
            Option::None => alt,
        }
    }

    pub fn or_else(self, f: fn() -> Option<T>) -> Option<T> {
        return match self {
            Option::Some(val) => Option::Some(val),
            Option::None => f(),
        }
    }

    pub fn map_or<U>(self, default: U, f: fn(T) -> U) -> U {
        return match self {
            Option::Some(val) => f(val),
            Option::None => default,
        }
    }

    pub fn map_or_else<D, U>(self, default: fn() -> D, f: fn(T) -> D) -> D {
        return match self {
            Option::Some(val) => f(val),
            Option::None => default(),
        }
    }

    pub fn zip<U>(self, other: Option<U>) -> Option<Pair<T, U> > {
        return match self {
            Option::Some(a) => {
                match other {
                    Option::Some(b) => Option::Some(Pair::new(a, b)),
                    Option::None => Option::None,
                }
            },
            Option::None => Option::None,
        }
    }

    pub fn inspect(self, f: fn(&T) -> Unit) -> Option<T> {
        return match self {
            Option::Some(val) => {
                f(&val)
                Option::Some(val)
            },
            Option::None => Option::None,
        }
    }
}

// ─── Result Type ─────────────────────────────────────────────────────────

enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    pub fn is_ok(&self) -> bool {
        return match self {
            Result::Ok(_) => true,
            Result::Err(_) => false,
        }
    }

    pub fn is_err(&self) -> bool {
        return !self.is_ok()
    }

    pub fn unwrap(self) -> T {
        return match self {
            Result::Ok(val) => val,
            Result::Err(_) => panic!("called unwrap on Err"),
        }
    }

    pub fn unwrap_or(self, default: T) -> T {
        return match self {
            Result::Ok(val) => val,
            Result::Err(_) => default,
        }
    }

    pub fn map<U>(self, f: fn(T) -> U) -> Result<U, E> {
        return match self {
            Result::Ok(val) => Result::Ok(f(val)),
            Result::Err(e) => Result::Err(e),
        }
    }

    pub fn and_then<U>(self, f: fn(T) -> Result<U, E>) -> Result<U, E> {
        return match self {
            Result::Ok(val) => f(val),
            Result::Err(e) => Result::Err(e),
        }
    }

    pub fn map_err<F>(self, f: fn(E) -> F) -> Result<T, F> {
        return match self {
            Result::Ok(val) => Result::Ok(val),
            Result::Err(e) => Result::Err(f(e)),
        }
    }

    pub fn expect(self, msg: string) -> T {
        return match self {
            Result::Ok(val) => val,
            Result::Err(_) => panic!("{}", msg),
        }
    }

    pub fn unwrap_or_else(self, f: fn(E) -> T) -> T {
        return match self {
            Result::Ok(val) => val,
            Result::Err(e) => f(e),
        }
    }

    pub fn unwrap_err(self) -> E {
        return match self {
            Result::Ok(_) => panic!("called unwrap_err on Ok"),
            Result::Err(e) => e,
        }
    }

    pub fn expect_err(self, msg: string) -> E {
        return match self {
            Result::Ok(_) => panic!("{}", msg),
            Result::Err(e) => e,
        }
    }

    pub fn or(self, alt: Result<T, E>) -> Result<T, E> {
        return match self {
            Result::Ok(val) => Result::Ok(val),
            Result::Err(_) => alt,
        }
    }

    pub fn or_else<F>(self, f: fn(E) -> Result<T, F>) -> Result<T, F> {
        return match self {
            Result::Ok(val) => Result::Ok(val),
            Result::Err(e) => f(e),
        }
    }

    pub fn and(self, other: Result<T, E>) -> Result<T, E> {
        return match self {
            Result::Ok(_) => other,
            Result::Err(e) => Result::Err(e),
        }
    }

    pub fn inspect(self, f: fn(&T) -> Unit) -> Result<T, E> {
        return match self {
            Result::Ok(val) => {
                f(&val)
                Result::Ok(val)
            },
            Result::Err(e) => Result::Err(e),
        }
    }

    pub fn inspect_err(self, f: fn(&E) -> Unit) -> Result<T, E> {
        return match self {
            Result::Ok(val) => Result::Ok(val),
            Result::Err(e) => {
                f(&e)
                Result::Err(e)
            },
        }
    }

    pub fn map_or<U>(self, default: U, f: fn(T) -> U) -> U {
        return match self {
            Result::Ok(val) => f(val),
            Result::Err(_) => default,
        }
    }

    pub fn map_or_else<D>(self, default: fn(E) -> D, f: fn(T) -> D) -> D {
        return match self {
            Result::Ok(val) => f(val),
            Result::Err(e) => default(e),
        }
    }

}

// ─── Conversion helpers ──────────────────────────────────────────────────

fn option_from_bool(val: bool) -> Option<bool> {
    return if val { Option::Some(true) } else { Option::None }
}

fn result_from_option<T>(opt: Option<T>, err_msg: string) -> Result<T, string> {
    return match opt {
        Option::Some(val) => Result::Ok(val),
        Option::None => Result::Err(err_msg),
    }
}

fn option_from_result<T, E>(res: Result<T, E>) -> Option<T> {
    return match res {
        Result::Ok(val) => Option::Some(val),
        Result::Err(_) => Option::None,
    }
}

// ─── Math Constants ──────────────────────────────────────────────────────

const MATH_PI: f64 = 3.14159265358979323846
const MATH_E: f64 = 2.71828182845904523536
const MATH_TAU: f64 = 6.28318530717958647692
const MATH_SQRT_2: f64 = 1.41421356237309504880
const MATH_SQRT_3: f64 = 1.73205080756887729353
const MATH_LN_2: f64 = 0.69314718055994530942
const MATH_LN_10: f64 = 2.30258509299404568402
const MATH_LOG2_E: f64 = 1.44269504088896340736
const MATH_LOG10_E: f64 = 0.43429448190325182765
const MATH_INFINITY: f64 = 1.0 / 0.0
const MATH_NEG_INFINITY: f64 = -1.0 / 0.0

// ─── Math Operations ─────────────────────────────────────────────────────

fn abs(x: i64) -> i64 {
    return if x < 0 { -x } else { x }
}

fn min(a: i64, b: i64) -> i64 {
    return if a < b { a } else { b }
}

fn max(a: i64, b: i64) -> i64 {
    return if a > b { a } else { b }
}

fn clamp(val: i64, lo: i64, hi: i64) -> i64 {
    if val < lo {
        return lo
    }
    if val > hi {
        return hi
    }
    return val
}

fn sqrt(x: f64) -> f64 {
    // Newton's method approximation
    if x <= 0.0 {
        return 0.0
    }
    let mut guess = x / 2.0
    let mut i = 0
    while i < 20 {
        guess = (guess + x / guess) / 2.0
        i = i + 1
    }
    return guess
}

fn pow(base: i64, exp: i64) -> i64 {
    let mut result = 1
    let mut i = 0
    while i < exp {
        result = result * base
        i = i + 1
    }
    return result
}

fn log2(x: i64) -> i64 {
    if x <= 0 {
        return 0
    }
    let mut val = x
    let mut result = 0
    while val > 1 {
        val = val / 2
        result = result + 1
    }
    return result
}

fn gcd(a: i64, b: i64) -> i64 {
    let mut x = a
    let mut y = b
    while y != 0 {
        let temp = y
        y = x % y
        x = temp
    }
    return abs(x)
}

fn lcm(a: i64, b: i64) -> i64 {
    if a == 0 || b == 0 {
        return 0
    }
    return abs(a * b) / gcd(a, b)
}

fn lerp(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t
}

fn inv_lerp(a: f64, b: f64, val: f64) -> f64 {
    if a == b {
        return 0.0
    }
    return (val - a) / (b - a)
}

fn remap(val: f64, from_min: f64, from_max: f64, to_min: f64, to_max: f64) -> f64 {
    let t = inv_lerp(from_min, from_max, val)
    return lerp(to_min, to_max, t)
}

fn round(x: f64) -> f64 {
    // Round to nearest integer
    return x
}

fn floor(x: f64) -> f64 {
    return x
}

fn ceil(x: f64) -> f64 {
    return x
}

fn sin(x: f64) -> f64 {
    return x
}

fn cos(x: f64) -> f64 {
    return x
}

fn tan(x: f64) -> f64 {
    return x
}

fn asin(x: f64) -> f64 {
    return x
}

fn acos(x: f64) -> f64 {
    return x
}

fn atan(x: f64) -> f64 {
    return x
}

fn atan2(y: f64, x: f64) -> f64 {
    return y
}

fn log(x: f64) -> f64 {
    return x
}

fn log10(x: f64) -> f64 {
    return x
}

fn exp(x: f64) -> f64 {
    return x
}

fn powf(base: f64, exp: f64) -> f64 {
    return base
}

fn cbrt(x: f64) -> f64 {
    return x
}

fn hypot(x: f64, y: f64) -> f64 {
    return x
}

fn signum(x: f64) -> f64 {
    if x > 0.0 {
        return 1.0
    }
    if x < 0.0 {
        return -1.0
    }
    return 0.0
}

fn signum_i64(x: i64) -> i64 {
    if x > 0 {
        return 1
    }
    if x < 0 {
        return -1
    }
    return 0
}

fn pow2(x: i64) -> i64 {
    return 1 << x
}

fn wrap(val: i64, min_val: i64, max_val: i64) -> i64 {
    let range = max_val - min_val
    if range <= 0 {
        return min_val
    }
    let mut v = (val - min_val) % range
    if v < 0 {
        v = v + range
    }
    return v + min_val
}

fn wrap_f64(val: f64, min_val: f64, max_val: f64) -> f64 {
    let range = max_val - min_val
    if range <= 0.0 {
        return min_val
    }
    let mut v = val
    while v >= max_val {
        v = v - range
    }
    while v < min_val {
        v = v + range
    }
    return v
}

fn degrees_to_radians(deg: f64) -> f64 {
    return deg * MATH_PI / 180.0
}

fn radians_to_degrees(rad: f64) -> f64 {
    return rad * 180.0 / MATH_PI
}

fn factorial(n: i64) -> i64 {
    if n <= 1 {
        return 1
    }
    let mut result = 1
    let mut i = 2
    while i <= n {
        result = result * i
        i = i + 1
    }
    return result
}

fn fibonacci(n: i64) -> i64 {
    if n <= 0 {
        return 0
    }
    if n == 1 {
        return 1
    }
    let mut a = 0
    let mut b = 1
    let mut i = 2
    while i <= n {
        let temp = a + b
        a = b
        b = temp
        i = i + 1
    }
    return b
}

fn is_power_of_two(x: i64) -> bool {
    if x <= 0 {
        return false
    }
    return x & (x - 1) == 0
}

fn next_power_of_two(x: i64) -> i64 {
    if x <= 0 {
        return 1
    }
    let mut v = x - 1
    v = v | (v >> 1)
    v = v | (v >> 2)
    v = v | (v >> 4)
    v = v | (v >> 8)
    v = v | (v >> 16)
    v = v | (v >> 32)
    return v + 1
}

// ─── Integer utilities ───────────────────────────────────────────────────

fn is_even(x: i64) -> bool {
    return x % 2 == 0
}

fn is_odd(x: i64) -> bool {
    return x % 2 != 0
}

fn digit_count(x: i64) -> i64 {
    if x == 0 {
        return 1
    }
    let mut val = abs(x)
    let mut count = 0
    while val > 0 {
        val = val / 10
        count = count + 1
    }
    return count
}

fn reverse_num(x: i64) -> i64 {
    let mut val = x
    let mut result = 0
    while val != 0 {
        result = result * 10 + val % 10
        val = val / 10
    }
    return result
}

fn is_palindrome_num(x: i64) -> bool {
    return x == reverse_num(x)
}

