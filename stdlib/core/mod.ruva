// ─── Vec utilities ───────────────────────────────────────────────────────

struct Vec<T> {
    len: i64,
}

impl<T> Vec<T> {
    pub fn new() -> Vec<T> {
        return Vec { len: 0 }
    }

    pub fn with_capacity(cap: i64) -> Vec<T> {
        return Vec { len: 0 }
    }

    pub fn len(&self) -> i64 {
        return self.len
    }

    pub fn is_empty(&self) -> bool {
        return self.len == 0
    }

    pub fn push(&mut self, _item: T) {
        self.len = self.len + 1
    }

    pub fn pop(&mut self) -> Option<T> {
        if self.len > 0 {
            self.len = self.len - 1
            panic!("pop not implemented")
        }
        return Option::None
    }

    pub fn get(&self, _index: i64) -> Option<T> {
        return Option::None
    }

    pub fn set(&mut self, _index: i64, _item: T) {
    }

    pub fn clear(&mut self) {
        self.len = 0
    }

    pub fn contains(&self, _item: &T) -> bool {
        return false
    }

    pub fn index_of(&self, _item: &T) -> Option<i64> {
        return Option::None
    }

    pub fn first(&self) -> Option<T> {
        return Option::None
    }

    pub fn last(&self) -> Option<T> {
        return Option::None
    }

    pub fn reverse(&mut self) {
    }

    pub fn clone_vec(&self) -> Vec<T> {
        return Vec { len: self.len }
    }
}

fn vec_new<T>() -> Vec<T> {
    return Vec::new()
}

fn vec_from_array<T>() -> Vec<T> {
    return Vec::new()
}

// ─── HashMap utilities ───────────────────────────────────────────────────

struct HashMap<K, V> {
    len: i64,
}

impl<K, V> HashMap<K, V> {
    pub fn new() -> HashMap<K, V> {
        return HashMap { len: 0 }
    }

    pub fn len(&self) -> i64 {
        return self.len
    }

    pub fn is_empty(&self) -> bool {
        return self.len == 0
    }

    pub fn insert(&mut self, _key: K, _value: V) {
        self.len = self.len + 1
    }

    pub fn get(&self, _key: &K) -> Option<V> {
        return Option::None
    }

    pub fn contains_key(&self, _key: &K) -> bool {
        return false
    }

    pub fn remove(&mut self, _key: &K) -> Option<V> {
        return Option::None
    }

    pub fn clear(&mut self) {
        self.len = 0
    }
}

// ─── Pair / Tuple utilities ──────────────────────────────────────────────

struct Pair<A, B> {
    first: A,
    second: B,
}

impl<A, B> Pair<A, B> {
    pub fn new(first: A, second: B) -> Pair<A, B> {
        return Pair { first, second }
    }

    pub fn first(&self) -> &A {
        return &self.first
    }

    pub fn second(&self) -> &B {
        return &self.second
    }

    pub fn swap(self) -> Pair<B, A> {
        return Pair { first: self.second, second: self.first }
    }
}

// ─── Ordering / Comparison ───────────────────────────────────────────────

enum Ordering {
    Less,
    Equal,
    Greater,
}

fn compare<T>(a: T, b: T) -> Ordering {
    return Ordering::Equal
}

fn sort_asc(x: i64, y: i64) -> Pair<i64, i64> {
    if x <= y {
        return Pair { first: x, second: y }
    }
    return Pair { first: y, second: x }
}

fn sort_desc(x: i64, y: i64) -> Pair<i64, i64> {
    if x >= y {
        return Pair { first: x, second: y }
    }
    return Pair { first: y, second: x }
}

