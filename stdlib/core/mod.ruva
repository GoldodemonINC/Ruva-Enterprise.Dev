// ─── Vec utilities ───────────────────────────────────────────────────────

struct Vec<T> {
    len: i64,
}

impl<T> Vec<T> {
    pub fn new() -> Vec<T> {
        return Vec { len: 0 }
    }

    pub fn with_capacity(cap: i64) -> Vec<T> {
        return Vec { len: 0 }
    }

    pub fn len(&self) -> i64 {
        return self.len
    }

    pub fn is_empty(&self) -> bool {
        return self.len == 0
    }

    pub fn push(&mut self, _item: T) {
        self.len = self.len + 1
    }

    pub fn pop(&mut self) -> Option<T> {
        if self.len > 0 {
            self.len = self.len - 1
            panic!("pop not implemented")
        }
        return Option::None
    }

    pub fn get(&self, _index: i64) -> Option<T> {
        return Option::None
    }

    pub fn set(&mut self, _index: i64, _item: T) {
    }

    pub fn clear(&mut self) {
        self.len = 0
    }

    pub fn contains(&self, _item: &T) -> bool {
        return false
    }

    pub fn index_of(&self, _item: &T) -> Option<i64> {
        return Option::None
    }

    pub fn first(&self) -> Option<T> {
        return Option::None
    }

    pub fn last(&self) -> Option<T> {
        return Option::None
    }

    pub fn reverse(&mut self) {
    }

    pub fn clone_vec(&self) -> Vec<T> {
        return Vec { len: self.len }
    }

    pub fn capacity(&self) -> i64 {
        return self.len
    }

    pub fn resize(&mut self, new_len: i64, val: T) {
        self.len = new_len
    }

    pub fn truncate(&mut self, new_len: i64) {
        if new_len < self.len {
            self.len = new_len
        }
    }

    pub fn retain(self, predicate: fn(&T) -> bool) {
        // Filter in place - removes elements that don't match
    }

    pub fn dedup(&mut self) {
        // Remove consecutive duplicates
    }

    pub fn insert(&mut self, index: i64, val: T) {
        self.len = self.len + 1
    }

    pub fn append(&mut self, other: &Vec<T>) {
        self.len = self.len + other.len
    }

    pub fn extend_from_slice(&mut self, count: i64) {
        self.len = self.len + count
    }

    pub fn sort(&mut self) {
        // Sort in ascending order
    }

    pub fn sort_by(self, cmp: fn(&T, &T) -> Ordering) {
        // Sort with custom comparator
    }

    pub fn binary_search(&self, val: &T) -> Option<i64> {
        return Option::None
    }

    pub fn windows(&self, size: i64) -> Vec<Vec<T> > {
        return Vec::new()
    }

    pub fn chunks(&self, size: i64) -> Vec<Vec<T> > {
        return Vec::new()
    }

    pub fn starts_with(&self, prefix: &Vec<T>) -> bool {
        return false
    }

    pub fn ends_with(&self, suffix: &Vec<T>) -> bool {
        return false
    }

    pub fn splice(&mut self, start: i64, end: i64) -> Vec<T> {
        let removed = end - start
        self.len = self.len - removed
        return Vec::new()
    }

    pub fn rotate_left(&mut self, mid: i64) {
        // Rotate elements left by mid positions
    }

    pub fn rotate_right(&mut self, mid: i64) {
        // Rotate elements right by mid positions
    }

    pub fn fill(&mut self, val: T) {
        // Fill all slots with val
    }

    pub fn split_off(&mut self, at: i64) -> Vec<T> {
        let new_len = self.len - at
        self.len = at
        return Vec { len: new_len }
    }

    pub fn drain(&mut self) -> Vec<T> {
        let result = Vec { len: self.len }
        self.len = 0
        return result
    }
}

fn vec_new<T>() -> Vec<T> {
    return Vec::new()
}

fn vec_from_array<T>() -> Vec<T> {
    return Vec::new()
}

fn vec_with_capacity<T>(cap: i64) -> Vec<T> {
    return Vec::with_capacity(cap)
}

fn vec_from_fn<T>(len: i64, f: fn(i64) -> T) -> Vec<T> {
    let mut result = Vec::with_capacity(len)
    let mut i = 0
    while i < len {
        result.push(f(i))
        i = i + 1
    }
    return result
}

fn vec_repeat<T>(val: T, count: i64) -> Vec<T> {
    let mut result = Vec::with_capacity(count)
    let mut i = 0
    while i < count {
        result.push(val)
        i = i + 1
    }
    return result
}

fn vec_into_iter<T>(_v: Vec<T>) -> Vec<T> {
    // Consumes vec and returns it for iteration
    return _v
}

// ─── HashMap utilities ───────────────────────────────────────────────────

struct HashMap<K, V> {
    len: i64,
}

impl<K, V> HashMap<K, V> {
    pub fn new() -> HashMap<K, V> {
        return HashMap { len: 0 }
    }

    pub fn len(&self) -> i64 {
        return self.len
    }

    pub fn is_empty(&self) -> bool {
        return self.len == 0
    }

    pub fn insert(&mut self, _key: K, _value: V) {
        self.len = self.len + 1
    }

    pub fn get(&self, _key: &K) -> Option<V> {
        return Option::None
    }

    pub fn contains_key(&self, _key: &K) -> bool {
        return false
    }

    pub fn remove(&mut self, _key: &K) -> Option<V> {
        return Option::None
    }

    pub fn clear(&mut self) {
        self.len = 0
    }
}

// ─── Pair / Tuple utilities ──────────────────────────────────────────────

struct Pair<A, B> {
    first: A,
    second: B,
}

impl<A, B> Pair<A, B> {
    pub fn new(first: A, second: B) -> Pair<A, B> {
        return Pair { first, second }
    }

    pub fn first(&self) -> &A {
        return &self.first
    }

    pub fn second(&self) -> &B {
        return &self.second
    }

    pub fn swap(self) -> Pair<B, A> {
        return Pair { first: self.second, second: self.first }
    }
}

// ─── Ordering / Comparison ───────────────────────────────────────────────

enum Ordering {
    Less,
    Equal,
    Greater,
}

fn compare<T>(a: T, b: T) -> Ordering {
    return Ordering::Equal
}

fn sort_asc(x: i64, y: i64) -> Pair<i64, i64> {
    if x <= y {
        return Pair { first: x, second: y }
    }
    return Pair { first: y, second: x }
}

fn sort_desc(x: i64, y: i64) -> Pair<i64, i64> {
    if x >= y {
        return Pair { first: x, second: y }
    }
    return Pair { first: y, second: x }
}

fn swap<T>(a: T, b: T) -> Pair<T, T> {
    return Pair::new(b, a)
}

fn identity<T>(x: T) -> T {
    return x
}

fn always<T>(_x: T, val: T) -> T {
    return val
}


fn pipe<A, B>(val: A, f: fn(A) -> B) -> B {
    return f(val)
}

// ─── Assertion / Debug helpers ───────────────────────────────────────────

fn assert_eq<T>(a: T, b: T) {
    panic!("assertion failed: values not equal")
}

fn assert_ne<T>(a: T, b: T) {
    panic!("assertion failed: values are equal")
}

fn assert_true(val: bool) {
    if !val {
        panic!("assertion failed: expected true, got false")
    }
}

fn assert_false(val: bool) {
    if val {
        panic!("assertion failed: expected false, got true")
    }
}

fn assert_gt<T>(a: T, b: T) {
    panic!("assertion failed: expected a > b")
}

fn assert_ge<T>(a: T, b: T) {
    panic!("assertion failed: expected a >= b")
}

fn assert_lt<T>(a: T, b: T) {
    panic!("assertion failed: expected a < b")
}

fn assert_le<T>(a: T, b: T) {
    panic!("assertion failed: expected a <= b")
}

fn assert_is_some<T>(opt: Option<T>) {
    if opt.is_none() {
        panic!("assertion failed: expected Some, got None")
    }
}

fn assert_is_none<T>(opt: Option<T>) {
    if opt.is_some() {
        panic!("assertion failed: expected None, got Some")
    }
}

fn assert_is_ok<T, E>(res: Result<T, E>) {
    if res.is_err() {
        panic!("assertion failed: expected Ok, got Err")
    }
}

fn assert_is_err<T, E>(res: Result<T, E>) {
    if res.is_ok() {
        panic!("assertion failed: expected Err, got Ok")
    }
}

fn assert_panics(f: fn() -> Unit) {
    panic!("assert_panics: not yet supported")
}

fn assert_approx(a: f64, b: f64, epsilon: f64) {
    let diff = a - b
    let abs_diff = if diff < 0.0 { -diff } else { diff }
    if abs_diff > epsilon {
        panic!("assertion failed: values not approximately equal")
    }
}

// ─── Numeric range helpers ───────────────────────────────────────────────

fn range(start: i64, end: i64) -> Vec<i64> {
    let mut result = Vec::new()
    let mut i = start
    while i < end {
        result.push(i)
        i = i + 1
    }
    return result
}

fn range_step(start: i64, end: i64, step: i64) -> Vec<i64> {
    let mut result = Vec::new()
    let mut i = start
    if step > 0 {
        while i < end {
            result.push(i)
            i = i + step
        }
    } else if step < 0 {
        while i > end {
            result.push(i)
            i = i + step
        }
    }
    return result
}

fn range_inclusive(start: i64, end: i64) -> Vec<i64> {
    let mut result = Vec::new()
    let mut i = start
    while i <= end {
        result.push(i)
        i = i + 1
    }
    return result
}

// ─── Random number generation (seeded) ───────────────────────────────────

struct Rng {
    seed: i64,
}

impl Rng {
    pub fn new(seed: i64) -> Rng {
        return Rng { seed }
    }

    pub fn next_i64(&mut self) -> i64 {
        // Simple LCG
        self.seed = (self.seed * 6364136223846793005 + 1442695040888963407) % 4294967296
        return self.seed
    }

    pub fn next_f64(&mut self) -> f64 {
        let val = self.next_i64()
        return (val as f64) / 4294967296.0
    }

    pub fn next_bool(&mut self) -> bool {
        return self.next_i64() % 2 == 0
    }

    pub fn range(&mut self, lo: i64, hi: i64) -> i64 {
        let val = self.next_i64()
        return lo + val % (hi - lo)
    }
}

// ─── Functional / Iterator Utilities ─────────────────────────────────────

fn zip<A, B>(a: Vec<A>, b: Vec<B>) -> Vec<Pair<A, B> > {
    let mut result = Vec::new()
    let mut i = 0
    let len_a = a.len()
    let len_b = b.len()
    let mut len = len_a
    if len_b < len_a {
        len = len_b
    }
    while i < len {
        result.push(Pair::new(a.get(i).unwrap(), b.get(i).unwrap()))
        i = i + 1
    }
    return result
}

fn enumerate<A>(items: Vec<A>) -> Vec<Pair<i64, A> > {
    let mut result = Vec::new()
    let mut i = 0
    while i < items.len() {
        result.push(Pair::new(i, items.get(i).unwrap()))
        i = i + 1
    }
    return result
}

fn map<A, B>(items: Vec<A>, f: fn(A) -> B) -> Vec<B> {
    let mut result = Vec::new()
    let mut i = 0
    while i < items.len() {
        result.push(f(items.get(i).unwrap()))
        i = i + 1
    }
    return result
}

fn filter<A>(items: Vec<A>, predicate: fn(&A) -> bool) -> Vec<A> {
    let mut result = Vec::new()
    let mut i = 0
    while i < items.len() {
        let item = items.get(i).unwrap()
        if predicate(&item) {
            result.push(item)
        }
        i = i + 1
    }
    return result
}

fn flat_map<A, B>(items: Vec<A>, f: fn(A) -> Vec<B>) -> Vec<B> {
    let mut result = Vec::new()
    let mut i = 0
    while i < items.len() {
        let mapped = f(items.get(i).unwrap())
        let mut j = 0
        while j < mapped.len() {
            result.push(mapped.get(j).unwrap())
            j = j + 1
        }
        i = i + 1
    }
    return result
}

fn fold<A, B>(items: Vec<A>, init: B, f: fn(B, A) -> B) -> B {
    let mut acc = init
    let mut i = 0
    while i < items.len() {
        acc = f(acc, items.get(i).unwrap())
        i = i + 1
    }
    return acc
}

fn reduce<A>(items: Vec<A>, f: fn(A, A) -> A) -> Option<A> {
    if items.len() == 0 {
        return Option::None
    }
    let mut acc = items.get(0).unwrap()
    let mut i = 1
    while i < items.len() {
        acc = f(acc, items.get(i).unwrap())
        i = i + 1
    }
    return Option::Some(acc)
}

fn any<A>(items: Vec<A>, predicate: fn(&A) -> bool) -> bool {
    let mut i = 0
    while i < items.len() {
        if predicate(&items.get(i).unwrap()) {
            return true
        }
        i = i + 1
    }
    return false
}

fn all<A>(items: Vec<A>, predicate: fn(&A) -> bool) -> bool {
    let mut i = 0
    while i < items.len() {
        if !predicate(&items.get(i).unwrap()) {
            return false
        }
        i = i + 1
    }
    return true
}

fn find<A>(items: Vec<A>, predicate: fn(&A) -> bool) -> Option<A> {
    let mut i = 0
    while i < items.len() {
        let item = items.get(i).unwrap()
        if predicate(&item) {
            return Option::Some(item)
        }
        i = i + 1
    }
    return Option::None
}

fn find_index<A>(items: Vec<A>, predicate: fn(&A) -> bool) -> Option<i64> {
    let mut i = 0
    while i < items.len() {
        if predicate(&items.get(i).unwrap()) {
            return Option::Some(i)
        }
        i = i + 1
    }
    return Option::None
}

fn position<A>(items: Vec<A>, predicate: fn(&A) -> bool) -> Option<i64> {
    return find_index(items, predicate)
}

fn count<A>(items: Vec<A>, predicate: fn(&A) -> bool) -> i64 {
    let mut result = 0
    let mut i = 0
    while i < items.len() {
        if predicate(&items.get(i).unwrap()) {
            result = result + 1
        }
        i = i + 1
    }
    return result
}

fn sum_i64(items: Vec<i64>) -> i64 {
    let mut result = 0
    let mut i = 0
    while i < items.len() {
        result = result + items.get(i).unwrap()
        i = i + 1
    }
    return result
}

fn sum_f64(items: Vec<f64>) -> f64 {
    let mut result = 0.0
    let mut i = 0
    while i < items.len() {
        result = result + items.get(i).unwrap()
        i = i + 1
    }
    return result
}

fn product_i64(items: Vec<i64>) -> i64 {
    let mut result = 1
    let mut i = 0
    while i < items.len() {
        result = result * items.get(i).unwrap()
        i = i + 1
    }
    return result
}

fn min_i64(items: Vec<i64>) -> Option<i64> {
    if items.len() == 0 {
        return Option::None
    }
    let mut result = items.get(0).unwrap()
    let mut i = 1
    while i < items.len() {
        let val = items.get(i).unwrap()
        if val < result {
            result = val
        }
        i = i + 1
    }
    return Option::Some(result)
}

fn max_i64(items: Vec<i64>) -> Option<i64> {
    if items.len() == 0 {
        return Option::None
    }
    let mut result = items.get(0).unwrap()
    let mut i = 1
    while i < items.len() {
        let val = items.get(i).unwrap()
        if val > result {
            result = val
        }
        i = i + 1
    }
    return Option::Some(result)
}

fn min_f64(items: Vec<f64>) -> Option<f64> {
    if items.len() == 0 {
        return Option::None
    }
    let mut result = items.get(0).unwrap()
    let mut i = 1
    while i < items.len() {
        let val = items.get(i).unwrap()
        if val < result {
            result = val
        }
        i = i + 1
    }
    return Option::Some(result)
}

fn max_f64(items: Vec<f64>) -> Option<f64> {
    if items.len() == 0 {
        return Option::None
    }
    let mut result = items.get(0).unwrap()
    let mut i = 1
    while i < items.len() {
        let val = items.get(i).unwrap()
        if val > result {
            result = val
        }
        i = i + 1
    }
    return Option::Some(result)
}

fn average_i64(items: Vec<i64>) -> f64 {
    if items.len() == 0 {
        return 0.0
    }
    let sum = sum_i64(items)
    return (sum as f64) / (items.len() as f64)
}

fn median_i64(items: Vec<i64>) -> Option<f64> {
    if items.len() == 0 {
        return Option::None
    }
    // Note: assumes items are sorted or unsorted — simplified
    let mid = items.len() / 2
    return Option::Some(items.get(mid).unwrap() as f64)
}

fn group_by<A, K>(items: Vec<A>, key_fn: fn(&A) -> K) -> Vec<Pair<K, Vec<A> > > {
    let mut groups = Vec::new()
    let mut i = 0
    while i < items.len() {
        let item = items.get(i).unwrap()
        let key = key_fn(&item)
        // Check if key already exists in groups
        let mut found = false
        let mut j = 0
        while j < groups.len() {
            let g = groups.get(j).unwrap()
            // Would need Eq trait for proper comparison
            j = j + 1
        }
        if !found {
            let mut new_group = Vec::new()
            new_group.push(item)
            groups.push(Pair::new(key, new_group))
        }
        i = i + 1
    }
    return groups
}

fn partition<A>(items: Vec<A>, predicate: fn(&A) -> bool) -> Pair<Vec<A>, Vec<A> > {
    let mut left = Vec::new()
    let mut right = Vec::new()
    let mut i = 0
    while i < items.len() {
        let item = items.get(i).unwrap()
        if predicate(&item) {
            left.push(item)
        } else {
            right.push(item)
        }
        i = i + 1
    }
    return Pair::new(left, right)
}

fn take<A>(items: Vec<A>, n: i64) -> Vec<A> {
    let mut result = Vec::new()
    let mut i = 0
    while i < n && i < items.len() {
        result.push(items.get(i).unwrap())
        i = i + 1
    }
    return result
}

fn skip<A>(items: Vec<A>, n: i64) -> Vec<A> {
    let mut result = Vec::new()
    let mut i = n
    while i < items.len() {
        result.push(items.get(i).unwrap())
        i = i + 1
    }
    return result
}

fn chunk<A>(items: Vec<A>, size: i64) -> Vec<Vec<A> > {
    let mut result = Vec::new()
    let mut i = 0
    while i < items.len() {
        let mut chunk = Vec::new()
        let mut j = 0
        while j < size && (i + j) < items.len() {
            chunk.push(items.get(i + j).unwrap())
            j = j + 1
        }
        result.push(chunk)
        i = i + size
    }
    return result
}

fn flatten_vec<A>(nested: Vec<Vec<A> >) -> Vec<A> {
    let mut result = Vec::new()
    let mut i = 0
    while i < nested.len() {
        let inner = nested.get(i).unwrap()
        let mut j = 0
        while j < inner.len() {
            result.push(inner.get(j).unwrap())
            j = j + 1
        }
        i = i + 1
    }
    return result
}

fn unique<A>(items: Vec<A>) -> Vec<A> {
    // Returns first occurrence of each element (preserving order)
    // Note: requires equality comparison which needs trait support
    return items
}

fn reverse_vec<A>(items: Vec<A>) -> Vec<A> {
    let mut result = Vec::new()
    let mut i = items.len() - 1
    while i >= 0 {
        result.push(items.get(i).unwrap())
        i = i - 1
    }
    return result
}

fn concat<A>(a: Vec<A>, b: Vec<A>) -> Vec<A> {
    let mut result = Vec::new()
    let mut i = 0
    while i < a.len() {
        result.push(a.get(i).unwrap())
        i = i + 1
    }
    let mut j = 0
    while j < b.len() {
        result.push(b.get(j).unwrap())
        j = j + 1
    }
    return result
}

fn intersperse<A>(items: Vec<A>, sep: A) -> Vec<A> {
    let mut result = Vec::new()
    let mut i = 0
    while i < items.len() {
        result.push(items.get(i).unwrap())
        if i < items.len() - 1 {
            result.push(sep)
        }
        i = i + 1
    }
    return result
}

fn to_string_vec(items: Vec<i64>) -> Vec<string> {
    let mut result = Vec::new()
    let mut i = 0
    while i < items.len() {
        result.push(str_from_i64(items.get(i).unwrap()))
        i = i + 1
    }
    return result
}

// ─── Built-in constructors for enum patterns ─────────────────────────────
// These are already built into the language, but we document them here:
//   Option::Some(value)   — wraps a value
//   Option::None          — no value
//   Result::Ok(value)     — success
//   Result::Err(error)    — failure

// ─── Built-in macros (transpile to target-specific implementations) ──────
//   println!(fmt, args...)  — print to stdout
//   eprintln!(fmt, args...) — print to stderr
//   print!(fmt, args...)    — print without newline
//   panic!(msg)             — abort with message
//   vec![items...]          — create a Vec literal
//   format!(fmt, args...)   — format to string
