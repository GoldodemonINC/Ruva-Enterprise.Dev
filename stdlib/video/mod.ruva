// ─── Muxer/Demuxer ──────────────────────────────────────────────────────────

pub struct Muxer {
    pub format: ContainerFormat,
}

pub struct Demuxer {
    pub format: ContainerFormat,
}

impl Muxer {
    pub fn new(path: string, format: ContainerFormat) -> Result<Muxer, string> {
        return Result::Err("Not implemented".into())
    }

    pub fn write_packet(&mut self, packet: Packet) -> Result<(), string> {
        return Result::Err("Not implemented".into())
    }

    pub fn close(&mut self) -> Result<(), string> {
        return Result::Err("Not implemented".into())
    }
}

impl Demuxer {
    pub fn new(path: string) -> Result<Demuxer, string> {
        return Result::Err("Not implemented".into())
    }

    pub fn get_format(&self) -> ContainerFormat {
        return self.format.clone()
    }

    pub fn read_packet(&mut self) -> Result<Packet, string> {
        return Result::Err("Not implemented".into())
    }

    pub fn seek(&mut self, timestamp: i64) -> Result<(), string> {
        return Result::Err("Not implemented".into())
    }

    pub fn close(&mut self) {
    }
}

// ─── Filters ────────────────────────────────────────────────────────────────

mod filter {
    pub struct ResizeFilter {
        pub width: u32,
        pub height: u32,
    }

    pub struct CropFilter {
        pub x: u32,
        pub y: u32,
        pub width: u32,
        pub height: u32,
    }

    pub struct RotateFilter {
        pub angle: f64,
    }

    pub struct BlurFilter {
        pub radius: f64,
    }

    pub struct SharpenFilter {
        pub amount: f64,
    }

    pub struct BrightnessFilter {
        pub factor: f64,
    }

    pub struct ContrastFilter {
        pub factor: f64,
    }

    pub struct GrayscaleFilter {
    }

    pub struct InvertFilter {
    }

    pub struct FlipFilter {
        pub horizontal: bool,
        pub vertical: bool,
    }

    pub struct TextOverlayFilter {
        pub text: string,
        pub x: f64,
        pub y: f64,
    }

    pub struct ImageOverlayFilter {
        pub x: f64,
        pub y: f64,
        pub opacity: f64,
    }

    impl ResizeFilter {
        pub fn new(width: u32, height: u32) -> ResizeFilter {
            return ResizeFilter { width, height }
        }
    }

    impl CropFilter {
        pub fn new(x: u32, y: u32, width: u32, height: u32) -> CropFilter {
            return CropFilter { x, y, width, height }
        }
    }

    impl RotateFilter {
        pub fn new(angle: f64) -> RotateFilter {
            return RotateFilter { angle }
        }
    }

    impl BlurFilter {
        pub fn new(radius: f64) -> BlurFilter {
            return BlurFilter { radius }
        }
    }

    impl SharpenFilter {
        pub fn new(amount: f64) -> SharpenFilter {
            return SharpenFilter { amount }
        }
    }

    impl BrightnessFilter {
        pub fn new(factor: f64) -> BrightnessFilter {
            return BrightnessFilter { factor }
        }
    }

    impl ContrastFilter {
        pub fn new(factor: f64) -> ContrastFilter {
            return ContrastFilter { factor }
        }
    }

    impl GrayscaleFilter {
        pub fn new() -> GrayscaleFilter {
            return GrayscaleFilter {}
        }
    }

    impl InvertFilter {
        pub fn new() -> InvertFilter {
            return InvertFilter {}
        }
    }

    impl FlipFilter {
        pub fn new(horizontal: bool, vertical: bool) -> FlipFilter {
            return FlipFilter { horizontal, vertical }
        }
    }

    impl TextOverlayFilter {
        pub fn new(text: string, x: f64, y: f64) -> TextOverlayFilter {
            return TextOverlayFilter { text, x, y }
        }
    }

    impl ImageOverlayFilter {
        pub fn new(x: f64, y: f64, opacity: f64) -> ImageOverlayFilter {
            return ImageOverlayFilter { x, y, opacity }
        }
    }
}
