// Ruva Graphics Demo - Native Vulkan Performance Showcase
// 3D Rendering with Shaders, Textures, and Lighting

import ruva::graphics::vulkan
import ruva::core::Vec
import ruva::core::String

// ─── Vector3D ───────────────────────────────────────────────────────────────

struct Vec3 {
    pub x: f32,
    pub y: f32,
    pub z: f32,
}

impl Vec3 {
    pub fn new(x: f32, y: f32, z: f32) -> Self {
        return Self { x, y, z }
    }

    pub fn add(&self, other: &Vec3) -> Vec3 {
        return Vec3::new(self.x + other.x, self.y + other.y, self.z + other.z)
    }

    pub fn sub(&self, other: &Vec3) -> Vec3 {
        return Vec3::new(self.x - other.x, self.y - other.y, self.z - other.z)
    }

    pub fn scale(&self, factor: f32) -> Vec3 {
        return Vec3::new(self.x * factor, self.y * factor, self.z * factor)
    }

    pub fn dot(&self, other: &Vec3) -> f32 {
        return self.x * other.x + self.y * other.y + self.z * other.z
    }

    pub fn cross(&self, other: &Vec3) -> Vec3 {
        return Vec3::new(
            self.y * other.z - self.z * other.y,
            self.z * other.x - self.x * other.z,
            self.x * other.y - self.y * other.x,
        )
    }

    pub fn length(&self) -> f32 {
        return (self.x * self.x + self.y * self.y + self.z * self.z).sqrt()
    }

    pub fn normalize(&self) -> Vec3 {
        let len = self.length()
        if len > 0.0 {
            return Vec3::new(self.x / len, self.y / len, self.z / len)
        }
        return Vec3::new(0.0, 0.0, 0.0)
    }
}

// ─── Vertex ─────────────────────────────────────────────────────────────────

struct Vertex {
    pub position: Vec3,
    pub normal: Vec3,
    pub uv_x: f32,
    pub uv_y: f32,
}

// ─── Material ───────────────────────────────────────────────────────────────

struct Material {
    pub albedo_r: f32,
    pub albedo_g: f32,
    pub albedo_b: f32,
    pub metallic: f32,
    pub roughness: f32,
}

impl Material {
    pub fn new(r: f32, g: f32, b: f32, metallic: f32, roughness: f32) -> Self {
        return Self { albedo_r: r, albedo_g: g, albedo_b: b, metallic, roughness }
    }

    pub fn metal(r: f32, g: f32, b: f32) -> Self {
        return Self {
            albedo_r: r, albedo_g: g, albedo_b: b,
            metallic: 1.0, roughness: 0.2,
        }
    }

    pub fn plastic(r: f32, g: f32, b: f32) -> Self {
        return Self {
            albedo_r: r, albedo_g: g, albedo_b: b,
            metallic: 0.0, roughness: 0.5,
        }
    }
}

// ─── Light ──────────────────────────────────────────────────────────────────

struct Light {
    pub position: Vec3,
    pub color_r: f32,
    pub color_g: f32,
    pub color_b: f32,
    pub intensity: f32,
}

impl Light {
    pub fn point(x: f32, y: f32, z: f32, r: f32, g: f32, b: f32, intensity: f32) -> Self {
        return Self {
            position: Vec3::new(x, y, z),
            color_r: r, color_g: g, color_b: b,
            intensity,
        }
    }
}

// ─── Camera ─────────────────────────────────────────────────────────────────

class Camera {
    pub let mut pos_x: f32
    pub let mut pos_y: f32
    pub let mut pos_z: f32
    pub let mut target_x: f32
    pub let mut target_y: f32
    pub let mut target_z: f32
    pub let mut fov: f32

    pub fn new() -> Self {
        return Self {
            pos_x: 0.0, pos_y: 2.0, pos_z: 5.0,
            target_x: 0.0, target_y: 0.0, target_z: 0.0,
            fov: 45.0,
        }
    }

    pub fn rotate_around_target(&mut self, angle: f32, distance: f32) {
        self.pos_x = distance * angle.cos()
        self.pos_z = distance * angle.sin()
    }
}

// ─── Render Object ──────────────────────────────────────────────────────────

struct RenderObject {
    pub pos_x: f32,
    pub pos_y: f32,
    pub pos_z: f32,
    pub rot_y: f32,
    pub scale: f32,
    pub material: Material,
}

impl RenderObject {
    pub fn new(x: f32, y: f32, z: f32, material: Material) -> Self {
        return Self {
            pos_x: x, pos_y: y, pos_z: z,
            rot_y: 0.0, scale: 1.0,
            material,
        }
    }

    pub fn with_scale(mut self, s: f32) -> Self {
        self.scale = s
        return self
    }

    pub fn rotate(&mut self, angle: f32) {
        self.rot_y = angle
    }
}

// ─── Renderer ───────────────────────────────────────────────────────────────

class Renderer {
    pub let mut window: vulkan::Window
    pub let mut device: vulkan::Device
    pub let mut frame_count: u64

    pub fn new(width: u32, height: u32) -> Result<Renderer, string> {
        let window = vulkan::Window::new("Ruva Graphics Demo", width, height)?
        let device = vulkan::Device::new(&window)?

        return Result::Ok(Self {
            window,
            device,
            frame_count: 0,
        })
    }

    pub fn render_frame(&mut self, camera: &Camera, objects: &[RenderObject], lights: &[Light]) {
        // Clear screen (dark blue background)
        self.device.clear(0.05, 0.05, 0.15, 1.0)

        // Set camera uniforms
        self.device.set_view_position(camera.pos_x, camera.pos_y, camera.pos_z)

        // Set light uniforms
        for (i, light) in lights.iter().enumerate() {
            self.device.set_light(
                i as u32,
                light.position.x, light.position.y, light.position.z,
                light.color_r, light.color_g, light.color_b,
                light.intensity,
            )
        }

        // Render each object
        for obj in objects {
            // Set model transform
            self.device.set_model_transform(
                obj.pos_x, obj.pos_y, obj.pos_z,
                obj.rot_y,
                obj.scale,
            )

            // Set material
            self.device.set_material(
                obj.material.albedo_r, obj.material.albedo_g, obj.material.albedo_b,
                obj.material.metallic,
                obj.material.roughness,
            )

            // Draw cube (24 vertices, 36 indices)
            self.device.draw_cube()
        }

        // Present frame
        self.device.present()
        self.frame_count += 1
    }

    pub fn get_fps(&self) -> f64 {
        // Implementation would calculate FPS
        return 60.0
    }
}

// ─── Demo Scene ─────────────────────────────────────────────────────────────

class DemoScene {
    pub let mut renderer: Renderer
    pub let mut camera: Camera
    pub let mut objects: Vec<RenderObject>
    pub let mut lights: Vec<Light>
    pub let mut time: f32
    pub let mut is_running: bool

    pub fn new() -> Result<DemoScene, string> {
        let renderer = Renderer::new(1280, 720)?
        let mut camera = Camera::new()

        // Create objects
        let mut objects = Vec::new()

        // Central metallic cube (red)
        objects.push(RenderObject::new(0.0, 0.0, 0.0, Material::metal(0.8, 0.2, 0.2)))

        // Surrounding plastic spheres
        objects.push(RenderObject::new(2.0, 0.0, 0.0, Material::plastic(0.2, 0.8, 0.2)))
        objects.push(RenderObject::new(-2.0, 0.0, 0.0, Material::plastic(0.2, 0.2, 0.8)))
        objects.push(RenderObject::new(0.0, 0.0, 2.0, Material::plastic(0.8, 0.8, 0.2)))
        objects.push(RenderObject::new(0.0, 0.0, -2.0, Material::plastic(0.8, 0.2, 0.8)))

        // Top object
        objects.push(RenderObject::new(0.0, 2.0, 0.0, Material::metal(0.9, 0.9, 1.0)))

        // Create lights
        let mut lights = Vec::new()
        lights.push(Light::point(3.0, 3.0, 3.0, 1.0, 1.0, 1.0, 1.0))
        lights.push(Light::point(-3.0, 3.0, 3.0, 1.0, 0.6, 0.2, 0.8))
        lights.push(Light::point(0.0, -3.0, 0.0, 0.3, 0.3, 1.0, 0.5))

        return Result::Ok(Self {
            renderer,
            camera,
            objects,
            lights,
            time: 0.0,
            is_running: true,
        })
    }

    pub fn run(&mut self) {
        println!("Running at {} fps", self.renderer.get_fps())
        println!("Press ESC to exit")

        while self.is_running && !self.renderer.window.should_close() {
            // Calculate delta time
            let delta_time = 0.016

            // Update time
            self.time += delta_time

            // Rotate camera around scene
            self.camera.rotate_around_target(self.time * 0.5, 5.0)

            // Rotate central cube
            self.objects[0].rotate(self.time)

            // Rotate surrounding objects in opposite direction
            self.objects[1].rotate(-self.time * 1.5)
            self.objects[2].rotate(-self.time * 1.5)
            self.objects[3].rotate(-self.time * 1.5)
            self.objects[4].rotate(-self.time * 1.5)

            // Render frame
            self.renderer.render_frame(&self.camera, &self.objects, &self.lights)

            // Print FPS every second
            if (self.time * 10.0) as u32 % 10 == 0 {
                println!("FPS: {:.1}", self.renderer.get_fps())
            }
        }
    }

    pub fn stop(&mut self) {
        self.is_running = false
    }
}

// ─── Main ───────────────────────────────────────────────────────────────────

fn main() {
    println!("=== Ruva Graphics Demo ===")
    println!("Native Vulkan Performance Showcase")
    println!()
    println!("Features:")
    println!("  - 3D rendering with Vulkan")
    println!("  - PBR materials (metallic/roughness)")
    println!("  - Multiple point lights")
    println!("  - Real-time camera rotation")
    println!("  - Native performance (no GC, no JIT)")
    println!()

    // Initialize scene
    let mut scene = match DemoScene::new() {
        Result::Ok(s) => s,
        Result::Err(e) => {
            println!("Failed to initialize graphics: {}", e)
            return
        }
    }

    println!("Graphics initialized!")
    println!("Vulkan rendering active")
    println!("Camera rotating around scene")
    println!()

    // Run render loop
    scene.run()

    println!("Demo complete!")
}
