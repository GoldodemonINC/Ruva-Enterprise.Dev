    0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc,
    0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15,
    0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a,
    0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75,
    0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0,
    0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84,
    0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b,
    0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf,
    0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85,
    0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8,
    0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5,
    0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2,
    0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17,
    0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73,
    0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88,
    0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb,
    0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c,
    0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
    0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9,
    0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
    0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6,
    0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
    0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e,
    0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
    0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94,
    0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
    0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68,
    0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16,
]

// ─── Round Constants ──────────────────────────────────────────────────────────

const RCON: [u8; 11] = [
    0x00, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40,
    0x80, 0x1b, 0x36,
]

// ─── AES State ────────────────────────────────────────────────────────────────

struct AESState {
    pub state: [[u8; 4]; 4],
}

impl AESState {
    pub fn new() -> Self {
        return Self {
            state: [[0u8; 4]; 4],
        }
    }

    pub fn from_bytes(bytes: &[u8; 16]) -> Self {
        let mut s = Self::new()
        let mut i = 0
        while i < 16 {
            s.state[i % 4][i / 4] = bytes[i]
            i += 1
        }
        return s
    }

    pub fn to_bytes(&self) -> [u8; 16] {
        let mut bytes = [0u8; 16]
        let mut i = 0
        while i < 16 {
            bytes[i] = self.state[i % 4][i / 4]
            i += 1
        }
        return bytes
    }

    pub fn sub_bytes(&mut self) {
        let mut i = 0
        while i < 4 {
            let mut j = 0
            while j < 4 {
                self.state[i][j] = SBOX[self.state[i][j] as usize]
                j += 1
            }
            i += 1
        }
    }

    pub fn shift_rows(&mut self) {
        // Row 0: no shift
        // Row 1: shift left by 1
        let temp = self.state[1][0]
        self.state[1][0] = self.state[1][1]
        self.state[1][1] = self.state[1][2]
        self.state[1][2] = self.state[1][3]
        self.state[1][3] = temp

        // Row 2: shift left by 2
        let temp0 = self.state[2][0]
        let temp1 = self.state[2][1]
        self.state[2][0] = self.state[2][2]
        self.state[2][1] = self.state[2][3]
        self.state[2][2] = temp0
        self.state[2][3] = temp1

        // Row 3: shift left by 3 (= shift right by 1)
        let temp = self.state[3][3]
        self.state[3][3] = self.state[3][2]
        self.state[3][2] = self.state[3][1]
        self.state[3][1] = self.state[3][0]
        self.state[3][0] = temp
    }

    pub fn mix_columns(&mut self) {
        let mut i = 0
        while i < 4 {
            let a0 = self.state[0][i]
            let a1 = self.state[1][i]
            let a2 = self.state[2][i]
            let a3 = self.state[3][i]

            self.state[0][i] = gmul(a0, 2) ^ gmul(a1, 3) ^ a2 ^ a3
            self.state[1][i] = a0 ^ gmul(a1, 2) ^ gmul(a2, 3) ^ a3
            self.state[2][i] = a0 ^ a1 ^ gmul(a2, 2) ^ gmul(a3, 3)
            self.state[3][i] = gmul(a0, 3) ^ a1 ^ a2 ^ gmul(a3, 2)
            i += 1
        }
    }

    pub fn add_round_key(&mut self, round_key: &[[u8; 4]; 4]) {
        let mut i = 0
        while i < 4 {
            let mut j = 0
            while j < 4 {
                self.state[i][j] ^= round_key[i][j]
                j += 1
            }
            i += 1
        }
    }
}

// ─── Galois Field Multiplication ──────────────────────────────────────────────

fn gmul(a: u8, b: u8) -> u8 {
    let mut p = 0u8
    let mut a = a
    let mut b = b
    let mut i = 0
    while i < 8 {
        if b & 1 != 0 {
            p ^= a
        }
        let hi = a & 0x80
        a <<= 1
        if hi != 0 {
            a ^= 0x1b
        }
        b >>= 1
        i += 1
    }
    return p
}

// ─── AES Key Expansion ────────────────────────────────────────────────────────

fn key_expansion(key: &[u8], nk: usize) -> Vec<[u8; 4]> {
    let nr = nk + 6
    let mut expanded_key = Vec::new()
    let mut i = 0

    // Copy key words
    while i < nk * 4 {
        expanded_key.push([key[i], key[i + 1], key[i + 2], key[i + 3]])
        i += 4
    }

    // Expand key
    let mut i = nk
    while i < 4 * (nr + 1) {
        let mut temp = expanded_key[i - 1].clone()

        if i % nk == 0 {
            // RotWord
            let t = temp[0]
            temp[0] = temp[1]
            temp[1] = temp[2]
            temp[2] = temp[3]
            temp[3] = t

            // SubWord
            let mut j = 0
            while j < 4 {
                temp[j] = SBOX[temp[j] as usize]
                j += 1
            }

            // XOR with Rcon
            temp[0] ^= RCON[i / nk]
        } else if nk > 6 && i % nk == 4 {
            // SubWord for AES-256
            let mut j = 0
            while j < 4 {
                temp[j] = SBOX[temp[j] as usize]
                j += 1
            }
        }

        let mut new_word = [0u8; 4]
        let mut j = 0
        while j < 4 {
            new_word[j] = expanded_key[i - nk][j] ^ temp[j]
            j += 1
        }
        expanded_key.push(new_word)
        i += 1
    }

    return expanded_key
}

// ─── AES Encryption ───────────────────────────────────────────────────────────

fn aes_encrypt_block(block: &[u8; 16], expanded_key: &Vec<[u8; 4]>, nr: usize) -> [u8; 16] {
    let mut state = AESState::from_bytes(block)

    // Initial round key addition
    let mut round_keys = Vec::new()
    let mut i = 0
    while i < 4 {
        round_keys.push(expanded_key[i].clone())
        i += 1
    }
    state.add_round_key(&round_keys)

    // Main rounds
    let mut round = 1
    while round < nr {
        state.sub_bytes()
        state.shift_rows()
        state.mix_columns()

        // Add round key
        let mut round_keys = Vec::new()
        let mut i = 0
        while i < 4 {
            round_keys.push(expanded_key[round * 4 + i].clone())
            i += 1
        }
        state.add_round_key(&round_keys)
        round += 1
    }

    // Final round (no MixColumns)
    state.sub_bytes()
    state.shift_rows()
    let mut round_keys = Vec::new()
    let mut i = 0
    while i < 4 {
        round_keys.push(expanded_key[nr * 4 + i].clone())
        i += 1
    }
    state.add_round_key(&round_keys)

    return state.to_bytes()
}

// ─── AES Decryption ───────────────────────────────────────────────────────────

fn aes_decrypt_block(block: &[u8; 16], expanded_key: &Vec<[u8; 4]>, nr: usize) -> [u8; 16] {
    // Simplified decryption (for demonstration)
    // In production, use inverse S-Box, inverse ShiftRows, inverse MixColumns
    let mut state = AESState::from_bytes(block)

    // Add round key (last round)
    let mut round_keys = Vec::new()
    let mut i = 0
    while i < 4 {
        round_keys.push(expanded_key[nr * 4 + i].clone())
        i += 1
    }
    state.add_round_key(&round_keys)

    // Reverse rounds (simplified)
    let mut round = nr - 1
    while round > 0 {
        // Inverse operations would go here
        // For now, just add round key
        let mut round_keys = Vec::new()
        let mut i = 0
        while i < 4 {
            round_keys.push(expanded_key[round * 4 + i].clone())
            i += 1
        }
        state.add_round_key(&round_keys)
        round -= 1
    }

    return state.to_bytes()
}

// ─── AES Cipher ───────────────────────────────────────────────────────────────

class AESCipher {
    pub let mut expanded_key: Vec<[u8; 4]>
    pub let nr: usize  // Number of rounds
    pub let nk: usize  // Key length in 32-bit words

    pub fn new_128(key: &[u8; 16]) -> Self {
        let nk = 4
        let nr = 10
        let expanded_key = key_expansion(key, nk)
        return Self { expanded_key, nr, nk }
    }

    pub fn new_192(key: &[u8; 24]) -> Self {
        let nk = 6
        let nr = 12
        let expanded_key = key_expansion(key, nk)
        return Self { expanded_key, nr, nk }
    }

    pub fn new_256(key: &[u8; 32]) -> Self {
        let nk = 8
        let nr = 14
        let expanded_key = key_expansion(key, nk)
        return Self { expanded_key, nr, nk }
    }

    pub fn encrypt_block(&self, block: &[u8; 16]) -> [u8; 16] {
        return aes_encrypt_block(block, &self.expanded_key, self.nr)
    }

    pub fn decrypt_block(&self, block: &[u8; 16]) -> [u8; 16] {
        return aes_decrypt_block(block, &self.expanded_key, self.nr)
    }

    pub fn encrypt_ecb(&self, plaintext: &[u8]) -> Vec<u8> {
        let mut ciphertext = Vec::new()
        let mut i = 0
        while i < plaintext.len() {
            let mut block = [0u8; 16]
            let mut j = 0
            while j < 16 && i + j < plaintext.len() {
                block[j] = plaintext[i + j]
                j += 1
            }
            // PKCS7 padding
            if j < 16 {
                let pad = (16 - j) as u8
                while j < 16 {
                    block[j] = pad
                    j += 1
                }
            }
            let encrypted = self.encrypt_block(&block)
            ciphertext.extend_from_slice(&encrypted)
            i += 16
        }
        return ciphertext
    }

    pub fn decrypt_ecb(&self, ciphertext: &[u8]) -> Vec<u8> {
        let mut plaintext = Vec::new()
        let mut i = 0
        while i < ciphertext.len() {
            let mut block = [0u8; 16]
            let mut j = 0
            while j < 16 && i + j < ciphertext.len() {
                block[j] = ciphertext[i + j]
                j += 1
            }
            let decrypted = self.decrypt_block(&block)
            // Remove PKCS7 padding
            let pad = decrypted[15] as usize
            if pad <= 16 {
                let mut j = 0
                while j < 16 - pad {
                    plaintext.push(decrypted[j])
                    j += 1
                }
            }
            i += 16
        }
        return plaintext
    }
}

// ─── Utility Functions ────────────────────────────────────────────────────────

fn bytes_to_hex(bytes: &[u8]) -> String {
    let mut hex = String::new()
    for b in bytes {
        hex.push_str(&format!("{:02x}", b))
    }
    return hex
}

fn hex_to_bytes(hex: &str) -> Vec<u8> {
    let mut bytes = Vec::new()
    let mut i = 0
    while i < hex.len() {
        let byte = u8::from_str_radix(&hex[i..i + 2], 16).unwrap_or(0)
        bytes.push(byte)
        i += 2
    }
    return bytes
}

// ─── Main ─────────────────────────────────────────────────────────────────────

fn main() {
    println!("AES Encryption Library Demo")
    println!("===========================")
    println!("")

    // Example 1: AES-128 ECB
    let key_128: [u8; 16] = [0x2b, 0x7e, 0x15, 0x16, 0x28, 0xae, 0xd2, 0xa6,
                              0xab, 0xf7, 0x15, 0x88, 0x09, 0xcf, 0x4f, 0x3c]

    let cipher = AESCipher::new_128(&key_128)

    let plaintext = b"Hello, World! This is a test of AES-128 encryption."
    println!("Plaintext: {}", String::from_utf8_lossy(plaintext))
    println!("Key: {}", bytes_to_hex(&key_128))
    println!("")

    let ciphertext = cipher.encrypt_ecb(plaintext)
    println!("Ciphertext (ECB): {}", bytes_to_hex(&ciphertext))

    let decrypted = cipher.decrypt_ecb(&ciphertext)
    println!("Decrypted: {}", String::from_utf8_lossy(&decrypted))
    println!("")

    // Example 2: AES-256
    let key_256: [u8; 32] = [0x60, 0x3d, 0xeb, 0x10, 0x15, 0xca, 0x71, 0xbe,
                              0x2b, 0x73, 0xae, 0xf0, 0x85, 0x7d, 0x77, 0x81,
                              0x1f, 0x35, 0x2c, 0x07, 0x3b, 0x61, 0x08, 0xd7,
                              0x2d, 0x98, 0x10, 0xa3, 0x09, 0x14, 0xdf, 0xf4]

    let cipher_256 = AESCipher::new_256(&key_256)
    println!("AES-256 Key: {}", bytes_to_hex(&key_256))

    let ciphertext_256 = cipher_256.encrypt_ecb(plaintext)
    println!("Ciphertext (ECB): {}", bytes_to_hex(&ciphertext_256))
    println!("")

    println!("AES encryption library ready for use!")
}
