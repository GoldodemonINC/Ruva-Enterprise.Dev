// ═══════════════════════════════════════════════════════════════════════════════
// AES Encryption Library — AES-128/192/256 implementation in Ruva
// ═══════════════════════════════════════════════════════════════════════════════
//
// Features:
//   • AES-128, AES-192, AES-256 support
//   • ECB, CBC, CTR modes
//   • PKCS7 padding
//   • Key expansion
//   • SubBytes, ShiftRows, MixColumns transformations
//   • Secure key generation
//   • HMAC authentication
//
// Run:  ruva run examples/crypto/aes.ruva
// ═══════════════════════════════════════════════════════════════════════════════

// ─── S-Box (Substitution Box) ────────────────────────────────────────────────

const SBOX: [u8; 256] = [
    0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5,
    0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76,
    0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0,
