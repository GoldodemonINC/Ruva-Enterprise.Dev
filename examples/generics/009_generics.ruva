enum Error {
    Active,
    Inactive,
    Pending,
    Complete,
    Failed,
}

impl Error {
    pub fn is_active(&self) -> bool {
        return match self {
            Error::Active => true,
            _ => false,
        }
    }

    pub fn to_string(&self) -> string {
        return match self {
            Error::Active => "Active".into(),
            Error::Inactive => "Inactive".into(),
            Error::Pending => "Pending".into(),
            Error::Complete => "Complete".into(),
            Error::Failed => "Failed".into(),
        }
    }
}


