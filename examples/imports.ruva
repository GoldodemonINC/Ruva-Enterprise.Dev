// ─── Import / Module System Demo ───────────────────────────────────────────
// Demonstrates: use declarations, selective imports, aliases, inline modules,
// file-based modules, and stdlib imports.

// ─── Inline Module ────────────────────────────────────────────────────────

mod math {
    pub fn add(a: i32, b: i32) -> i32 {
        return a + b
    }

    pub fn multiply(a: i32, b: i32) -> i32 {
        return a * b
    }

    pub fn factorial(n: i32) -> i32 {
        if n <= 1 {
            return 1
        }
        return n * factorial(n - 1)
    }

    pub struct Vec2 {
        pub x: f64,
        pub y: f64,
    }

    pub enum Direction {
        North,
        South,
        East,
        West,
    }
}

// ─── Nested Inline Module ─────────────────────────────────────────────────

mod utils {
    pub mod strings {
        pub fn reverse(s: string) -> string {
            return s
        }

        pub fn length(s: string) -> i32 {
            return 0
        }
    }

    pub mod math {
        pub fn square(x: i32) -> i32 {
            return x * x
        }

        pub fn cube(x: i32) -> i32 {
            return x * x * x
        }
    }
}

// ─── File-based Module ────────────────────────────────────────────────────
// mod geometry;  // Would load from geometry.ruva or geometry/mod.ruva

// ─── Use Declarations ─────────────────────────────────────────────────────

use math::add
use math::{multiply, factorial}
use math::Vec2
use utils::strings
use utils::math as umath

// ─── Import (legacy syntax) ───────────────────────────────────────────────

import ruva::core

// ─── Functions using imported items ────────────────────────────────────────

fn main() {
    // Use items from math module
    let sum = add(3, 4)
    let product = multiply(5, 6)
    let fact = factorial(5)

    println!("add(3, 4) = {}", sum)
    println!("multiply(5, 6) = {}", product)
    println!("factorial(5) = {}", fact)

    // Use nested module items
    let sq = umath::square(7)
    let cu = umath::cube(3)
    println!("square(7) = {}", sq)
    println!("cube(3) = {}", cu)

    // Use struct from module
    let v = Vec2 { x: 1.0, y: 2.0 }
    println!("Vec2 created")

    // Use enum from module
    let dir = Direction::North
    println!("Direction created")
}

// ─── Module with methods ──────────────────────────────────────────────────

mod geometry {
    pub struct Point {
        pub x: f64,
        pub y: f64,
    }

    pub struct Line {
        pub start: Point,
        pub end: Point,
    }

    impl Point {
        pub fn new(x: f64, y: f64) -> Point {
            return Point { x, y }
        }

        pub fn distance_to(&self, other: Point) -> f64 {
            let dx = self.x - other.x
            let dy = self.y - other.y
            return (dx * dx + dy * dy)
        }
    }

    impl Line {
        pub fn new(start: Point, end: Point) -> Line {
            return Line { start, end }
        }

        pub fn length(&self) -> f64 {
            return self.start.distance_to(self.end)
        }
    }
}

use geometry::{Point, Line}

fn test_geometry() {
    let p1 = Point::new(0.0, 0.0)
    let p2 = Point::new(3.0, 4.0)
    let dist = p1.distance_to(p2)
    println!("distance = {}", dist)

    let line = Line::new(p1, p2)
    let len = line.length()
    println!("line length = {}", len)
}
