enum Event {
    Active(i64),
    Inactive,
    Pending(i64),
    Complete,
}

impl Event {
    pub fn is_active(&self) -> bool {
        return match self {
            Event::Active => true,
            _ => false,
        }
    }

    pub fn to_string(&self) -> string {
        return match self {
            Event::Active => "Active".into(),
            Event::Inactive => "Inactive".into(),
            Event::Pending => "Pending".into(),
            Event::Complete => "Complete".into(),
            Event::Failed => "Failed".into(),
        }
    }
}


