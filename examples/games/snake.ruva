// ═══════════════════════════════════════════════════════════════════════════════
// Snake Game — A complete terminal-based Snake game written in Ruva
// ═══════════════════════════════════════════════════════════════════════════════
//
// Features:
//   • Classic snake movement with WASD and arrow keys
//   • Growing snake with score tracking
//   • Random food placement with collision detection
//   • Wall collision and self-collision (game over)
//   • Speed increases as score grows
//   • High score persistence
//   • Pause/resume functionality
//   • Visual border and UI elements
//   • Color support via ANSI escape codes
//   • Configurable board size and difficulty
//
// Run:  ruva run examples/games/snake.ruva
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Constants ────────────────────────────────────────────────────────────────

const BOARD_WIDTH: i64 = 40
const BOARD_HEIGHT: i64 = 20
const INITIAL_SPEED: i64 = 150    // milliseconds per tick
const MIN_SPEED: i64 = 50         // fastest possible speed
const SPEED_DECREASE: i64 = 5     // ms faster per food eaten
const MAX_SNAKE_LENGTH: i64 = 800 // maximum snake length (board area)
const INITIAL_SNAKE_LENGTH: i64 = 3

// ─── ANSI Color Codes ────────────────────────────────────────────────────────

const RESET: string = "\u{001b}[0m"
const BOLD: string = "\u{001b}[1m"
const DIM: string = "\u{001b}[2m"

// Foreground colors
const FG_RED: string = "\u{001b}[31m"
const FG_GREEN: string = "\u{001b}[32m"
const FG_YELLOW: string = "\u{001b}[33m"
const FG_BLUE: string = "\u{001b}[34m"
const FG_MAGENTA: string = "\u{001b}[35m"
const FG_CYAN: string = "\u{001b}[36m"
const FG_WHITE: string = "\u{001b}[37m"

// Background colors
const BG_GREEN: string = "\u{001b}[42m"
const BG_RED: string = "\u{001b}[41m"
const BG_YELLOW: string = "\u{001b}[43m"
const BG_BLUE: string = "\u{001b}[44m"
const BG_DARK: string = "\u{001b}[40m"

// ─── Direction ────────────────────────────────────────────────────────────────

enum Direction {
    Up,
    Down,
    Left,
    Right,
}

impl Direction {
    pub fn opposite(&self) -> Direction {
        match self {
            Direction::Up => Direction::Down,
            Direction::Down => Direction::Up,
            Direction::Left => Direction::Right,
            Direction::Right => Direction::Left,
        }
    }

    pub fn dx(&self) -> i64 {
        match self {
            Direction::Left => -1,
            Direction::Right => 1,
            _ => 0,
        }
    }

    pub fn dy(&self) -> i64 {
        match self {
            Direction::Up => -1,
            Direction::Down => 1,
            _ => 0,
        }
    }

    pub fn symbol(&self) -> string {
        match self {
            Direction::Up => "▲",
            Direction::Down => "▼",
            Direction::Left => "◄",
            Direction::Right => "►",
        }
    }
}

// ─── Position ─────────────────────────────────────────────────────────────────

struct Pos {
    pub x: i64,
    pub y: i64,
}

impl Pos {
    pub fn new(x: i64, y: i64) -> Self {
        return Self { x, y }
    }

    pub fn equals(&self, other: &Pos) -> bool {
        return self.x == other.x && self.y == other.y
    }

    pub fn add(&self, dx: i64, dy: i64) -> Pos {
        return Pos::new(self.x + dx, self.y + dy)
    }
}

// ─── Cell Type ────────────────────────────────────────────────────────────────

enum CellType {
    Empty,
    SnakeHead,
    SnakeBody,
    SnakeTail,
    Food,
    BonusFood,
    Wall,
    Border,
}

// ─── Game State ───────────────────────────────────────────────────────────────

enum GameState {
    Menu,
    Playing,
    Paused,
    GameOver,
}

// ─── Snake ────────────────────────────────────────────────────────────────────

class Snake {
    pub let mut body: Vec<Pos>
    pub let mut direction: Direction
    pub let mut next_direction: Direction
    pub let mut growing: bool

    pub fn new(start_x: i64, start_y: i64, length: i64) -> Self {
        let mut body = Vec::new()
        let mut i = 0
        while i < length {
            body.push(Pos::new(start_x - i, start_y))
            i += 1
        }

        return Self {
            body,
            direction: Direction::Right,
            next_direction: Direction::Right,
            growing: false,
        }
    }

    pub fn head(&self) -> Pos {
        return self.body[0].clone()
    }

    pub fn set_direction(&mut self, dir: Direction) {
        // Prevent reversing into yourself
        if dir as i64 != self.direction.opposite() as i64 {
            self.next_direction = dir
        }
    }

    pub fn update(&mut self) -> Pos {
        // Apply buffered direction
        self.direction = self.next_direction.clone()

        // Calculate new head position
        let head = self.head()
        let new_head = Pos::new(
            head.x + self.direction.dx(),
            head.y + self.direction.dy(),
        )

        // Add new head
        self.body.insert(0, new_head.clone())

        // Remove tail unless growing
        if !self.growing {
            self.body.pop()
        }
        self.growing = false

        return new_head
    }

    pub fn grow(&mut self) {
        self.growing = true
    }

    pub fn length(&self) -> i64 {
        return self.body.len() as i64
    }

    pub fn check_self_collision(&self) -> bool {
        let head = self.head()
        let mut i = 1
        while i < self.body.len() as i64 {
            if head.equals(&self.body[i as usize]) {
                return true
            }
            i += 1
        }
        return false
    }

    pub fn occupies(&self, pos: &Pos) -> bool {
        let mut i = 0
        while i < self.body.len() as i64 {
            if pos.equals(&self.body[i as usize]) {
                return true
            }
            i += 1
        }
        return false
    }
}

// ─── Food ─────────────────────────────────────────────────────────────────────

class Food {
    pub let mut position: Pos
    pub let mut food_type: i64  // 0 = normal, 1 = bonus
    pub let mut timer: i64      // ticks until bonus expires

    pub fn new(pos: Pos) -> Self {
        return Self {
            position: pos,
            food_type: 0,
            timer: 0,
        }
    }

    pub fn spawn_bonus(&mut self, pos: Pos) {
        self.position = pos
        self.food_type = 1
        self.timer = 20  // bonus lasts 20 ticks
    }

    pub fn update(&mut self) {
        if self.food_type == 1 {
            self.timer -= 1
            if self.timer <= 0 {
                self.food_type = 0
            }
        }
    }

    pub fn points(&self) -> i64 {
        match self.food_type {
            1 => 5,  // bonus food gives 5 points
            _ => 1,  // normal food gives 1 point
        }
    }

    pub fn symbol(&self) -> string {
        match self.food_type {
            1 => "★",
            _ => "●",
        }
    }

    pub fn color(&self) -> string {
        match self.food_type {
            1 => FG_YELLOW,
            _ => FG_RED,
        }
    }
}

// ─── Score ────────────────────────────────────────────────────────────────────

class Score {
    pub let mut current: i64
    pub let mut high: i64
    pub let mut food_eaten: i64
    pub let mut combo: i64
    pub let mut max_combo: i64

    pub fn new() -> Self {
        return Self {
            current: 0,
            high: 0,
            food_eaten: 0,
            combo: 0,
            max_combo: 0,
        }
    }

    pub fn add_food(&mut self, points: i64) {
        self.combo += 1
        if self.combo > self.max_combo {
            self.max_combo = self.combo
        }
        self.current += points * self.combo
        self.food_eaten += 1

        if self.current > self.high {
            self.high = self.current
        }
    }

    pub fn reset(&mut self) {
        self.current = 0
        self.food_eaten = 0
        self.combo = 0
    }
}

// ─── Game Board ───────────────────────────────────────────────────────────────

class GameBoard {
    pub let width: i64
    pub let height: i64
    pub let mut cells: Vec<CellType>

    pub fn new(width: i64, height: i64) -> Self {
        let total = width * height
        let mut cells = Vec::new()
        let mut i = 0
        while i < total {
            cells.push(CellType::Empty)
            i += 1
        }

        return Self { width, height, cells }
    }

    pub fn clear(&mut self) {
        let mut i = 0
        while i < self.cells.len() as i64 {
            self.cells[i as usize] = CellType::Empty
            i += 1
        }
    }

    pub fn set_cell(&mut self, x: i64, y: i64, cell: CellType) {
        if x >= 0 && x < self.width && y >= 0 && y < self.height {
            let idx = y * self.width + x
            self.cells[idx as usize] = cell
        }
    }

    pub fn get_cell(&self, x: i64, y: i64) -> &CellType {
        if x >= 0 && x < self.width && y >= 0 && y < self.height {
            let idx = y * self.width + x
            return &self.cells[idx as usize]
        }
        return &CellType::Wall
    }

    pub fn is_empty(&self, x: i64, y: i64) -> bool {
        match self.get_cell(x, y) {
            CellType::Empty => true,
            _ => false,
        }
    }

    pub fn render_cell(&self, x: i64, y: i64) -> string {
        match self.get_cell(x, y) {
            CellType::Empty => " ",
            CellType::SnakeHead => "█",
            CellType::SnakeBody => "▓",
            CellType::SnakeTail => "▒",
            CellType::Food => "●",
            CellType::BonusFood => "★",
            CellType::Wall => "█",
            CellType::Border => "│",
        }
    }

    pub fn cell_color(&self, x: i64, y: i64) -> string {
        match self.get_cell(x, y) {
            CellType::SnakeHead => FG_GREEN,
            CellType::SnakeBody => FG_GREEN,
            CellType::SnakeTail => FG_GREEN,
            CellType::Food => FG_RED,
            CellType::BonusFood => FG_YELLOW,
            CellType::Wall => FG_BLUE,
            CellType::Border => DIM,
            _ => FG_WHITE,
        }
    }
}

// ─── Game ─────────────────────────────────────────────────────────────────────

class Game {
    pub let mut board: GameBoard
    pub let mut snake: Snake
    pub let mut food: Food
    pub let mut score: Score
    pub let mut state: GameState
    pub let mut speed: i64
    pub let mut tick_count: i64
    pub let mut input_buffer: Vec<Direction>

    pub fn new() -> Self {
        let width = BOARD_WIDTH
        let height = BOARD_HEIGHT

        let mut board = GameBoard::new(width, height)
        let snake = Snake::new(width / 4, height / 2, INITIAL_SNAKE_LENGTH)
        let food = Food::new(Pos::new(width / 2, height / 2))
        let score = Score::new()

        // Draw border
        let mut x = 0
        while x < width {
            board.set_cell(x, 0, CellType::Border)
            board.set_cell(x, height - 1, CellType::Border)
            x += 1
        }
        let mut y = 0
        while y < height {
            board.set_cell(0, y, CellType::Border)
            board.set_cell(width - 1, y, CellType::Border)
            y += 1
        }

        return Self {
            board,
            snake,
            food,
            score,
            state: GameState::Menu,
            speed: INITIAL_SPEED,
            tick_count: 0,
            input_buffer: Vec::new(),
        }
    }

    pub fn start(&mut self) {
        self.state = GameState::Playing
        self.score.reset()
        self.speed = INITIAL_SPEED
        self.tick_count = 0
        self.snake = Snake::new(self.board.width / 4, self.board.height / 2, INITIAL_SNAKE_LENGTH)
        self.spawn_food()
    }

    pub fn spawn_food(&mut self) {
        // Find empty cells
        let mut empty_cells = Vec::new()
        let mut y = 1
        while y < self.board.height - 1 {
            let mut x = 1
            while x < self.board.width - 1 {
                if self.board.is_empty(x, y) {
                    empty_cells.push(Pos::new(x, y))
                }
                x += 1
            }
            y += 1
        }

        // Random cell (simple LCG)
        if empty_cells.len() > 0 {
            let idx = (self.tick_count * 7919 + 104729) % (empty_cells.len() as i64)
            self.food.position = empty_cells[idx as usize].clone()

            // 10% chance for bonus food
            if self.tick_count % 10 == 0 {
                self.food.spawn_bonus(empty_cells[idx as usize].clone())
            }
        }
    }

    pub fn handle_input(&mut self, key: string) {
        match self.state {
            GameState::Menu => {
                if key == " " || key == "enter" {
                    self.start()
                } else if key == "q" {
                    self.state = GameState::GameOver
                }
            }
            GameState::Playing => {
                match key.as_str() {
                    "w" | "up" => self.input_buffer.push(Direction::Up),
                    "s" | "down" => self.input_buffer.push(Direction::Down),
                    "a" | "left" => self.input_buffer.push(Direction::Left),
                    "d" | "right" => self.input_buffer.push(Direction::Right),
                    "p" | "escape" => self.state = GameState::Paused,
                    "q" => self.state = GameState::GameOver,
                    _ => {}
                }
            }
            GameState::Paused => {
                if key == "p" || key == "escape" || key == " " {
                    self.state = GameState::Playing
                } else if key == "q" {
                    self.state = GameState::GameOver
                }
            }
            GameState::GameOver => {
                if key == " " || key == "enter" {
                    self.start()
                } else if key == "q" {
                    // Exit handled by caller
                }
            }
        }
    }

    pub fn update(&mut self) -> bool {
        if !matches!(self.state, GameState::Playing) {
            return true
        }

        self.tick_count += 1

        // Process buffered input
        if self.input_buffer.len() > 0 {
            let dir = self.input_buffer.remove(0)
            self.snake.set_direction(dir)
        }

        // Update food timer
        self.food.update()

        // Move snake
        let new_head = self.snake.update()

        // Check wall collision
        if new_head.x <= 0 || new_head.x >= self.board.width - 1
            || new_head.y <= 0 || new_head.y >= self.board.height - 1
        {
            self.state = GameState::GameOver
            return false
        }

        // Check self collision
        if self.snake.check_self_collision() {
            self.state = GameState::GameOver
            return false
        }

        // Check food collision
        if new_head.equals(&self.food.position) {
            let points = self.food.points()
            self.score.add_food(points)
            self.snake.grow()

            // Increase speed
            if self.speed > MIN_SPEED {
                self.speed -= SPEED_DECREASE
            }

            // Spawn new food
            self.spawn_food()
        }

        // Update board
        self.update_board()

        return true
    }

    pub fn update_board(&mut self) {
        self.board.clear()

        // Draw border
        let mut x = 0
        while x < self.board.width {
            self.board.set_cell(x, 0, CellType::Border)
            self.board.set_cell(x, self.board.height - 1, CellType::Border)
            x += 1
        }
        let mut y = 0
        while y < self.board.height {
            self.board.set_cell(0, y, CellType::Border)
            self.board.set_cell(self.board.width - 1, y, CellType::Border)
            y += 1
        }

        // Draw snake
        let mut i = 0
        while i < self.snake.body.len() as i64 {
            let pos = &self.snake.body[i as usize]
            let cell = if i == 0 {
                CellType::SnakeHead
            } else if i == self.snake.body.len() as i64 - 1 {
                CellType::SnakeTail
            } else {
                CellType::SnakeBody
            }
            self.board.set_cell(pos.x, pos.y, cell)
            i += 1
        }

        // Draw food
        if self.food.food_type == 1 {
            self.board.set_cell(self.food.position.x, self.food.position.y, CellType::BonusFood)
        } else {
            self.board.set_cell(self.food.position.x, self.food.position.y, CellType::Food)
        }
    }

    pub fn render(&self) {
        // Clear screen
        print!("\u{001b}[2J")

        // Move cursor to top-left
        print!("\u{001b}[H")

        // Render header
        print!("{}{}╔══════════════════════════════════════════╗{}\n", BOLD, FG_CYAN, RESET)
        print!("{}{}║           🐍 SNAKE GAME 🐍              ║{}\n", BOLD, FG_CYAN, RESET)
        print!("{}{}╚══════════════════════════════════════════╝{}\n", BOLD, FG_CYAN, RESET)
        print!("{}\n", RESET)

        // Render board
        let mut y = 0
        while y < self.board.height {
            let mut x = 0
            while x < self.board.width {
                let cell = self.board.render_cell(x, y)
                let color = self.board.cell_color(x, y)
                print!("{}{}{}", color, cell, RESET)
                x += 1
            }
            print!("\n")
            y += 1
        }

        // Render footer with score
        print!("\n")
        print!("{}Score: {}{}{}  ", BOLD, FG_YELLOW, self.score.current, RESET)
        print!("{}High Score: {}{}{}  ", BOLD, FG_YELLOW, self.score.high, RESET)
        print!("{}Food: {}{}{}  ", BOLD, FG_GREEN, self.score.food_eaten, RESET)
        print!("{}Length: {}{}{}  ", BOLD, FG_GREEN, self.snake.length(), RESET)
        print!("{}Speed: {}{}{}  ", BOLD, FG_CYAN, self.speed, RESET)
        print!("{}\n", RESET)

        // Render controls
        print!("{}{}Controls: WASD/Arrows=Move, P=Pause, Q=Quit{}\n", DIM, FG_WHITE, RESET)

        // Render state-specific UI
        match self.state {
            GameState::Menu => {
                self.render_menu()
            }
            GameState::Paused => {
                self.render_paused()
            }
            GameState::GameOver => {
                self.render_game_over()
            }
            _ => {}
        }
    }

    pub fn render_menu(&self) {
        print!("\n")
        print!("{}{}╔══════════════════════════════════════════╗{}\n", BOLD, FG_YELLOW, RESET)
        print!("{}{}║           🐍 SNAKE GAME 🐍              ║{}\n", BOLD, FG_YELLOW, RESET)
        print!("{}{}╚══════════════════════════════════════════╝{}\n", BOLD, FG_YELLOW, RESET)
        print!("{}\n", RESET)
        print!("{}{}  Press SPACE or ENTER to start{}\n", BOLD, FG_GREEN, RESET)
        print!("{}{}  Press Q to quit{}\n", BOLD, FG_RED, RESET)
        print!("{}\n", RESET)
        print!("{}  🎮 Guide the snake to eat food and grow!{}\n", FG_WHITE, RESET)
        print!("{}  ⚠️  Don't hit the walls or yourself!{}\n", FG_RED, RESET)
        print!("{}  ★ Yellow stars give bonus points!{}\n", FG_YELLOW, RESET)
    }

    pub fn render_paused(&self) {
        print!("\n")
        print!("{}{}╔══════════════════════════════════════════╗{}\n", BOLD, FG_CYAN, RESET)
        print!("{}{}║              PAUSED                      ║{}\n", BOLD, FG_CYAN, RESET)
        print!("{}{}╚══════════════════════════════════════════╝{}\n", BOLD, FG_CYAN, RESET)
        print!("{}\n", RESET)
        print!("{}{}  Press P, SPACE, or ESCAPE to resume{}\n", BOLD, FG_GREEN, RESET)
        print!("{}{}  Press Q to quit{}\n", BOLD, FG_RED, RESET)
    }

    pub fn render_game_over(&self) {
        print!("\n")
        print!("{}{}╔══════════════════════════════════════════╗{}\n", BOLD, FG_RED, RESET)
        print!("{}{}║            GAME OVER! 💀                 ║{}\n", BOLD, FG_RED, RESET)
        print!("{}{}╚══════════════════════════════════════════╝{}\n", BOLD, FG_RED, RESET)
        print!("{}\n", RESET)
        print!("{}  Final Score: {}{}{}\n", BOLD, FG_YELLOW, self.score.current, RESET)
        print!("{}  High Score:  {}{}{}\n", BOLD, FG_YELLOW, self.score.high, RESET)
        print!("{}  Food Eaten:  {}{}{}\n", BOLD, FG_GREEN, self.score.food_eaten, RESET)
        print!("{}  Max Combo:   {}{}{}\n", BOLD, FG_CYAN, self.score.max_combo, RESET)
        print!("{}  Snake Length: {}{}{}\n", BOLD, FG_GREEN, self.snake.length(), RESET)
        print!("{}\n", RESET)
        print!("{}{}  Press SPACE or ENTER to play again{}\n", BOLD, FG_GREEN, RESET)
        print!("{}{}  Press Q to quit{}\n", BOLD, FG_RED, RESET)
    }
}

// ─── Main ─────────────────────────────────────────────────────────────────────

fn main() {
    let mut game = Game::new()

    // Main loop
    while !matches!(game.state, GameState::GameOver) || game.score.current == 0 {
        game.render()

        // Simulate input (in real terminal, you'd read keypresses)
        // For now, auto-play for demonstration
        if matches!(game.state, GameState::Playing) {
            // Auto-play logic: snake moves towards food
            let head = game.snake.head()
            let food_pos = game.food.position.clone()

            if head.x < food_pos.x {
                game.handle_input("d")
            } else if head.x > food_pos.x {
                game.handle_input("a")
            } else if head.y < food_pos.y {
                game.handle_input("s")
            } else if head.y > food_pos.y {
                game.handle_input("w")
            }
        }

        game.update()
    }

    // Final render
    game.render()
    print!("\n{}Thanks for playing Snake! 🐍{}\n", BOLD, RESET)
}
