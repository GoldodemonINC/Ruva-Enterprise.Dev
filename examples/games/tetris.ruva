// ═══════════════════════════════════════════════════════════════════════════════
// Tetris Game — A classic Tetris game written in Ruva
// ═══════════════════════════════════════════════════════════════════════════════
//
// Features:
//   • All 7 classic Tetromino pieces (I, O, T, S, Z, J, L)
//   • Rotation, movement, and hard drop
//   • Line clearing with scoring
   • Level system with increasing speed
   • Next piece preview
   • Hold piece functionality
   • Ghost piece (shows where piece will land)
   • High score tracking
//
// Run:  ruva run examples/games/tetris.ruva
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Constants ────────────────────────────────────────────────────────────────

const BOARD_WIDTH: i64 = 10
const BOARD_HEIGHT: i64 = 20
const BLOCK_SIZE: i64 = 2
const TICK_RATE: i64 = 100
const LINES_PER_LEVEL: i64 = 10
const MAX_LEVEL: i64 = 15

// ─── ANSI Colors ──────────────────────────────────────────────────────────────

const RESET: string = "\u{001b}[0m"
const BOLD: string = "\u{001b}[1m"
const DIM: string = "\u{001b}[2m"

const FG_WHITE: string = "\u{001b}[37m"
const FG_CYAN: string = "\u{001b}[36m"
const FG_YELLOW: string = "\u{001b}[33m"
const FG_GREEN: string = "\u{001b}[32m"
const FG_RED: string = "\u{001b}[31m"
const FG_BLUE: string = "\u{001b}[34m"
const FG_MAGENTA: string = "\u{001b}[35m"

const BG_DARK: string = "\u{001b}[40m"

// ─── Tetromino Types ──────────────────────────────────────────────────────────

enum PieceType {
    I, O, T, S, Z, J, L,
}

impl PieceType {
    pub fn color(&self) -> string {
        match self {
            PieceType::I => FG_CYAN,
            PieceType::O => FG_YELLOW,
            PieceType::T => FG_MAGENTA,
            PieceType::S => FG_GREEN,
            PieceType::Z => FG_RED,
            PieceType::J => FG_BLUE,
            PieceType::L => "\u{001b}[38;5;208m",  // Orange
        }
    }

    pub fn symbol(&self) -> string {
        match self {
            PieceType::I => "█",
            PieceType::O => "█",
            PieceType::T => "█",
            PieceType::S => "█",
            PieceType::Z => "█",
            PieceType::J => "█",
            PieceType::L => "█",
        }
    }
}

// ─── Tetromino Shapes ─────────────────────────────────────────────────────────

struct Shape {
    pub cells: Vec<(i64, i64)>,
    pub width: i64,
    pub height: i64,
}

impl Shape {
    pub fn new(cells: Vec<(i64, i64)>, width: i64, height: i64) -> Self {
        return Self { cells, width, height }
    }

    pub fn rotate(&self) -> Shape {
        // Rotate 90 degrees clockwise
        let mut new_cells = Vec::new()
        for (x, y) in &self.cells {
            new_cells.push((*y, self.width - 1 - *x))
        }
        return Shape::new(new_cells, self.height, self.width)
    }

    pub fn get_cells(&self, x: i64, y: i64) -> Vec<(i64, i64)> {
        let mut result = Vec::new()
        for (cx, cy) in &self.cells {
            result.push((x + cx, y + cy))
        }
        return result
    }
}

// ─── Tetromino ────────────────────────────────────────────────────────────────

struct Tetromino {
    pub piece_type: PieceType,
    pub shape: Shape,
    pub x: i64,
    pub y: i64,
    pub rotation: i64,
}

impl Tetromino {
    pub fn new(piece_type: PieceType) -> Self {
        let shape = match piece_type {
            PieceType::I => Shape::new(vec![(0,1),(1,1),(2,1),(3,1)], 4, 4),
            PieceType::O => Shape::new(vec![(1,0),(2,0),(1,1),(2,1)], 4, 4),
            PieceType::T => Shape::new(vec![(1,0),(0,1),(1,1),(2,1)], 3, 3),
            PieceType::S => Shape::new(vec![(1,0),(2,0),(0,1),(1,1)], 3, 3),
            PieceType::Z => Shape::new(vec![(0,0),(1,0),(1,1),(2,1)], 3, 3),
            PieceType::J => Shape::new(vec![(0,0),(0,1),(1,1),(2,1)], 3, 3),
            PieceType::L => Shape::new(vec![(2,0),(0,1),(1,1),(2,1)], 3, 3),
        }

        return Self {
            piece_type,
            shape,
            x: BOARD_WIDTH / 2 - 2,
            y: 0,
            rotation: 0,
        }
    }

    pub fn get_cells(&self) -> Vec<(i64, i64)> {
        return self.shape.get_cells(self.x, self.y)
    }

    pub fn rotate(&self) -> Tetromino {
        return Tetromino {
            piece_type: self.piece_type.clone(),
            shape: self.shape.rotate(),
            x: self.x,
            y: self.y,
            rotation: (self.rotation + 1) % 4,
        }
    }
}

// ─── Game Board ───────────────────────────────────────────────────────────────

class GameBoard {
    pub let width: i64
    pub let height: i64
    pub let mut cells: Vec<Option<PieceType>>

    pub fn new(width: i64, height: i64) -> Self {
        let total = width * height
        let mut cells = Vec::new()
        let mut i = 0
        while i < total {
            cells.push(None)
            i += 1
        }
        return Self { width, height, cells }
    }

    pub fn get_cell(&self, x: i64, y: i64) -> &Option<PieceType> {
        if x >= 0 && x < self.width && y >= 0 && y < self.height {
            let idx = y * self.width + x
            return &self.cells[idx as usize]
        }
        return &None
    }

    pub fn set_cell(&mut self, x: i64, y: i64, piece: Option<PieceType>) {
        if x >= 0 && x < self.width && y >= 0 && y < self.height {
            let idx = y * self.width + x
            self.cells[idx as usize] = piece
        }
    }

    pub fn is_empty(&self, x: i64, y: i64) -> bool {
        return self.get_cell(x, y).is_none()
    }

    pub fn is_valid_position(&self, cells: &Vec<(i64, i64)>) -> bool {
        for (x, y) in cells {
            if *x < 0 || *x >= self.width || *y >= self.height {
                return false
            }
            if *y >= 0 && !self.is_empty(*x, *y) {
                return false
            }
        }
        return true
    }

    pub fn place_piece(&mut self, piece: &Tetromino) {
        for (x, y) in piece.get_cells() {
            self.set_cell(x, y, Some(piece.piece_type.clone()))
        }
    }

    pub fn clear_lines(&mut self) -> i64 {
        let mut lines_cleared = 0
        let mut y = self.height - 1
        while y >= 0 {
            let mut full = true
            let mut x = 0
            while x < self.width {
                if self.is_empty(x, y) {
                    full = false
                    break
                }
                x += 1
            }

            if full {
                // Move all lines above down
                let mut move_y = y
                while move_y > 0 {
                    let mut x = 0
                    while x < self.width {
                        let idx_above = (move_y - 1) * self.width + x
                        let idx_here = move_y * self.width + x
                        self.cells[idx_here as usize] = self.cells[idx_above as usize].clone()
                        x += 1
                    }
                    move_y -= 1
                }
                // Clear top line
                let mut x = 0
                while x < self.width {
                    self.set_cell(x, 0, None)
                    x += 1
                }
                lines_cleared += 1
            } else {
                y -= 1
            }
        }
        return lines_cleared
    }

    pub fn render_cell(&self, x: i64, y: i64) -> string {
        match self.get_cell(x, y) {
            Some(piece_type) => {
                let color = piece_type.color()
                format!("{}█{}", color, RESET)
            }
            None => format!("{}·{}", DIM, RESET)
        }
    }
}

// ─── Score System ─────────────────────────────────────────────────────────────

class Score {
    pub let mut points: i64
    pub let mut lines: i64
    pub let mut level: i64
    pub let mut high_score: i64

    pub fn new() -> Self {
        return Self {
            points: 0,
            lines: 0,
            level: 1,
            high_score: 0,
        }
    }

    pub fn add_lines(&mut self, count: i64) {
        self.lines += count

        // Scoring: 100, 300, 500, 800 for 1-4 lines
        let base_score = match count {
            1 => 100,
            2 => 300,
            3 => 500,
            4 => 800,
            _ => 0,
        }

        self.points += base_score * self.level

        // Level up
        let new_level = self.lines / LINES_PER_LEVEL + 1
        if new_level > self.level && new_level <= MAX_LEVEL {
            self.level = new_level
        }

        // Update high score
        if self.points > self.high_score {
            self.high_score = self.points
        }
    }

    pub fn get_speed(&self) -> i64 {
        // Speed decreases with level (faster)
        let base_speed = 1000
        let speed = base_speed - (self.level - 1) * 50
        if speed < 50 {
            return 50
        }
        return speed
    }
}

// ─── Game State ───────────────────────────────────────────────────────────────

enum GameState {
    Menu,
    Playing,
    Paused,
    GameOver,
}

// ─── Game ─────────────────────────────────────────────────────────────────────

class Game {
    pub let mut board: GameBoard
    pub let mut current_piece: Tetromino
    pub let mut next_piece: Tetromino
    pub let mut held_piece: Option<Tetromino>
    pub let mut can_hold: bool
    pub let mut score: Score
    pub let mut state: GameState
    pub let mut tick: i64
    pub let mut drop_timer: i64

    pub fn new() -> Self {
        let mut board = GameBoard::new(BOARD_WIDTH, BOARD_HEIGHT)
        let current_piece = Tetromino::new(PieceType::T)
        let next_piece = Tetromino::new(PieceType::I)

        return Self {
            board,
            current_piece,
            next_piece,
            held_piece: None,
            can_hold: true,
            score: Score::new(),
            state: GameState::Menu,
            tick: 0,
            drop_timer: 0,
        }
    }

    pub fn start(&mut self) {
        self.state = GameState::Playing
        self.score = Score::new()
        self.board = GameBoard::new(BOARD_WIDTH, BOARD_HEIGHT)
        self.spawn_piece()
        self.can_hold = true
        self.held_piece = None
    }

    pub fn spawn_piece(&mut self) {
        self.current_piece = self.next_piece.clone()
        self.next_piece = Tetromino::new(PieceType::T)  // Random in real implementation
        self.can_hold = true

        // Check if game over
        let cells = self.current_piece.get_cells()
        if !self.board.is_valid_position(&cells) {
            self.state = GameState::GameOver
        }
    }

    pub fn move_left(&mut self) {
        let new_piece = Tetromino {
            x: self.current_piece.x - 1,
            ..self.current_piece
        }
        let cells = new_piece.get_cells()
        if self.board.is_valid_position(&cells) {
            self.current_piece.x -= 1
        }
    }

    pub fn move_right(&mut self) {
        let new_piece = Tetromino {
            x: self.current_piece.x + 1,
            ..self.current_piece
        }
        let cells = new_piece.get_cells()
        if self.board.is_valid_position(&cells) {
            self.current_piece.x += 1
        }
    }

    pub fn move_down(&mut self) -> bool {
        let new_piece = Tetromino {
            y: self.current_piece.y + 1,
            ..self.current_piece
        }
        let cells = new_piece.get_cells()
        if self.board.is_valid_position(&cells) {
            self.current_piece.y += 1
            return true
        }
        return false
    }

    pub fn rotate(&mut self) {
        let rotated = self.current_piece.rotate()
        let cells = rotated.get_cells()
        if self.board.is_valid_position(&cells) {
            self.current_piece = rotated
        }
    }

    pub fn hard_drop(&mut self) {
        while self.move_down() {
            self.score.points += 2
        }
        self.lock_piece()
    }

    pub fn lock_piece(&mut self) {
        self.board.place_piece(&self.current_piece)
        let lines = self.board.clear_lines()
        self.score.add_lines(lines)
        self.spawn_piece()
    }

    pub fn hold_piece(&mut self) {
        if !self.can_hold {
            return
        }

        match &self.held_piece {
            Some(held) => {
                let new_held = self.current_piece.clone()
                self.current_piece = held.clone()
                self.held_piece = Some(new_held)
            }
            None => {
                self.held_piece = Some(self.current_piece.clone())
                self.spawn_piece()
            }
        }
        self.can_hold = false
    }

    pub fn get_ghost_y(&self) -> i64 {
        let mut ghost_y = self.current_piece.y
        loop {
            let test_cells: Vec<(i64, i64)> = self.current_piece.shape.get_cells(
                self.current_piece.x,
                ghost_y + 1,
            )
            if !self.board.is_valid_position(&test_cells) {
                break
            }
            ghost_y += 1
        }
        return ghost_y
    }

    pub fn update(&mut self) {
        if !matches!(self.state, GameState::Playing) {
            return
        }

        self.tick += 1
        self.drop_timer += 1

        // Auto-drop based on level speed
        let speed = self.score.get_speed() / TICK_RATE
        if self.drop_timer >= speed {
            self.drop_timer = 0
            if !self.move_down() {
                self.lock_piece()
            }
        }
    }

    pub fn render(&self) {
        // Clear screen
        print!("\u{001b}[2J\u{001b}[H")

        // Header
        print!("{}{}╔══════════════════════════════════════════╗{}\n", BOLD, FG_CYAN, RESET)
        print!("{}{}║           TETRIS GAME 🎮                ║{}\n", BOLD, FG_CYAN, RESET)
        print!("{}{}╚══════════════════════════════════════════╝{}\n", BOLD, FG_CYAN, RESET)
        print!("{}\n", RESET)

        // Create display buffer
        let mut display = Vec::new()
        let mut y = 0
        while y < BOARD_HEIGHT {
            let mut row = Vec::new()
            let mut x = 0
            while x < BOARD_WIDTH {
                row.push(self.board.render_cell(x, y))
                x += 1
            }
            display.push(row)
            y += 1
        }

        // Draw ghost piece
        let ghost_y = self.get_ghost_y()
        let ghost_cells = self.current_piece.shape.get_cells(self.current_piece.x, ghost_y)
        for (x, y) in &ghost_cells {
            if *y >= 0 && *y < BOARD_HEIGHT && *x >= 0 && *x < BOARD_WIDTH {
                if self.board.is_empty(*x, *y) {
                    display[*y as usize][*x as usize] = format!("{}◇{}", DIM, RESET)
                }
            }
        }

        // Draw current piece
        let cells = self.current_piece.get_cells()
        let color = self.current_piece.piece_type.color()
        for (x, y) in &cells {
            if *y >= 0 && *y < BOARD_HEIGHT && *x >= 0 && *x < BOARD_WIDTH {
                display[*y as usize][*x as usize] = format!("{}█{}", color, RESET)
            }
        }

        // Render board with side panels
        let mut y = 0
        while y < BOARD_HEIGHT {
            // Left panel (held piece)
            let left_panel = if y == 1 {
                format!("{} Held: {}", BOLD, RESET)
            } else if y == 2 {
                match &self.held_piece {
                    Some(piece) => {
                        let color = piece.piece_type.color()
                        format!("{}     {}{}", color, piece.piece_type.symbol(), RESET)
                    }
                    None => "     ".to_string(),
                }
            } else {
                "     ".to_string()
            }

            // Right panel (next piece)
            let right_panel = if y == 1 {
                format!(" {}Next:{}", BOLD, RESET)
            } else if y == 2 {
                let color = self.next_piece.piece_type.color()
                format!(" {}  {}{}", color, self.next_piece.piece_type.symbol(), RESET)
            } else if y == 4 {
                format!("{}Level: {}{}", BOLD, self.score.level, RESET)
            } else if y == 5 {
                format!("{}Lines: {}{}", BOLD, self.score.lines, RESET)
            } else if y == 7 {
                format!("{}Score:{}", BOLD, RESET)
            } else if y == 8 {
                format!("{} {}{}", FG_YELLOW, self.score.points, RESET)
            } else if y == 10 {
                format!("{}High:{}", BOLD, RESET)
            } else if y == 11 {
                format!("{} {}{}", FG_YELLOW, self.score.high_score, RESET)
            } else {
                "     ".to_string()
            }

            // Board row
            let mut board_row = String::new()
            let mut x = 0
            while x < BOARD_WIDTH {
                board_row.push_str(&display[y as usize][x as usize])
                x += 1
            }

            print!("{} │{}│ {}\n", left_panel, board_row, right_panel)
            y += 1
        }

        // Bottom border
        print!("{} └{}┘ {}\n", "     ", "────────────────────", "     ")

        // Controls
        print!("\n")
        print!("{}  Controls:{}\n", BOLD, RESET)
        print!("{}  ← → : Move   ↑ : Rotate   ↓ : Soft Drop{}\n", FG_WHITE, RESET)
        print!("{}  Space : Hard Drop   C : Hold   P : Pause   Q : Quit{}\n", FG_WHITE, RESET)

        // State-specific UI
        match self.state {
            GameState::Menu => {
                self.render_menu()
            }
            GameState::Paused => {
                self.render_paused()
            }
            GameState::GameOver => {
                self.render_game_over()
            }
            _ => {}
        }
    }

    pub fn render_menu(&self) {
        print!("\n")
        print!("{}{}╔══════════════════════════════════════════╗{}\n", BOLD, FG_YELLOW, RESET)
        print!("{}{}║           TETRIS GAME 🎮                ║{}\n", BOLD, FG_YELLOW, RESET)
        print!("{}{}╚══════════════════════════════════════════╝{}\n", BOLD, FG_YELLOW, RESET)
        print!("{}\n", RESET)
        print!("{}  Press SPACE or ENTER to start{}\n", BOLD, FG_GREEN, RESET)
        print!("{}  Press Q to quit{}\n", BOLD, FG_RED, RESET)
    }

    pub fn render_paused(&self) {
        print!("\n")
        print!("{}{}╔══════════════════════════════════════════╗{}\n", BOLD, FG_CYAN, RESET)
        print!("{}{}║              PAUSED ⏸️                   ║{}\n", BOLD, FG_CYAN, RESET)
        print!("{}{}╚══════════════════════════════════════════╝{}\n", BOLD, FG_CYAN, RESET)
        print!("{}\n", RESET)
        print!("{}  Press P or ESCAPE to resume{}\n", BOLD, FG_GREEN, RESET)
    }

    pub fn render_game_over(&self) {
        print!("\n")
        print!("{}{}╔══════════════════════════════════════════╗{}\n", BOLD, FG_RED, RESET)
        print!("{}{}║            GAME OVER! 💀                 ║{}\n", BOLD, FG_RED, RESET)
        print!("{}{}╚══════════════════════════════════════════╝{}\n", BOLD, FG_RED, RESET)
        print!("{}\n", RESET)
        print!("{}  Final Score: {}{}{}\n", BOLD, FG_YELLOW, self.score.points, RESET)
        print!("{}  Lines Cleared: {}{}{}\n", BOLD, FG_GREEN, self.score.lines, RESET)
        print!("{}  Level Reached: {}{}{}\n", BOLD, FG_CYAN, self.score.level, RESET)
        print!("{}\n", RESET)
        print!("{}  Press SPACE or ENTER to play again{}\n", BOLD, FG_GREEN, RESET)
        print!("{}  Press Q to quit{}\n", BOLD, FG_RED, RESET)
    }
}

// ─── Main ─────────────────────────────────────────────────────────────────────

fn main() {
    let mut game = Game::new()

    // Main game loop
    while !matches!(game.state, GameState::GameOver) || game.score.points == 0 {
        game.render()
        game.update()
    }

    // Final render
    game.render()
    print!("\n{}Thanks for playing Tetris! 🎮{}\n", BOLD, RESET)
}
