enum Mode {
    Active,
    Inactive,
    Pending,
    Complete,
    Failed,
}

impl Mode {
    pub fn is_active(&self) -> bool {
        return match self {
            Mode::Active => true,
            _ => false,
        }
    }

    pub fn to_string(&self) -> string {
        return match self {
            Mode::Active => "Active".into(),
            Mode::Inactive => "Inactive".into(),
            Mode::Pending => "Pending".into(),
            Mode::Complete => "Complete".into(),
            Mode::Failed => "Failed".into(),
