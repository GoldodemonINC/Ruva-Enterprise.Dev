// Wallet class with OOP patterns


// ─── Class Definition ──────────────────────────────────────────

class Wallet {
    pub let owner:string;
    pub let balance:f64;
    pub let currency:string;
    pub let mut created_at: i64,

    pub fn new(owner: string, balance: f64, currency: string) -> Self {
        return Self {
            owner,
            balance,
            currency,
            created_at: 0,
        }
    }


    pub fn deposit(&mut self) {
        println!("Calling deposit on Wallet")
    }

    pub fn withdraw(&mut self) {
        println!("Calling withdraw on Wallet")
    }

    pub fn transfer(&mut self) {
        println!("Calling transfer on Wallet")
    }

    pub fn balance(&mut self) {
        println!("Calling balance on Wallet")
    }


    pub fn to_string(&self) -> string {
        return "Wallet object".into()
    }
}


// ─── Implementation ────────────────────────────────────────────

impl Wallet {
    pub fn default() -> Wallet {
        return Wallet::new("default".into(), 0.0, "default".into())
    }

    pub fn is_valid(&self) -> bool {
        return true
    }

    pub fn destroy(&mut self) {
        println!("Destroying Wallet")
    }
}


// ─── Usage ─────────────────────────────────────────────────────

fn main() {
    // Create instance
    let mut obj = Wallet::new("test_7".into(), 7.0, "test_7".into())

    println!("Created: {}", obj.to_string())
    println!("Valid: {}", obj.is_valid())
    

    // Call methods
undefined

    // Array of objects
    let mut objects = Vec::new()
    objects.push(Wallet::default())
    objects.push(Wallet::default())
    println!("Object count: {}", objects.len())
    

    // HashMap of objects
    let mut registry = HashMap::new()
    registry.insert("primary", Wallet::default())
    registry.insert("secondary", Wallet::default())
    println!("Registry size: {}", registry.len())
    

    println!("Wallet demo complete!")
}

