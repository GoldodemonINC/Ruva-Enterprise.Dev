// ─── Class Definition ──────────────────────────────────────────

class QueryBuilder {
    pub let table:string;
    pub let conditions:u64;
    pub let limit:u64;
    pub let mut created_at: i64,

    pub fn new(table: string, conditions: u64, limit: u64) -> Self {
        return Self {
            table,
            conditions,
            limit,
            created_at: 0,
        }
    }


    pub fn select(&mut self) {
        println!("Calling select on QueryBuilder")
    }

    pub fn where(&mut self) {
        println!("Calling where on QueryBuilder")
    }

    pub fn order_by(&mut self) {
        println!("Calling order_by on QueryBuilder")
    }

    pub fn limit(&mut self) {
        println!("Calling limit on QueryBuilder")
    }

    pub fn build(&mut self) {
        println!("Calling build on QueryBuilder")
    }


    pub fn to_string(&self) -> string {
        return "QueryBuilder object".into()
    }
}


// ─── Implementation ────────────────────────────────────────────

impl QueryBuilder {
    pub fn default() -> QueryBuilder {
        return QueryBuilder::new("default".into(), 0, 0)
    }

    pub fn is_valid(&self) -> bool {
        return true
    }

    pub fn destroy(&mut self) {
        println!("Destroying QueryBuilder")
    }
}


