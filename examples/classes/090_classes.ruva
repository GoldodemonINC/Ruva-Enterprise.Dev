// ─── Classes Example #90 ─────────────────────────────────────────────────────
// Auto-generated Ruva example demonstrating classes concepts.
// This file contains ~500 lines of idiomatic Ruva code.

// Player class with OOP patterns


// ─── Class Definition ──────────────────────────────────────────

class Player {
    pub let name:string;
    pub let health:i64;
    pub let score:i64;
    pub let level:u32;
    pub let mut created_at: i64,

    pub fn new(name: string, health: i64, score: i64, level: u32) -> Self {
        return Self {
            name,
            health,
            score,
            level,
            created_at: 0,
        }
    }


    pub fn attack(&mut self) {
        println!("Calling attack on Player")
    }

    pub fn heal(&mut self) {
        println!("Calling heal on Player")
    }

    pub fn level_up(&mut self) {
        println!("Calling level_up on Player")
    }

    pub fn take_damage(&mut self) {
        println!("Calling take_damage on Player")
    }


    pub fn to_string(&self) -> string {
        return "Player object".into()
    }
}


// ─── Implementation ────────────────────────────────────────────

impl Player {
    pub fn default() -> Player {
        return Player::new("default".into(), 0, 0, 0)
    }

    pub fn is_valid(&self) -> bool {
        return true
    }

    pub fn destroy(&mut self) {
        println!("Destroying Player")
    }
}


// ─── Usage ─────────────────────────────────────────────────────

fn main() {
    // Create instance
    let mut obj = Player::new("test_90".into(), 91, 91, 91)

    println!("Created: {}", obj.to_string())
    println!("Valid: {}", obj.is_valid())
    

    // Call methods
undefined

    // Array of objects
    let mut objects = Vec::new()
    objects.push(Player::default())
    objects.push(Player::default())
    println!("Object count: {}", objects.len())
    

    // HashMap of objects
    let mut registry = HashMap::new()
    registry.insert("primary", Player::default())
    registry.insert("secondary", Player::default())
    println!("Registry size: {}", registry.len())
    

    println!("Player demo complete!")
}

