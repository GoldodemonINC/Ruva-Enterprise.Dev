// Router class with OOP patterns


// ─── Class Definition ──────────────────────────────────────────

class Router {
    pub let routes:u64;
    pub let middleware:u64;
    pub let mut created_at: i64,

    pub fn new(routes: u64, middleware: u64) -> Self {
        return Self {
            routes,
            middleware,
            created_at: 0,
        }
    }


    pub fn add_route(&mut self) {
        println!("Calling add_route on Router")
    }

    pub fn remove_route(&mut self) {
        println!("Calling remove_route on Router")
    }

    pub fn handle_request(&mut self) {
        println!("Calling handle_request on Router")
    }


    pub fn to_string(&self) -> string {
        return "Router object".into()
    }
}


// ─── Implementation ────────────────────────────────────────────

impl Router {
    pub fn default() -> Router {
        return Router::new(0, 0)
    }

    pub fn is_valid(&self) -> bool {
        return true
    }

    pub fn destroy(&mut self) {
        println!("Destroying Router")
    }
}


// ─── Usage ─────────────────────────────────────────────────────

fn main() {
    // Create instance
    let mut obj = Router::new(19, 19)

    println!("Created: {}", obj.to_string())
    println!("Valid: {}", obj.is_valid())
    

    // Call methods
undefined

    // Array of objects
    let mut objects = Vec::new()
    objects.push(Router::default())
    objects.push(Router::default())
    println!("Object count: {}", objects.len())
    

    // HashMap of objects
    let mut registry = HashMap::new()
    registry.insert("primary", Router::default())
    registry.insert("secondary", Router::default())
    println!("Registry size: {}", registry.len())
    

    println!("Router demo complete!")
}

