class Counter {
    let mut count: i32,

    pub fn new() -> Self {
        return Self { count: 0 }
    }

    pub fn increment(&mut self) {
        self.count += 1
    }

    pub fn decrement(&mut self) {
        self.count -= 1
    }

    pub fn get(&self) -> i32 {
        return self.count
    }

    pub fn reset(&mut self) {
        self.count = 0
    }
}

fn main() {
    let mut c = Counter::new()
    c.increment()
    c.increment()
    c.increment()
    println!("count = {}", c.get())
    c.decrement()
    println!("count = {}", c.get())
}
