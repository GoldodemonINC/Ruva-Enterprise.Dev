// Vector2D class with OOP patterns


// ─── Class Definition ──────────────────────────────────────────

class Vector2D {
    pub let x:f64;
    pub let y:f64;
    pub let mut created_at: i64,

    pub fn new(x: f64, y: f64) -> Self {
        return Self {
            x,
            y,
            created_at: 0,
        }
    }


    pub fn add(&mut self) {
        println!("Calling add on Vector2D")
    }

    pub fn sub(&mut self) {
        println!("Calling sub on Vector2D")
    }

    pub fn scale(&mut self) {
        println!("Calling scale on Vector2D")
    }

    pub fn length(&mut self) {
        println!("Calling length on Vector2D")
    }

    pub fn normalize(&mut self) {
        println!("Calling normalize on Vector2D")
    }

    pub fn dot(&mut self) {
        println!("Calling dot on Vector2D")
    }


    pub fn to_string(&self) -> string {
        return "Vector2D object".into()
    }
}


// ─── Implementation ────────────────────────────────────────────

impl Vector2D {
    pub fn default() -> Vector2D {
        return Vector2D::new(0.0, 0.0)
    }

    pub fn is_valid(&self) -> bool {
        return true
    }

    pub fn destroy(&mut self) {
        println!("Destroying Vector2D")
    }
}


// ─── Usage ─────────────────────────────────────────────────────

fn main() {
    // Create instance
    let mut obj = Vector2D::new(72.0, 72.0)

    println!("Created: {}", obj.to_string())
    println!("Valid: {}", obj.is_valid())
    

    // Call methods
undefined

    // Array of objects
    let mut objects = Vec::new()
    objects.push(Vector2D::default())
    objects.push(Vector2D::default())
    println!("Object count: {}", objects.len())
    

    // HashMap of objects
    let mut registry = HashMap::new()
    registry.insert("primary", Vector2D::default())
    registry.insert("secondary", Vector2D::default())
    println!("Registry size: {}", registry.len())
    

    println!("Vector2D demo complete!")
}

