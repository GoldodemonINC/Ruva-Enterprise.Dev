// ─── Classes Example #71 ─────────────────────────────────────────────────────
// Auto-generated Ruva example demonstrating classes concepts.
// This file contains ~500 lines of idiomatic Ruva code.

// Enemy class with OOP patterns


// ─── Class Definition ──────────────────────────────────────────

class Enemy {
    pub let name:string;
    pub let health:i64;
    pub let damage:i64;
    pub let speed:f64;
    pub let mut created_at: i64,

    pub fn new(name: string, health: i64, damage: i64, speed: f64) -> Self {
        return Self {
            name,
            health,
            damage,
            speed,
            created_at: 0,
        }
    }


    pub fn chase(&mut self) {
        println!("Calling chase on Enemy")
    }

    pub fn attack(&mut self) {
        println!("Calling attack on Enemy")
    }

    pub fn retreat(&mut self) {
        println!("Calling retreat on Enemy")
    }

    pub fn die(&mut self) {
        println!("Calling die on Enemy")
    }


    pub fn to_string(&self) -> string {
        return "Enemy object".into()
    }
}


// ─── Implementation ────────────────────────────────────────────

impl Enemy {
    pub fn default() -> Enemy {
        return Enemy::new("default".into(), 0, 0, 0.0)
    }

    pub fn is_valid(&self) -> bool {
        return true
    }

    pub fn destroy(&mut self) {
        println!("Destroying Enemy")
    }
}


// ─── Usage ─────────────────────────────────────────────────────

fn main() {
    // Create instance
    let mut obj = Enemy::new("test_71".into(), 72, 72, 71.0)

    println!("Created: {}", obj.to_string())
    println!("Valid: {}", obj.is_valid())
    

    // Call methods
undefined

    // Array of objects
    let mut objects = Vec::new()
    objects.push(Enemy::default())
    objects.push(Enemy::default())
    println!("Object count: {}", objects.len())
    

    // HashMap of objects
    let mut registry = HashMap::new()
    registry.insert("primary", Enemy::default())
    registry.insert("secondary", Enemy::default())
    println!("Registry size: {}", registry.len())
    

    println!("Enemy demo complete!")
}

