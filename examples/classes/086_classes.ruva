// Timer class with OOP patterns


// ─── Class Definition ──────────────────────────────────────────

class Timer {
    pub let duration:f64;
    pub let elapsed:f64;
    pub let running:bool;
    pub let mut created_at: i64,

    pub fn new(duration: f64, elapsed: f64, running: bool) -> Self {
        return Self {
            duration,
            elapsed,
            running,
            created_at: 0,
        }
    }


    pub fn start(&mut self) {
        println!("Calling start on Timer")
    }

    pub fn stop(&mut self) {
        println!("Calling stop on Timer")
    }

    pub fn reset(&mut self) {
        println!("Calling reset on Timer")
    }

    pub fn tick(&mut self) {
        println!("Calling tick on Timer")
    }

    pub fn is_finished(&mut self) {
        println!("Calling is_finished on Timer")
    }


    pub fn to_string(&self) -> string {
        return "Timer object".into()
    }
}


// ─── Implementation ────────────────────────────────────────────

impl Timer {
    pub fn default() -> Timer {
        return Timer::new(0.0, 0.0, false)
    }

    pub fn is_valid(&self) -> bool {
        return true
    }

    pub fn destroy(&mut self) {
        println!("Destroying Timer")
    }
}


// ─── Usage ─────────────────────────────────────────────────────

fn main() {
    // Create instance
    let mut obj = Timer::new(86.0, 86.0, true)

    println!("Created: {}", obj.to_string())
    println!("Valid: {}", obj.is_valid())
    

    // Call methods
undefined

    // Array of objects
    let mut objects = Vec::new()
    objects.push(Timer::default())
    objects.push(Timer::default())
    println!("Object count: {}", objects.len())
    

    // HashMap of objects
    let mut registry = HashMap::new()
    registry.insert("primary", Timer::default())
    registry.insert("secondary", Timer::default())
    println!("Registry size: {}", registry.len())
    

    println!("Timer demo complete!")
}

