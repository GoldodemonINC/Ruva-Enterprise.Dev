enum NTFSEnum {
    NTFS,
    EXT4,
    FAT32,
}

fn describe(v: &NTFSEnum) -> string {
    match v {
        NTFSEnum::NTFS => "NTFS".into(),
        NTFSEnum::EXT4 => "EXT4".into(),
        NTFSEnum::FAT32 => "FAT32".into(),
    }
}

fn main() {
    let v = NTFSEnum::NTFS
    println!("{}", describe(&v))
}
