    Inactive,
    Pending(i64),
    Complete,
    Failed(i64),
}

impl Action {
    pub fn is_active(&self) -> bool {
        return match self {
            Action::Active => true,
            _ => false,
        }
    }

    pub fn to_string(&self) -> string {
        return match self {
            Action::Active => "Active".into(),
            Action::Inactive => "Inactive".into(),
            Action::Pending => "Pending".into(),
            Action::Complete => "Complete".into(),
            Action::Failed => "Failed".into(),
        }
    }
}


