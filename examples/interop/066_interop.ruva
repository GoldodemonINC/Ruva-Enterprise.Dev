    Inactive,
    Pending,
    Complete,
}

impl State {
    pub fn is_active(&self) -> bool {
        return match self {
            State::Active => true,
            _ => false,
        }
    }

    pub fn to_string(&self) -> string {
        return match self {
            State::Active => "Active".into(),
            State::Inactive => "Inactive".into(),
            State::Pending => "Pending".into(),
            State::Complete => "Complete".into(),
            State::Failed => "Failed".into(),
