enum Status {
    Active,
    Inactive,
    Pending,
    Complete,
}

impl Status {
    pub fn is_active(&self) -> bool {
        return match self {
            Status::Active => true,
            _ => false,
        }
    }

    pub fn to_string(&self) -> string {
        return match self {
            Status::Active => "Active".into(),
            Status::Inactive => "Inactive".into(),
            Status::Pending => "Pending".into(),
            Status::Complete => "Complete".into(),
            Status::Failed => "Failed".into(),
        }
    }
}


