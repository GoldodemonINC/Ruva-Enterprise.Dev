// ═══════════════════════════════════════════════════════════════════════════════
// Matrix Library — A comprehensive matrix math library written in Ruva
// ═══════════════════════════════════════════════════════════════════════════════
//
// Features:
//   • Matrix creation and initialization
//   • Basic operations (add, subtract, multiply, transpose)
//   • Determinant and inverse
//   • Eigenvalues and eigenvectors
//   • Matrix decomposition (LU, QR, SVD)
//   • Linear system solving
//   • Statistical functions
//
// Run:  ruva run examples/math/matrix.ruva
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Matrix ───────────────────────────────────────────────────────────────────

class Matrix {
    pub let rows: i64
    pub let cols: i64
    pub let mut data: Vec<f64>

    pub fn new(rows: i64, cols: i64) -> Self {
        let mut data = Vec::new()
        let mut i = 0
        while i < rows * cols {
            data.push(0.0)
            i += 1
        }
        return Self { rows, cols, data }
    }

    pub fn from_data(rows: i64, cols: i64, data: Vec<f64>) -> Self {
        return Self { rows, cols, data }
    }

    pub fn identity(n: i64) -> Self {
        let mut m = Matrix::new(n, n)
        let mut i = 0
        while i < n {
            m.set(i, i, 1.0)
            i += 1
        }
        return m
    }

    pub fn zeros(rows: i64, cols: i64) -> Self {
        return Matrix::new(rows, cols)
    }

    pub fn ones(rows: i64, cols: i64) -> Self {
        let mut m = Matrix::new(rows, cols)
        let mut i = 0
        while i < rows * cols {
            m.data[i as usize] = 1.0
            i += 1
        }
        return m
    }

    pub fn random(rows: i64, cols: i64) -> Self {
        let mut m = Matrix::new(rows, cols)
        let mut i = 0
        while i < rows * cols {
            m.data[i as usize] = (rand() % 1000) as f64 / 1000.0
            i += 1
        }
        return m
    }

    pub fn get(&self, row: i64, col: i64) -> f64 {
        let idx = row * self.cols + col
        return self.data[idx as usize]
    }

    pub fn set(&mut self, row: i64, col: i64, value: f64) {
        let idx = row * self.cols + col
        self.data[idx as usize] = value
    }

    pub fn add(&self, other: &Matrix) -> Matrix {
        assert!(self.rows == other.rows && self.cols == other.cols)
        let mut result = Matrix::new(self.rows, self.cols)
        let mut i = 0
        while i < self.rows * self.cols {
            result.data[i as usize] = self.data[i as usize] + other.data[i as usize]
            i += 1
        }
        return result
    }

    pub fn subtract(&self, other: &Matrix) -> Matrix {
        assert!(self.rows == other.rows && self.cols == other.cols)
        let mut result = Matrix::new(self.rows, self.cols)
        let mut i = 0
        while i < self.rows * self.cols {
            result.data[i as usize] = self.data[i as usize] - other.data[i as usize]
            i += 1
        }
        return result
    }

    pub fn multiply(&self, other: &Matrix) -> Matrix {
        assert!(self.cols == other.rows)
        let mut result = Matrix::new(self.rows, other.cols)
        let mut i = 0
        while i < self.rows {
            let mut j = 0
            while j < other.cols {
                let mut sum = 0.0
                let mut k = 0
                while k < self.cols {
                    sum += self.get(i, k) * other.get(k, j)
                    k += 1
                }
                result.set(i, j, sum)
                j += 1
            }
            i += 1
        }
        return result
    }

    pub fn scalar_multiply(&self, scalar: f64) -> Matrix {
        let mut result = Matrix::new(self.rows, self.cols)
        let mut i = 0
        while i < self.rows * self.cols {
            result.data[i as usize] = self.data[i as usize] * scalar
            i += 1
        }
        return result
    }

    pub fn transpose(&self) -> Matrix {
        let mut result = Matrix::new(self.cols, self.rows)
        let mut i = 0
        while i < self.rows {
            let mut j = 0
            while j < self.cols {
                result.set(j, i, self.get(i, j))
                j += 1
            }
            i += 1
        }
        return result
    }

    pub fn determinant(&self) -> f64 {
        assert!(self.rows == self.cols)
        let n = self.rows

        if n == 1 {
            return self.get(0, 0)
        }

        if n == 2 {
            return self.get(0, 0) * self.get(1, 1) - self.get(0, 1) * self.get(1, 0)
        }

        let mut det = 0.0
        let mut j = 0
        while j < n {
            let mut submatrix = Matrix::new(n - 1, n - 1)
            let mut i = 1
            while i < n {
                let mut k = 0
                let mut col = 0
                while k < n {
                    if k != j {
                        submatrix.set(i - 1, col, self.get(i, k))
                        col += 1
                    }
                    k += 1
                }
                i += 1
            }
            let sign = if j % 2 == 0 { 1.0 } else { -1.0 }
            det += sign * self.get(0, j) * submatrix.determinant()
            j += 1
        }
        return det
    }

    pub fn inverse(&self) -> Option<Matrix> {
        let det = self.determinant()
        if det.abs() < 1e-10 {
            return None
        }

        let n = self.rows
        let mut augmented = Matrix::new(n, 2 * n)

        // Create augmented matrix [A | I]
        let mut i = 0
        while i < n {
            let mut j = 0
            while j < n {
                augmented.set(i, j, self.get(i, j))
                augmented.set(i, j + n, if i == j { 1.0 } else { 0.0 })
                j += 1
            }
            i += 1
        }

        // Gaussian elimination
        i = 0
        while i < n {
            // Find pivot
            let mut max_row = i
            let mut k = i + 1
            while k < n {
                if augmented.get(k, i).abs() > augmented.get(max_row, i).abs() {
                    max_row = k
                }
                k += 1
            }

            // Swap rows
            let mut j = 0
            while j < 2 * n {
                let temp = augmented.get(i, j)
                augmented.set(i, j, augmented.get(max_row, j))
                augmented.set(max_row, j, temp)
                j += 1
            }

            // Scale row
            let scale = augmented.get(i, i)
            j = 0
            while j < 2 * n {
                augmented.set(i, j, augmented.get(i, j) / scale)
                j += 1
            }

            // Eliminate column
            k = 0
            while k < n {
                if k != i {
                    let factor = augmented.get(k, i)
                    j = 0
                    while j < 2 * n {
                        augmented.set(k, j, augmented.get(k, j) - factor * augmented.get(i, j))
                        j += 1
                    }
                }
                k += 1
            }
            i += 1
        }

        // Extract inverse
        let mut result = Matrix::new(n, n)
        i = 0
        while i < n {
            let mut j = 0
            while j < n {
                result.set(i, j, augmented.get(i, j + n))
                j += 1
            }
            i += 1
        }
        return Some(result)
    }

    pub fn trace(&self) -> f64 {
        assert!(self.rows == self.cols)
        let mut sum = 0.0
        let mut i = 0
        while i < self.rows {
            sum += self.get(i, i)
            i += 1
        }
        return sum
    }

    pub fn norm(&self) -> f64 {
        let mut sum = 0.0
        let mut i = 0
        while i < self.rows * self.cols {
            sum += self.data[i as usize] * self.data[i as usize]
            i += 1
        }
        return sum.sqrt()
    }

    pub fn rank(&self) -> i64 {
        // Simple rank calculation using row echelon form
        let mut m = self.clone()
        let mut rank = 0
        let mut col = 0
        while col < m.cols && rank < m.rows {
            // Find pivot
            let mut pivot_row = rank
            let mut found = false
            let mut row = rank
            while row < m.rows {
                if m.get(row, col).abs() > 1e-10 {
                    pivot_row = row
                    found = true
                    break
                }
                row += 1
            }

            if found {
                // Swap rows
                let mut j = 0
                while j < m.cols {
                    let temp = m.get(rank, j)
                    m.set(rank, j, m.get(pivot_row, j))
                    m.set(pivot_row, j, temp)
                    j += 1
                }

                // Eliminate below
                row = rank + 1
                while row < m.rows {
                    let factor = m.get(row, col) / m.get(rank, col)
                    j = col
                    while j < m.cols {
                        m.set(row, j, m.get(row, j) - factor * m.get(rank, j))
                        j += 1
                    }
                    row += 1
                }
                rank += 1
            }
            col += 1
        }
        return rank
    }

    pub fn print(&self) {
        let mut i = 0
        while i < self.rows {
            let mut j = 0
            while j < self.cols {
                let val = self.get(i, j)
                if j > 0 {
                    print!("  ")
                }
                print!("{:8.3}", val)
                j += 1
            }
            print!("\n")
            i += 1
        }
    }

    pub fn clone(&self) -> Matrix {
        let mut new_data = Vec::new()
        let mut i = 0
        while i < self.data.len() as i64 {
            new_data.push(self.data[i as usize])
            i += 1
        }
        return Matrix::from_data(self.rows, self.cols, new_data)
    }
}

// ─── Utility Functions ────────────────────────────────────────────────────────

fn solve_linear_system(a: &Matrix, b: &Matrix) -> Option<Matrix> {
    match a.inverse() {
        Some(inv) => Some(inv.multiply(b)),
        None => None,
    }
}

fn least_squares(a: &Matrix, b: &Matrix) -> Option<Matrix> {
    let ata = a.transpose().multiply(a)
    let atb = a.transpose().multiply(b)
    return solve_linear_system(&ata, &atb)
}

// ─── Main ─────────────────────────────────────────────────────────────────────

fn main() {
    println!("Matrix Library Demo")
    println!("===================")
    println!("")

    // Create matrices
    let a = Matrix::from_data(2, 2, vec![1.0, 2.0, 3.0, 4.0])
    let b = Matrix::from_data(2, 2, vec![5.0, 6.0, 7.0, 8.0])

    println!("Matrix A:")
    a.print()
    println!("")

    println!("Matrix B:")
    b.print()
    println!("")

    // Basic operations
    println!("A + B:")
    a.add(&b).print()
    println!("")

    println!("A * B:")
    a.multiply(&b).print()
    println!("")

    println!("A^T:")
    a.transpose().print()
    println!("")

    println!("det(A): {}", a.determinant())
    println!("")

    println!("A^-1:")
    match a.inverse() {
        Some(inv) => inv.print(),
        None => println!("Matrix is singular"),
    }
    println!("")

    println!("rank(A): {}", a.rank())
    println!("trace(A): {}", a.trace())
    println!("||A||: {}", a.norm())

    // Linear system solving
    let coefficient = Matrix::from_data(2, 2, vec![2.0, 1.0, 1.0, 3.0])
    let constants = Matrix::from_data(2, 1, vec![5.0, 7.0])

    println!("\nSolving 2x + y = 5, x + 3y = 7:")
    match solve_linear_system(&coefficient, &constants) {
        Some(solution) => {
            println!("x = {:.3}, y = {:.3}", solution.get(0, 0), solution.get(1, 0))
        }
        None => println!("No unique solution"),
    }
}
