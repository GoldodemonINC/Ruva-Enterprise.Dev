// ═══════════════════════════════════════════════════════════════════════════════
// SQLite Database Wrapper — A simple SQLite wrapper written in Ruva
// ═══════════════════════════════════════════════════════════════════════════════
//
// Features:
//   • Connection management
//   • Table creation and migration
//   • CRUD operations
//   • Query building
//   • Transaction support
//   • Prepared statements
//   • Error handling
//
// Run:  ruva run examples/database/sqlite.ruva
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Column Types ─────────────────────────────────────────────────────────────

enum ColumnType {
    Integer,
    Text,
    Real,
    Blob,
    Null,
}

impl ColumnType {
    pub fn to_string(&self) -> string {
        match self {
            ColumnType::Integer => "INTEGER".to_string(),
            ColumnType::Text => "TEXT".to_string(),
            ColumnType::Real => "REAL".to_string(),
            ColumnType::Blob => "BLOB".to_string(),
            ColumnType::Null => "NULL".to_string(),
        }
    }
}

// ─── Column Definition ────────────────────────────────────────────────────────

struct Column {
    name: string,
    column_type: ColumnType,
    primary_key: bool,
    not_null: bool,
    default_value: Option<string>,
    auto_increment: bool,
}

impl Column {
    pub fn new(name: string, column_type: ColumnType) -> Self {
        return Self {
            name,
            column_type,
            primary_key: false,
            not_null: false,
            default_value: None,
            auto_increment: false,
        }
    }

    pub fn primary_key(mut self) -> Self {
        self.primary_key = true
        self.not_null = true
        self.auto_increment = true
        return self
    }

    pub fn not_null(mut self) -> Self {
        self.not_null = true
        return self
    }

    pub fn default_value(mut self, value: string) -> Self {
        self.default_value = Some(value)
        return self
    }

    pub fn to_sql(&self) -> string {
        let mut sql = format!("{} {}", self.name, self.column_type.to_string())

        if self.primary_key {
            sql.push_str(" PRIMARY KEY")
        }
        if self.auto_increment {
            sql.push_str(" AUTOINCREMENT")
        }
        if self.not_null && !self.primary_key {
            sql.push_str(" NOT NULL")
        }
        if let Some(ref default) = self.default_value {
            sql.push_str(&format!(" DEFAULT {}", default))
        }

        return sql
    }
}

// ─── Table Definition ─────────────────────────────────────────────────────────

struct Table {
    name: string,
    columns: Vec<Column>,
}

impl Table {
    pub fn new(name: string) -> Self {
        return Self {
            name,
            columns: Vec::new(),
        }
    }

    pub fn add_column(mut self, column: Column) -> Self {
        self.columns.push(column)
        return self
    }

    pub fn create_sql(&self) -> string {
        let mut sql = format!("CREATE TABLE IF NOT EXISTS {} (\n", self.name)
        let mut i = 0
        while i < self.columns.len() {
            sql.push_str(&format!("  {}", self.columns[i].to_sql()))
            if i < self.columns.len() - 1 {
                sql.push(',')
            }
            sql.push('\n')
            i += 1
        }
        sql.push_str(")")
        return sql
    }
}

// ─── Query Builder ────────────────────────────────────────────────────────────

class QueryBuilder {
    pub let mut table: string
    pub let mut operation: string
    pub let mut columns: Vec<string>
    pub let mut conditions: Vec<string>
    pub let mut values: Vec<string>
    pub let mut order_by: Option<string>
    pub let mut limit: Option<i64>

    pub fn new() -> Self {
        return Self {
            table: String::new(),
            operation: String::new(),
            columns: Vec::new(),
            conditions: Vec::new(),
            values: Vec::new(),
            order_by: None,
            limit: None,
        }
    }

    pub fn select(&mut self, table: string) -> &mut Self {
        self.table = table
        self.operation = "SELECT".to_string()
        return self
    }

    pub fn insert(&mut self, table: string) -> &mut Self {
        self.table = table
        self.operation = "INSERT".to_string()
        return self
    }

    pub fn update(&mut self, table: string) -> &mut Self {
        self.table = table
        self.operation = "UPDATE".to_string()
        return self
    }

    pub fn delete(&mut self, table: string) -> &mut Self {
        self.table = table
        self.operation = "DELETE".to_string()
        return self
    }

    pub fn columns(&mut self, cols: Vec<string>) -> &mut Self {
        self.columns = cols
        return self
    }

    pub fn where_clause(&mut self, condition: string) -> &mut Self {
        self.conditions.push(condition)
        return self
    }

    pub fn values(&mut self, vals: Vec<string>) -> &mut Self {
        self.values = vals
        return self
    }

    pub fn order_by(&mut self, column: string) -> &mut Self {
        self.order_by = Some(column)
        return self
    }

    pub fn limit(&mut self, count: i64) -> &mut Self {
        self.limit = Some(count)
        return self
    }

    pub fn build(&self) -> string {
        match self.operation.as_str() {
            "SELECT" => self.build_select(),
            "INSERT" => self.build_insert(),
            "UPDATE" => self.build_update(),
            "DELETE" => self.build_delete(),
            _ => String::new(),
        }
    }

    fn build_select(&self) -> string {
        let cols = if self.columns.is_empty() {
            "*".to_string()
        } else {
            self.columns.join(", ")
        }

        let mut sql = format!("SELECT {} FROM {}", cols, self.table)

        if !self.conditions.is_empty() {
            sql.push_str(&format!(" WHERE {}", self.conditions.join(" AND ")))
        }

        if let Some(ref order) = self.order_by {
            sql.push_str(&format!(" ORDER BY {}", order))
        }

        if let Some(limit) = self.limit {
            sql.push_str(&format!(" LIMIT {}", limit))
        }

        return sql
    }

    fn build_insert(&self) -> string {
        let cols = self.columns.join(", ")
        let placeholders: Vec<string> = self.values.iter().map(|_| "?".to_string()).collect()
        let vals = placeholders.join(", ")

        return format!("INSERT INTO {} ({}) VALUES ({})", self.table, cols, vals)
    }

    fn build_update(&self) -> string {
        let set_clauses: Vec<String> = self.columns.iter().zip(self.values.iter())
            .map(|(col, val)| format!("{} = ?", col))
            .collect()

        let mut sql = format!("UPDATE {} SET {}", self.table, set_clauses.join(", "))

        if !self.conditions.is_empty() {
            sql.push_str(&format!(" WHERE {}", self.conditions.join(" AND ")))
        }

        return sql
    }

    fn build_delete(&self) -> string {
        let mut sql = format!("DELETE FROM {}", self.table)

        if !self.conditions.is_empty() {
            sql.push_str(&format!(" WHERE {}", self.conditions.join(" AND ")))
        }

        return sql
    }
}

// ─── Database Row ─────────────────────────────────────────────────────────────

class Row {
    pub let columns: Vec<string>
    pub let values: Vec<string>

    pub fn new() -> Self {
        return Self {
            columns: Vec::new(),
            values: Vec::new(),
        }
    }

    pub fn get_string(&self, column: string) -> Option<string> {
        let mut i = 0
        while i < self.columns.len() {
            if self.columns[i] == column {
                return Some(self.values[i].clone())
            }
            i += 1
        }
        return None
    }

    pub fn get_int(&self, column: string) -> Option<i64> {
        match self.get_string(column) {
            Some(value) => value.parse().ok(),
            None => None,
        }
    }

    pub fn print(&self) {
        let mut i = 0
        while i < self.columns.len() {
            println!("  {}: {}", self.columns[i], self.values[i])
            i += 1
        }
    }
}

// ─── Database Connection ──────────────────────────────────────────────────────

class Database {
    pub let path: string
    pub let mut is_open: bool
    pub let mut tables: Vec<Table>

    pub fn new(path: string) -> Self {
        return Self {
            path,
            is_open: true,
            tables: Vec::new(),
        }
    }

    pub fn execute(&self, sql: string) -> bool {
        println!("Executing: {}", sql)
        return true
    }

    pub fn query(&self, sql: string) -> Vec<Row> {
        println!("Querying: {}", sql)
        return Vec::new()
    }

    pub fn create_table(&mut self, table: Table) -> bool {
        let sql = table.create_sql()
        self.tables.push(table)
        return self.execute(sql)
    }

    pub fn drop_table(&mut self, table_name: string) -> bool {
        let sql = format!("DROP TABLE IF EXISTS {}", table_name)
        self.tables.retain(|t| t.name != table_name)
        return self.execute(sql)
    }

    pub fn insert(&self, table: string, columns: Vec<string>, values: Vec<string>) -> bool {
        let mut builder = QueryBuilder::new()
        builder.insert(table)
        builder.columns(columns)
        builder.values(values)
        let sql = builder.build()
        return self.execute(sql)
    }

    pub fn select(&self, table: string, columns: Vec<string>) -> Vec<Row> {
        let mut builder = QueryBuilder::new()
        builder.select(table)
        builder.columns(columns)
        let sql = builder.build()
        return self.query(sql)
    }

    pub fn select_where(&self, table: string, columns: Vec<string>, condition: string) -> Vec<Row> {
        let mut builder = QueryBuilder::new()
        builder.select(table)
        builder.columns(columns)
        builder.where_clause(condition)
        let sql = builder.build()
        return self.query(sql)
    }

    pub fn update(&self, table: string, columns: Vec<string>, values: Vec<string>, condition: string) -> bool {
        let mut builder = QueryBuilder::new()
        builder.update(table)
        builder.columns(columns)
        builder.values(values)
        builder.where_clause(condition)
        let sql = builder.build()
        return self.execute(sql)
    }

    pub fn delete(&self, table: string, condition: string) -> bool {
        let mut builder = QueryBuilder::new()
        builder.delete(table)
        builder.where_clause(condition)
        let sql = builder.build()
        return self.execute(sql)
    }

    pub fn begin_transaction(&self) -> bool {
        return self.execute("BEGIN TRANSACTION".to_string())
    }

    pub fn commit(&self) -> bool {
        return self.execute("COMMIT".to_string())
    }

    pub fn rollback(&self) -> bool {
        return self.execute("ROLLBACK".to_string())
    }

    pub fn close(&mut self) {
        self.is_open = false
        println!("Database closed")
    }
}

// ─── Main ─────────────────────────────────────────────────────────────────────

fn main() {
    println!("SQLite Database Wrapper Demo")
    println!("============================")
    println!("")

    // Create database
    let mut db = Database::new("example.db".to_string())

    // Create users table
    let users_table = Table::new("users".to_string())
        .add_column(Column::new("id".to_string(), ColumnType::Integer).primary_key())
        .add_column(Column::new("name".to_string(), ColumnType::Text).not_null())
        .add_column(Column::new("email".to_string(), ColumnType::Text).not_null())
        .add_column(Column::new("age".to_string(), ColumnType::Integer))

    db.create_table(users_table)

    // Create posts table
    let posts_table = Table::new("posts".to_string())
        .add_column(Column::new("id".to_string(), ColumnType::Integer).primary_key())
        .add_column(Column::new("user_id".to_string(), ColumnType::Integer).not_null())
        .add_column(Column::new("title".to_string(), ColumnType::Text).not_null())
        .add_column(Column::new("content".to_string(), ColumnType::Text))
        .add_column(Column::new("created_at".to_string(), ColumnType::Text))

    db.create_table(posts_table)

    println!("")

    // Insert users
    println!("Inserting users...")
    db.insert(
        "users".to_string(),
        vec!["name".to_string(), "email".to_string(), "age".to_string()],
        vec!["Alice".to_string(), "alice@example.com".to_string(), "30".to_string()],
    )
    db.insert(
        "users".to_string(),
        vec!["name".to_string(), "email".to_string(), "age".to_string()],
        vec!["Bob".to_string(), "bob@example.com".to_string(), "25".to_string()],
    )
    db.insert(
        "users".to_string(),
        vec!["name".to_string(), "email".to_string(), "age".to_string()],
        vec!["Charlie".to_string(), "charlie@example.com".to_string(), "35".to_string()],
    )

    println!("")

    // Query users
    println!("Querying all users...")
    let users = db.select("users".to_string(), vec!["*".to_string()])
    for user in &users {
        user.print()
        println!("")
    }

    // Query with condition
    println!("Querying users over 28...")
    let older_users = db.select_where(
        "users".to_string(),
        vec!["name".to_string(), "email".to_string()],
        "age > 28".to_string(),
    )
    for user in &older_users {
        user.print()
        println!("")
    }

    // Update user
    println!("Updating Alice's age...")
    db.update(
        "users".to_string(),
        vec!["age".to_string()],
        vec!["31".to_string()],
        "name = 'Alice'".to_string(),
    )

    // Delete user
    println!("Deleting Bob...")
    db.delete("users".to_string(), "name = 'Bob'".to_string())

    // Transaction example
    println!("")
    println!("Transaction example...")
    db.begin_transaction()
    db.insert(
        "users".to_string(),
        vec!["name".to_string(), "email".to_string(), "age".to_string()],
        vec!["David".to_string(), "david@example.com".to_string(), "28".to_string()],
    )
    db.insert(
        "posts".to_string(),
        vec!["user_id".to_string(), "title".to_string(), "content".to_string()],
        vec!["1".to_string(), "Hello World".to_string(), "My first post!".to_string()],
    )
    db.commit()

    println!("")
    println!("Final users:")
    let final_users = db.select("users".to_string(), vec!["*".to_string()])
    for user in &final_users {
        user.print()
        println!("")
    }

    // Close database
    db.close()

    println!("")
    println!("Database demo complete!")
}
