            Level::Active => true,
            _ => false,
        }
    }

    pub fn to_string(&self) -> string {
        return match self {
            Level::Active => "Active".into(),
            Level::Inactive => "Inactive".into(),
            Level::Pending => "Pending".into(),
            Level::Complete => "Complete".into(),
            Level::Failed => "Failed".into(),
        }
    }
}


